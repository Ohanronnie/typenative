import { Array, Map } from "std/collections";
declare extern "C" {
  function tn_runtime_reset_allocation_count(): void;
  function tn_runtime_allocation_count_i32(): i32;
}
function main(): i32 {
  unsafe {
    tn_runtime_reset_allocation_count();
  }
  {
    let map = new Map<i32, i32>({
      capacity: 32,
    });
    let index: i32 = 0;
    while (index<24) {
      map.set(index, index * 3);
      index += 1;
    }
    let values = new Array<i32>({
      capacity: 24,
    });
    index = 0;
    while (index<24) {
      values.push(index * 7);
      index += 1;
    }
  }
  unsafe {
    return tn_runtime_allocation_count_i32();
  }
}
