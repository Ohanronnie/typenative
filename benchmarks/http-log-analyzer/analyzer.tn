        return 0;
      }
      const methodLength = this.offset - methodStart;
      const methodFirst = this.input.get(methodStart)!;
      if (!((methodFirst === 71 && methodLength === 3) ||(methodFirst === 80 && methodLength === 3) ||(methodFirst === 80 && methodLength === 4) ||(methodFirst === 80 && methodLength === 5) ||(methodFirst === 68 && methodLength === 6))) {
        return 0;
      }
      if (methodFirst === 71) {
        methodChecksum += 3;
      } else if (methodLength === 3) {
        methodChecksum += 13;
      } else if (methodLength === 4) {
        methodChecksum += 5;
      } else if (methodLength === 5) {
        methodChecksum += 7;
      } else {
        methodChecksum += 11;
      }
      this.offset += 1;
      const routeStart = this.offset;
      let routeHash: usize = 0;
      while (this.offset<this.input.length && this.current() !== 32) {
        routeHash =(routeHash * 131 + this.routeByteValue(this.current())) % 2147483629;
        this.offset += 1;
