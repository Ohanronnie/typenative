      this.offset += 1;
      const duration = this.parseNumber();
      if (duration === undefined) {
        return 0;
      }
      if (this.offset<this.input.length && this.current() === 10) {
        this.offset += 1;
      } else if (this.offset !== this.input.length) {
        return 0;
      }
      if (status >= 100 && status<200) {
        informational += 1;
      } else if (status<300) {
        successful += 1;
      } else if (status<400) {
