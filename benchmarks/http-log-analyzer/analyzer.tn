    return records * 3 + informational * 5 + successful * 7 + redirects * 11 + clientErrors * 13 + serverErrors * 17 + totalBytes * 19 + totalDuration * 23 + methodChecksum * 29 + prefixChecksum * 31 + routeAggregate + busiestRoute * 37 + busiestCount * 41 + routes.length * 43;
  }
  public analyzeMany(iterations: i32): usize {
    let iteration: i32 = 0;
    let total: usize = 0;
    while (iteration<iterations) {
      const checksum = this.analyzeOnce();
