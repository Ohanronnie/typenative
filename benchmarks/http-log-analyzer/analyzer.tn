    if (value === 49)return 49;
    if (value === 50)return 50;
    if (value === 51)return 51;
    if (value === 52)return 52;
    if (value === 53)return 53;
    if (value === 54)return 54;
    if (value === 55)return 55;
    if (value === 56)return 56;
    if (value === 57)return 57;
    if (value === 97)return 97;
    if (value === 98)return 98;
    if (value === 99)return 99;
    if (value === 100)return 100;
    if (value === 101)return 101;
    if (value === 102)return 102;
    if (value === 103)return 103;
    if (value === 104)return 104;
    if (value === 105)return 105;
    if (value === 106)return 106;
