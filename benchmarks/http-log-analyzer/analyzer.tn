    }
    if (iterations === 0) {
      rawFree(pointer);
      return 0;
    }
    const input = Bytes.fromRaw(pointer as *const u8, size);
    const started = Instant.now();
    const checksum = analyzeMany(input, iterations);
    const finished = Instant.now();
    const elapsed = finished.durationSince( &started).nanoseconds();
    rawFree(pointer);
    if (checksum === 0) {
      return 7;
