export function analyzeMany(input: Bytes, iterations: i32): usize {
  let analyzer = new LogAnalyzer(input);
  return analyzer.analyzeMany(iterations);
}
function appendU64(buffer: &mut BytesMut, value: u64): void {
  let divisor: u64 = 1;
  while (value / divisor >= 10 && divisor <= 1000000000000000000) {
    divisor *= 10;
  }
  let remaining = value;
  while (divisor > 0) {
    const digit = remaining / divisor;
    if (digit === 0) {
      buffer.push(48);
    } else if (digit === 1) {
      buffer.push(49);
    } else if (digit === 2) {
      buffer.push(50);
    } else if (digit === 3) {
      buffer.push(51);
    } else if (digit === 4) {
      buffer.push(52);
    } else if (digit === 5) {
      buffer.push(53);
    } else if (digit === 6) {
      buffer.push(54);
    } else if (digit === 7) {
      buffer.push(55);
    } else if (digit === 8) {
      buffer.push(56);
    } else {
      buffer.push(57);
