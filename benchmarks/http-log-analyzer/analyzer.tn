      const protocolStart = this.offset;
      while (this.offset<this.input.length && this.current() !== 34) {
        this.offset += 1;
      }
      if (this.offset >= this.input.length || this.offset - protocolStart<8) {
        return 0;
      }
      this.offset += 1;
      if (this.offset >= this.input.length || this.current() !== 32) {
        return 0;
      }
      this.offset += 1;
      let status: usize = 0;
      let statusDigits: usize = 0;
      while (statusDigits<3) {
