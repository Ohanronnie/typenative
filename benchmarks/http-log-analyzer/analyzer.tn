      if (routeCount > busiestCount ||(routeCount === busiestCount && routeHash<busiestRoute)) {
        busiestCount = routeCount;
        busiestRoute = routeHash;
      }
      records += 1;
      totalBytes += byteCount!;
      totalDuration += duration!;
    }
    if (records === 0 || routes.length === 0) {
