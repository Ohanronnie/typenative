    let output = new BytesMut({
      capacity: 64
    });
    output.appendUnsignedDecimal(checksum);
    output.appendAscii(",");
    appendU64( &mut output, elapsed);
    output.appendAscii("\n");
    const bytes = output.asBytes();
    let out = stdout();
    try {
      try out.writeAll( &bytes);
    } catch (error: IOError) {
      return 8;
    }
  }
  return 0;
}
