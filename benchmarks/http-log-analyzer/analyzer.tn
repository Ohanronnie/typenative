function main(): i32 throws FileError | Utf8Error {
  if (argumentCount() < 3) {
    return 2;
  }
  unsafe {
    const path = argument(1);
    const iterations = atoi(argument(2));
    if (iterations<0) {
      return 3;
    }
    const pathBytes = Bytes.fromRaw(path, tn_cstring_length(path));
    const pathText = try String.fromUtf8(pathBytes);
    const fileMetadata = try metadata(pathText.asStr());
    const size = fileMetadata.size;
    if (size === 0) {
      return 4;
    }
    const pointer = rawAlloc(size);
    const handle = tn_file_open(path, 0, 0);
    if (handle<0) {
      rawFree(pointer);
      return 5;
    }
    const readStatus = tn_file_read_exact(handle, pointer, size);
    tn_file_close(handle);
    if (readStatus !== 0) {
