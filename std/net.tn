import { Bytes, BytesMut } from "std/bytes";
import { AsyncDisposable, Drop } from "std/core";

declare extern "C" {
  function tn_net_tcp_connect(host: * const u8, port: u16): i32;
  function tn_net_tcp_listen(host: * const u8, port: u16, backlog: i32): i32;
  function tn_net_tcp_listen_address(address: * const u8, backlog: i32): i32;
  function tn_net_tcp_accept(handle: i32): i32;
  function tn_net_set_nonblocking(handle: i32, enabled: i32): i32;
  function tn_net_shutdown(handle: i32): i32;
  function tn_net_read(handle: i32, bytes: * mut u8, length: usize): isize;
  function tn_net_read_into(handle: i32, bytes: * mut u8, capacity: usize, length: usize, received: * mut usize): i32;
  function tn_net_write(handle: i32, bytes: * const u8, length: usize): isize;
  function tn_net_read_exact(handle: i32, bytes: * mut u8, length: usize): i32;
  function tn_net_write_all(handle: i32, bytes: * const u8, length: usize): i32;
  function tn_net_close(handle: i32): i32;
  function tn_net_udp_bind(host: * const u8, port: u16): i32;
  function tn_net_udp_send(handle: i32, bytes: * const u8, length: usize, host: * const u8, port: u16): isize;
  function tn_net_udp_recv(handle: i32, bytes: * mut u8, length: usize): isize;
  function tn_net_resolve_ipv4(host: * const u8, address: * mut u32): i32;
}
export struct Endpoint {
  public host: & static str;
  public port: u16;
}
@Drop export struct TcpStream {
  public handle: i32;
  public closed: bool;
  mut drop(): void {
    if (!this.closed) {
      unsafe {
        tn_net_close(this.handle);
      }
    }
  }
  public mut readInto(buffer: & mut BytesMut): usize throws NetworkError {
    if (buffer.length === buffer.capacity) {
      let next: usize = 4096usize;
      if (buffer.capacity !== 0usize) {
        next = buffer.capacity * 2usize;
      }
      buffer.reserve(next);
    }
    let received: usize = 0usize;
    const output = & mut received;
    unsafe {
      const status = tn_net_read_into(this.handle, buffer.pointer, buffer.capacity, buffer.length, output as * mut usize);
      if (status !== 0i32) {
        throw networkError(status);
      }
    }
    buffer.length = buffer.length + received;
    return received;
  }
  public writeAll(buffer: & BytesMut): void throws NetworkError {
    unsafe {
      const status = tn_net_write_all(this.handle, buffer.pointer as * const u8, buffer.length);
      if (status !== 0i32) {
        throw networkError(status);
      }
    }
  }
  public close(): void {
    if (!this.closed) {
      unsafe {
        tn_net_close(this.handle);
      }
    }
    this.closed = true;
  }
}
@Drop export struct UdpSocket {
  public handle: i32;
  public closed: bool;
  mut drop(): void {
    if (!this.closed) {
      unsafe {
        tn_net_close(this.handle);
      }
    }
  }
}
export struct NetworkError {
  public code: i32;
}
function networkError(code: i32): NetworkError {
  return {
    code: code
  };
}
@Conform(AsyncDisposable)
@Drop export class TcpListener {
  public handle: i32;
  public closed: bool;
  public constructor(endpoint: Endpoint)throws NetworkError {
    unsafe {
      const handle = tn_net_tcp_listen(endpoint.host as * const u8, endpoint.port, 128i32);
      if (handle<0i32) {
        throw networkError( - 1i32);
      }
      this.handle = handle;
    }
    this.closed = false;
  }
  mut drop(): void {
    this.close();
  }
  public async accept(): Promise<TcpStream, NetworkError> {
    unsafe {
      const handle = tn_net_tcp_accept(this.handle);
      if (handle<0i32) {
        throw networkError( - 1i32);
      }
      return {
        handle: handle, closed: false
      };
    }
  }
  public close(): void {
    if (!this.closed) {
      unsafe {
        tn_net_close(this.handle);
      }
      this.closed = true;
    }
  }
  move async dispose(): Promise<void, never> {
    this.close();
    return;
  }
}
export function connect(endpoint: Endpoint): TcpStream {
  unsafe {
    const handle = tn_net_tcp_connect(endpoint.host as * const u8, endpoint.port);
    return {
      handle: handle, closed: false
    };
  }
}
export function listen(endpoint: Endpoint, backlog: i32): TcpStream {
  unsafe {
    return {
      handle: tn_net_tcp_listen(endpoint.host as * const u8, endpoint.port, backlog), closed: false
    };
  }
}
export function connectChecked(endpoint: Endpoint): TcpStream throws NetworkError {
  const stream = connect(endpoint);
  if (stream.handle<0i32) {
    throw networkError( - 1i32);
  }
  return stream;
}
export function accept(stream: & TcpStream): TcpStream {
  unsafe {
    return {
      handle: tn_net_tcp_accept(stream.handle), closed: false
    };
  }
}
export function setNonblocking(stream: & TcpStream, enabled: bool): i32 {
  let mode: i32 = 0i32;
  if (enabled) {
    mode = 1i32;
  }
  unsafe {
    return tn_net_set_nonblocking(stream.handle, mode);
  }
}
export function shutdown(stream: & TcpStream): i32 {
  unsafe {
    return tn_net_shutdown(stream.handle);
  }
}
export function close(stream: & mut TcpStream): void {
  if (!stream.closed) {
    unsafe {
      tn_net_close(stream.handle);
    }
    stream.closed = true;
  }
}
export function read(stream: & TcpStream, bytes: * mut u8, length: usize): isize {
  unsafe {
    return tn_net_read(stream.handle, bytes, length);
  }
}
export function write(stream: & TcpStream, bytes: * const u8, length: usize): isize {
  unsafe {
    return tn_net_write(stream.handle, bytes, length);
  }
}
export function readExact(stream: & TcpStream, bytes: * mut u8, length: usize): void throws NetworkError {
  let status: i32 = 0i32;
  unsafe {
    status = tn_net_read_exact(stream.handle, bytes, length);
  }
  if (status !== 0i32) {
    throw networkError(status);
  }
}
export function writeAll(stream: & TcpStream, bytes: * const u8, length: usize): void throws NetworkError {
  let status: i32 = 0i32;
  unsafe {
    status = tn_net_write_all(stream.handle, bytes, length);
  }
  if (status !== 0i32) {
    throw networkError(status);
  }
}
export function udpBind(host: & static str, port: u16): UdpSocket {
  unsafe {
    return {
      handle: tn_net_udp_bind(host as * const u8, port), closed: false
    };
  }
}
export function udpSend(socket: & UdpSocket, bytes: * const u8, length: usize, host: & static str, port: u16): isize {
  unsafe {
    return tn_net_udp_send(socket.handle, bytes, length, host as * const u8, port);
  }
}
export function udpReceive(socket: & UdpSocket, bytes: * mut u8, length: usize): isize {
  unsafe {
    return tn_net_udp_recv(socket.handle, bytes, length);
  }
}
export function closeUdp(socket: & mut UdpSocket): void {
  if (!socket.closed) {
    unsafe {
      tn_net_close(socket.handle);
    }
    socket.closed = true;
  }
}
export function resolveIpv4(host: & static str, address: * mut u32): i32 {
  unsafe {
    return tn_net_resolve_ipv4(host as * const u8, address);
  }
}
