      if (buffer.capacity !== 0usize) {
        next = buffer.capacity * 2usize;
      }
      buffer.reserve(next);
    }
    let received: usize = 0usize;
    const output = & mut received;
    unsafe {
      const status = tn_net_read_into(this.handle, buffer.pointer, buffer.capacity, buffer.length, output as * mut usize);
      if (status !== 0i32) {
        throw networkError(status);
      }
    }
    buffer.length = buffer.length + received;
    return received;
  }
  public writeAll(buffer: & BytesMut): void throws NetworkError {
    unsafe {
      const status = tn_net_write_all(this.handle, buffer.pointer as * const u8, buffer.length);
      if (status !== 0i32) {
        throw networkError(status);
      }
    }
