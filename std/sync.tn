export struct MutexGuard<T > implements Disposable {
  private handle: *mut u8;
  private pointer: *mut T;
  private locked: bool;
  public [Symbol.dispose](): void {
    this.release();
  }
  private release(): void {
    if (this.locked) {
      unsafe {
        tn_mutex_unlock(this.handle);
      }
      this.locked = false;
    }
  }
