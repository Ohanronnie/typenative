      return undefined;
    }
    unsafe {
      const index = tn_channel_try_receive_index_begin(this.handle);
      if (index === ~0) {
        return undefined;
      }
      const value = moveElement<T>(this.storage as *mut T, index as usize, this.initialized);
      tn_channel_receive_index_commit(this.handle);
      return value;
    }
