    this.value = move value;
    this.closed = false;
  }
  [Symbol.dispose](): void {
    if (!this.closed) {
      unsafe {
        tn_mutex_destroy(this.handle);
      }
    }
  }
  public lock(): MutexGuard<T> {
    unsafe {
      tn_mutex_lock(this.handle);
