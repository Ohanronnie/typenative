export struct Channel<T> {
  private handle: *mut u8;
  private storage: *mut u8;
  private initialized: *mut u8;
  private capacity: usize;
  private closed: bool;
  private destroyed: bool;
  [Symbol.dispose](): void {
    if (!this.destroyed) {
      unsafe {
        dropInitializedElements<T>(this.storage as *mut T, this.capacity, this.initialized);
        tn_channel_destroy(this.handle);
      }
      this.destroyed = true;
    }
  }
  public send(value: T): i32 {
    if (this.closed || this.destroyed) {
      return 32;
    }
    unsafe {
      const index = tn_channel_send_index_begin(this.handle);
      if (index === ~0) {
        return 32;
      }
      storeElement<T>(this.storage as *mut T, index as usize, this.initialized, move value);
      return tn_channel_send_index_commit(this.handle);
    }
  }
  public trySend(value: T): T | undefined {
    if (this.closed || this.destroyed) {
      return move value;
    }
    unsafe {
      const index = tn_channel_try_send_index_begin(this.handle);
      if (index === ~0) {
        return move value;
      }
      storeElement<T>(this.storage as *mut T, index as usize, this.initialized, move value);
      tn_channel_send_index_commit(this.handle);
      return undefined;
    }
