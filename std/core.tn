function atomicI32Store(pointer: *mut i32, value: i32, order: MemoryOrder): i32 {
  return 0;
}
function atomicI32FetchAdd(pointer: *mut i32, delta: i32, order: MemoryOrder): i32 {
  return 0;
}
function atomicI32CompareExchange(pointer: *mut i32, expected: *mut i32, desired: i32, success: MemoryOrder, failure: MemoryOrder,): bool {
  return false;
}
export unsafe function atomicLoadI32(pointer: *const i32, order: MemoryOrder): i32 {
  unsafe {
    return atomicI32Load(pointer, order);
  }
}
export unsafe function atomicFetchAddI32(pointer: *mut i32, delta: i32, order: MemoryOrder): i32 {
  unsafe {
    return atomicI32FetchAdd(pointer, delta, order);
  }
}
export unsafe function atomicStoreI32(pointer: *mut i32, value: i32, order: MemoryOrder): i32 {
  unsafe {
    return atomicI32Store(pointer, value, order);
  }
}
export unsafe function atomicCompareExchangeI32(pointer: *mut i32, expected: *mut i32, desired: i32, success: MemoryOrder, failure: MemoryOrder,): bool {
  unsafe {
    return atomicI32CompareExchange(pointer, expected, desired, success, failure);
  }
}
