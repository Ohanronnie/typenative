export class AtomicI32 {
  private value: i32;
  public constructor(value: i32) {
    this.value = value;
  }
  public load(order: MemoryOrder): i32 {
    unsafe {
      return atomicI32Load(( &this.value)as *const i32, order);
    }
  }
  public store(value: i32, order: MemoryOrder): i32 {
    unsafe {
      return atomicI32Store(( &mut this.value)as *mut i32, value, order);
    }
  }
  public fetchAdd(delta: i32, order: MemoryOrder): i32 {
    unsafe {
      return atomicI32FetchAdd(( &mut this.value)as *mut i32, delta, order);
    }
  }
  public compareExchange(expected: i32, desired: i32, success: MemoryOrder, failure: MemoryOrder,): bool {
    let observed = expected;
    unsafe {
      return atomicI32CompareExchange(( &mut this.value)as *mut i32,( &mut observed)as *mut i32, desired, success, failure,);
    }
  }
}
