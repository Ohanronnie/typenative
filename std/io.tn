import { rawAlloc, rawFree } from "std/alloc";
import { Bytes } from "std/bytes";
import { c_size } from "std/ffi";

declare extern "C" {
  function tn_console_write(fd: i32, bytes: *const u8, length: c_size): i32;
  function tn_io_write_all(fd: i32, bytes: *const u8, length: c_size): i32;
  function tn_io_flush(fd: i32): i32;
  function tn_bytes_copy(source: *const u8, length: c_size, destination: *mut u8): c_size;
  function tn_bytes_copy_to_at(source: *const u8, sourceLength: c_size, sourceOffset: c_size, count: c_size, destination: *mut u8, destinationLength: c_size, destinationOffset: c_size): i32;
}
export struct IOError {
  public rawCode: i32;
}
function ioError(code: i32): IOError {
  return {
    rawCode: code
  };
}
export interface Reader {
  unsafe read(bytes: *mut u8, length: usize): isize;
}
export interface Writer {
  writeAll(bytes: &Bytes): void throws IOError;
  flush(): void throws IOError;
}
export struct Stdout implements Writer {
  public fd: i32;
  public writeAll(bytes: &Bytes): void throws IOError {
    let status: i32 = 0;
    unsafe {
      status = tn_io_write_all(this.fd, bytes.nativePointer(), bytes.length);
    }
    if (status !== 0) {
      throw ioError(status);
    }
  }
  public flush(): void throws IOError {
    let status: i32 = 0;
    unsafe {
      status = tn_io_flush(this.fd);
    }
    if (status !== 0) {
      throw ioError(status);
    }
  }
}
export struct Stderr implements Writer {
  public fd: i32;
  public writeAll(bytes: &Bytes): void throws IOError {
    let status: i32 = 0;
    unsafe {
      status = tn_io_write_all(this.fd, bytes.nativePointer(), bytes.length);
    }
    if (status !== 0) {
      throw ioError(status);
    }
