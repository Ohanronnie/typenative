  public flush(): void throws IOError {
    let status: i32 = 0;
    unsafe {
      status = tn_io_flush(this.fd);
    }
    if (status !== 0) {
      throw ioError(status);
    }
  }
}
export class BufferedWriter {
  public fd: i32;
  private pointer: *mut u8;
  public length: usize;
  public capacity: usize;
  private closed: bool;
  public constructor(fd: i32, capacity: usize) {
    let actual = capacity;
    if (actual === 0) {
      actual = 1;
    }
    this.fd = fd;
    unsafe {
      this.pointer = rawAlloc(actual);
    }
    this.length = 0;
    this.capacity = actual;
    this.closed = false;
  }
  public flush(): void throws IOError {
    if (this.closed) {
      throw ioError(9);
    }
    let status: i32 = 0;
    unsafe {
      status = tn_io_write_all(this.fd, this.pointer as *const u8, this.length);
    }
    if (status !== 0) {
      throw ioError(status);
    }
    this.length = 0;
  }
  public write(bytes: &Bytes): void throws IOError {
    if (this.closed) {
      throw ioError(9);
    }
    if (bytes.length > this.capacity) {
      try this.flush();
      let status: i32 = 0;
      unsafe {
        status = tn_io_write_all(this.fd, bytes.nativePointer(), bytes.length);
      }
      if (status !== 0) {
        throw ioError(status);
      }
      return;
    }
    if (bytes.length > this.capacity - this.length) {
      try this.flush();
    }
    unsafe {
      tn_bytes_copy_to_at(bytes.nativePointer(), bytes.length, 0, bytes.length, this.pointer, this.capacity, this.length);
    }
    this.length = this.length + bytes.length;
  }
  [Symbol.dispose](): void {
    if (!this.closed) {
      if (this.length !== 0) {
        unsafe {
          tn_io_write_all(this.fd, this.pointer as *const u8, this.length);
        }
      }
      unsafe {
        rawFree(this.pointer);
      }
      this.closed = true;
    }
  }
}
export function stdout(): Stdout {
  return {
    fd: 1
  };
}
export function stderr(): Stderr {
  return {
    fd: 2
  };
}
export function bufferedWriter(fd: i32, capacity: usize): BufferedWriter {
  return new BufferedWriter(fd, capacity);
}
