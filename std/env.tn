declare extern "C" {
  function tn_process_getenv(name: *const u8): *const u8;
  function tn_process_getenv_length(name: *const u8): c_size;
  function tn_process_getenv_copy(name: *const u8, destination: *mut u8, capacity: c_size): i32;
  function tn_process_cwd(buffer: *mut u8, capacity: c_size): i32;
  function tn_string_from_bytes(bytes: *const u8, length: c_size): *mut u8;
}
import { Bytes } from "std/bytes";
import { ParseIntegerError } from "std/core";
import { rawAlloc, rawFree } from "std/alloc";
import { c_size } from "std/ffi";
import { fromRaw } from "std/string";
export struct Variable {
  public name: &str;
  public value: &str;
}
export struct EnvError {
  public rawCode: i32;
}
function checkedU16(value: usize): u16 {
  return 0;
}
function envError(code: i32): EnvError {
  return {
    rawCode: code
  };
}
export unsafe function lookup(name: &str): *const u8 {
  unsafe {
    return tn_process_getenv(name as *const u8);
  }
}
export unsafe function currentDirectory(buffer: *mut u8, capacity: usize): i32 {
  unsafe {
    return tn_process_cwd(buffer, capacity);
  }
}
export function lookupOwned(name: &str): string throws EnvError {
  unsafe {
    const length = tn_process_getenv_length(name as *const u8);
    if (length === ~0) {
      throw envError( - 2);
    }
    const pointer = rawAlloc(length + 1);
    const status = tn_process_getenv_copy(name as *const u8, pointer, length + 1);
    if (status !== 0) {
      rawFree(pointer);
      throw envError(status);
    }
    const result = fromRaw(tn_string_from_bytes(pointer as *const u8, length), length);
    rawFree(pointer);
    return result;
  }
}
export function lookupU16(name: &str): u16 throws ParseIntegerError {
  unsafe {
    const pointer = tn_process_getenv(name as *const u8);
    const length = tn_process_getenv_length(name as *const u8);
    if (length === ~0) {
      return 0;
    }
    const input: Bytes = Bytes.fromRaw(pointer, length);
    const parsed = try usize.parseAscii(input);
    return checkedU16(parsed);
  }
}
