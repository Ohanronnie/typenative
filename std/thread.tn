import { Drop } from "std/core";
import { c_size } from "std/ffi";
import { Duration } from "std/time";

declare extern "C" {
  function tn_thread_sleep_ns(nanoseconds: u64): void;
  function tn_thread_yield(): void;
  function tn_thread_spawn_raw_pointer(entry: * mut u8, argument: * mut u8): * mut u8;
  function tn_thread_join(handle: * mut u8, result: * mut u8): i32;
  function tn_thread_detach(handle: * mut u8): i32;
  function tn_thread_id(): u64;
}
@Drop export struct Thread {
  private handle: * mut u8;
  private joined: bool;
  mut drop(): void {
    if (!this.joined) {
      unsafe {
        tn_thread_detach(this.handle);
      }
    }
  }
}
@Drop export struct JoinHandle<T> {
  private handle: * mut u8;
  private joined: bool;
  public isJoined(): bool {
    return this.joined;
  }
  public mut joinRaw(result: * mut u8): i32 {
    if (this.joined) {
      return 114i32;
    }
    unsafe {
      const status = tn_thread_join(this.handle, result);
      if (status === 0i32) {
        this.joined = true;
      }
      return status;
    }
  }
  public mut detachRaw(): i32 {
    if (this.joined) {
      return 0i32;
    }
    unsafe {
      const status = tn_thread_detach(this.handle);
      if (status === 0i32) {
        this.joined = true;
      }
      return status;
    }
  }
  mut drop(): void {
    if (!this.joined) {
      unsafe {
        tn_thread_detach(this.handle);
      }
    }
  }
}
export function sleep(duration: Duration): void {
  unsafe {
    tn_thread_sleep_ns(duration.nanoseconds());
  }
}
export function yieldNow(): void {
  unsafe {
    tn_thread_yield();
  }
}
export function threadId(): u64 {
  unsafe {
    return tn_thread_id();
  }
}
export unsafe function spawnRaw(entry: * mut u8, argument: * mut u8): JoinHandle<u8> {
  unsafe {
    return {
      handle: tn_thread_spawn_raw_pointer(entry, argument), joined: false
    };
  }
}
export function join<T>(handle: & mut JoinHandle<T>, result: * mut u8): i32 {
  return handle.joinRaw(result);
}
export function detach<T>(handle: & mut JoinHandle<T >): i32 {
  return handle.detachRaw();
}
