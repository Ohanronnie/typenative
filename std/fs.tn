export function openReadChecked(path: & static str): File throws FileError {
  const file = openRead(path);
  if (!file.isOpen()) {
    throw fileError( - 1i32);
  }
  return file;
}
export function openWriteChecked(path: & static str): File throws FileError {
  const file = openWrite(path);
