  public asStr(): & static str {
    return this.text;
  }
}
@Drop export struct File {
  private handle: i32;
  private closed: bool;
  public isOpen(): bool {
    return !this.closed && this.handle >= 0i32;
  }
  public mut close(): void {
    if (!this.closed) {
      unsafe {
        tn_file_close(this.handle);
      }
      this.closed = true;
    }
  }
  public readRaw(bytes: * mut u8, length: usize): isize {
    unsafe {
      return tn_file_read(this.handle, bytes, length);
