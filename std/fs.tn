export enum FileKind {
  Regular, Directory, Other,
}
export struct FileMetadata {
  public size: usize;
  public kind: FileKind;
  public modifiedNanoseconds: i64;
}
function classifyMode(mode: u32): FileKind {
  const typeBits = mode & 61440u32;
  if (typeBits === 32768u32) {
    return FileKind.Regular;
  }
  if (typeBits === 16384u32) {
    return FileKind.Directory;
  }
  return FileKind.Other;
}
export function metadata(path: & str): FileMetadata throws FileError {
  let size: usize = 0usize;
  let modified: i64 = 0i64;
  let mode: u32 = 0u32;
  let status: i32 = 0i32;
  unsafe {
    status = tn_file_stat(path as * const u8,( & mut size)as * mut usize,( & mut modified)as * mut i64,( & mut mode)as * mut u32);
  }
  if (status !== 0i32) {
    throw fileError(status);
