import { nullPointer } from "std/alloc";
import { c_size, c_ssize } from "std/ffi";

declare extern "C" {
  function tn_file_open(path: *const u8, flags: i32, mode: i32): i32;
  function tn_file_open_create(path: *const u8, flags: i32, mode: i32): i32;
  function tn_file_read(handle: i32, bytes: *mut u8, length: c_size): c_ssize;
  function tn_file_write(handle: i32, bytes: *const u8, length: c_size): c_ssize;
  function tn_file_read_exact(handle: i32, bytes: *mut u8, length: c_size): c_ssize;
  function tn_file_write_all(handle: i32, bytes: *const u8, length: c_size): c_ssize;
  function tn_file_close(handle: i32): i32;
  function tn_file_exists(path: *const u8): i32;
  function tn_file_remove(path: *const u8): i32;
  function tn_file_stat(path: *const u8, size: *mut c_size, modified: *mut i64, mode: *mut u32): i32;
  function tn_dir_open(path: *const u8): *mut u8;
  function tn_dir_next(handle: *mut u8, name: *mut u8, capacity: c_size, kind: *mut u32): i32;
  function tn_dir_close(handle: *mut u8): i32;
}
export struct Path {
  private text: &static str;
  public asStr(): &str {
    return this.text;
  }
}
export struct File {
  private handle: i32;
  private closed: bool;
  public isOpen(): bool {
    return !this.closed && this.handle >= 0;
  }
  public close(): void {
    if (!this.closed) {
      unsafe {
        tn_file_close(this.handle);
      }
      this.closed = true;
    }
  }
  public unsafe readRaw(bytes: *mut u8, length: usize): isize {
    unsafe {
      return tn_file_read(this.handle, bytes, length);
    }
  }
  public unsafe writeRaw(bytes: *const u8, length: usize): isize {
    unsafe {
      return tn_file_write(this.handle, bytes, length);
    }
  }
  public unsafe readExactRaw(bytes: *mut u8, length: usize): isize {
    unsafe {
      return tn_file_read_exact(this.handle, bytes, length);
    }
  }
  public unsafe writeAllRaw(bytes: *const u8, length: usize): isize {
    unsafe {
      return tn_file_write_all(this.handle, bytes, length);
    }
  }
  [Symbol.dispose](): void {
    this.close();
  }
}
export struct Directory {
  private handle: *mut u8;
  private closed: bool;
  public isOpen(): bool {
    unsafe {
      return !this.closed && this.handle !== nullPointer<u8>();
    }
  }
  public unsafe next(name: *mut u8, capacity: usize, kind: *mut u32): i32 {
    unsafe {
      return tn_dir_next(this.handle, name, capacity, kind);
    }
  }
  public close(): i32 {
    if (this.closed) {
      return 0;
    }
    unsafe {
      const status = tn_dir_close(this.handle);
      this.closed = true;
      return status;
    }
  }
  [Symbol.dispose](): void {
    this.close();
  }
}
export struct FileError {
  public rawCode: i32;
}
function fileError(code: i32): FileError {
  return {
    rawCode: code
  };
}
function openRead(path: &str): File {
  unsafe {
    const handle = tn_file_open(path as *const u8, 0, 0);
    return {
      handle: handle, closed: false
    };
  }
}
function openWrite(path: &str): File {
  unsafe {
    const handle = tn_file_open_create(path as *const u8, 577, 420);
    return {
      handle: handle, closed: false
    };
  }
}
export function tryOpenRead(path: &str): File throws FileError {
  const file = openRead(path);
  if (!file.isOpen()) {
    throw fileError( - 1);
  }
  return file;
}
export function tryOpenWrite(path: &str): File throws FileError {
  const file = openWrite(path);
  if (!file.isOpen()) {
    throw fileError( - 1);
  }
  return file;
}
export function exists(path: &str): bool {
  unsafe {
    return tn_file_exists(path as *const u8) !== 0;
  }
}
export function remove(path: &str): i32 {
  unsafe {
    return tn_file_remove(path as *const u8);
  }
}
export enum FileKind {
  Regular, Directory, Other,
}
export struct FileMetadata {
  public size: usize;
  public kind: FileKind;
  public modifiedNanoseconds: i64;
}
function classifyMode(mode: u32): FileKind {
  const typeBits = mode & 61440;
  if (typeBits === 32768) {
    return FileKind.Regular;
  }
  if (typeBits === 16384) {
    return FileKind.Directory;
  }
  return FileKind.Other;
}
export function metadata(path: &str): FileMetadata throws FileError {
  let size: usize = 0;
  let modified: i64 = 0;
  let mode: u32 = 0;
  let status: i32 = 0;
  unsafe {
    status = tn_file_stat(path as *const u8,( &mut size)as *mut usize,( &mut modified)as *mut i64,( &mut mode)as *mut u32);
  }
  if (status !== 0) {
    throw fileError(status);
  }
  return {
    size: size, kind: classifyMode(mode), modifiedNanoseconds: modified,
  };
}
function openDirectory(path: &str): Directory {
  unsafe {
    return {
      handle: tn_dir_open(path as *const u8), closed: false
    };
  }
}
export function tryOpenDirectory(path: &str): Directory throws FileError {
  const directory = openDirectory(path);
  if (!directory.isOpen()) {
    throw fileError( - 1);
  }
  return directory;
}
