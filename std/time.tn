      return tn_string_from_bytes(buffer.pointer as * const u8, buffer.length);
    }
  }
}
function dateWithEpochMilliseconds(value: i64): Date {
  let result = new Date();
  result.epochMilliseconds = value;
  return result;
}
function floorDivide(value: i64, divisor: i64): i64 {
  const quotient = value / divisor;
  const remainder = value % divisor;
  if (remainder<0i64) {
    return quotient - 1i64;
  }
  return quotient;
}
function partsFor(epochMilliseconds: i64): DateParts {
  const millisecondsPerDay = 86400000i64;
  const days = floorDivide(epochMilliseconds, millisecondsPerDay);
  const dayMilliseconds = epochMilliseconds - days * millisecondsPerDay;
  const civil = civilFromDays(days);
  const hour = dayMilliseconds / 3600000i64;
  const afterHour = dayMilliseconds % 3600000i64;
  const minute = afterHour / 60000i64;
  const afterMinute = afterHour % 60000i64;
  const second = afterMinute / 1000i64;
  return {
    year: civil.year, month: civil.month, day: civil.day, hour: hour, minute: minute, second: second, millisecond: afterMinute % 1000i64,
  };
}
struct CivilDate {
  public year: i64;
  public month: i64;
  public day: i64;
}
function civilFromDays(days: i64): CivilDate {
  let shifted = days + 719468i64;
  let era: i64 = 0i64;
  if (shifted >= 0i64) {
    era = shifted / 146097i64;
  } else {
    era =(shifted - 146096i64) / 146097i64;
  }
  const dayOfEra = shifted - era * 146097i64;
  const yearOfEra =(dayOfEra - dayOfEra / 1460i64 + dayOfEra / 36524i64 - dayOfEra / 146096i64) / 365i64;
  let year = yearOfEra + era * 400i64;
  const dayOfYear = dayOfEra -(365i64 * yearOfEra + yearOfEra / 4i64 - yearOfEra / 100i64);
  const monthPart =(5i64 * dayOfYear + 2i64) / 153i64;
  const day = dayOfYear -(153i64 * monthPart + 2i64) / 5i64 + 1i64;
  let month: i64 = 0i64;
  if (monthPart<10i64) {
    month = monthPart + 3i64;
  } else {
    month = monthPart - 9i64;
  }
  if (month <= 2i64) {
    year += 1i64;
  }
  return {
    year: year, month: month, day: day,
  };
}
function appendYear(buffer: & mut BytesMut, year: i64): void {
  if (year >= 0i64 && year <= 9999i64) {
    appendUnsignedNumber(buffer, year, 4usize);
    return;
  }
  if (year > 9999i64) {
    buffer.push(43u8);
    appendUnsignedNumber(buffer, year, 6usize);
    return;
  }
  appendSignedNumber(buffer, year, 6usize);
}
function appendUnsignedNumber(buffer: & mut BytesMut, value: i64, minimumDigits: usize): void {
  let divisor = 1i64;
  let digits = 1usize;
  while (value / divisor >= 10i64 && divisor <= 1000000000000000000i64) {
    divisor *= 10i64;
    digits += 1usize;
  }
  while (digits<minimumDigits) {
    buffer.push(48u8);
    digits += 1usize;
  }
  let remaining = value;
  while (divisor > 0i64) {
    let digit = remaining / divisor;
    if (digit<0i64) {
      digit = - digit;
    }
    buffer.push(asciiDigit(digit));
    remaining = remaining % divisor;
    divisor /= 10i64;
  }
}
function appendSignedNumber(buffer: & mut BytesMut, value: i64, minimumDigits: usize): void {
  if (value >= 0i64) {
    appendUnsignedNumber(buffer, value, minimumDigits);
    return;
  }
