import { BytesMut } from "std/bytes";
import { c_size } from "std/ffi";
import { fromRaw } from "std/string";

declare extern "C" {
  function tn_clock_monotonic_nanoseconds(): u64;
  function tn_clock_wall_nanoseconds(): i64;
  function tn_string_from_bytes(bytes: *const u8, length: c_size): *mut u8;
}
// Duration stores elapsed nanoseconds and all scaled constructors saturate at
// the largest representable value. Arithmetic never wraps into a short delay.
export struct Duration {
  public totalNanoseconds: u64;
  public static fromNanoseconds(value: u64): Duration {
    return {
      totalNanoseconds: value,
    };
  }
  public static fromMicroseconds(value: u64): Duration {
    return fromScaled(value, 1000);
  }
  public static fromMilliseconds(value: u64): Duration {
    return fromScaled(value, 1000000);
  }
  public static fromSeconds(value: u64): Duration {
    return fromScaled(value, 1000000000);
  }
  public nanoseconds(): u64 {
    return this.totalNanoseconds;
  }
  public microseconds(): u64 {
    return this.totalNanoseconds / 1000;
  }
  public milliseconds(): u64 {
    return this.totalNanoseconds / 1000000;
  }
  public seconds(): u64 {
    return this.totalNanoseconds / 1000000000;
  }
  public saturatingAdd(other: Duration): Duration {
    if (other.totalNanoseconds > ~0 - this.totalNanoseconds) {
      return {
        totalNanoseconds: ~0,
      };
    }
    return {
      totalNanoseconds: this.totalNanoseconds + other.totalNanoseconds,
    };
  }
  public saturatingSub(other: Duration): Duration {
    if (other.totalNanoseconds > this.totalNanoseconds) {
      return {
        totalNanoseconds: 0,
      };
    }
    return {
      totalNanoseconds: this.totalNanoseconds - other.totalNanoseconds,
    };
  }
}
function fromScaled(value: u64, scale: u64): Duration {
  if (value > ~0 / scale) {
    return {
      totalNanoseconds: ~0,
    };
  }
  return {
    totalNanoseconds: value * scale,
  };
}
export struct Instant {
  public timestampNanoseconds: u64;
  public static now(): Instant {
    unsafe {
      return {
        timestampNanoseconds: tn_clock_monotonic_nanoseconds(),
      };
    }
  }
  public durationSince(start: &Instant): Duration {
    if (this.timestampNanoseconds<start.timestampNanoseconds) {
      return Duration.fromNanoseconds(0);
    }
    return Duration.fromNanoseconds(this.timestampNanoseconds - start.timestampNanoseconds);
  }
  public elapsed(): Duration {
    const finish = Instant.now();
    if (finish.timestampNanoseconds<this.timestampNanoseconds) {
      return Duration.fromNanoseconds(0);
    }
    return Duration.fromNanoseconds(finish.timestampNanoseconds - this.timestampNanoseconds);
  }
}
struct DateParts {
  public year: i64;
  public month: i64;
  public day: i64;
  public hour: i64;
  public minute: i64;
  public second: i64;
  public millisecond: i64;
}
export class Date {
  public epochMilliseconds: i64;
  public constructor() {
    this.epochMilliseconds = Date.now();
  }
  public static now(): i64 {
    unsafe {
      return floorDivide(tn_clock_wall_nanoseconds(), 1000000);
    }
  }
  public static fromEpochMilliseconds(value: i64): Date {
    return dateWithEpochMilliseconds(value);
  }
  public getTime(): i64 {
    return this.epochMilliseconds;
  }
  public getUTCFullYear(): i64 {
    return partsFor(this.epochMilliseconds).year;
  }
  public getUTCMonth(): i64 {
    return partsFor(this.epochMilliseconds).month - 1;
  }
  public getUTCDate(): i64 {
    return partsFor(this.epochMilliseconds).day;
  }
  public getUTCHours(): i64 {
    return partsFor(this.epochMilliseconds).hour;
  }
  public getUTCMinutes(): i64 {
    return partsFor(this.epochMilliseconds).minute;
  }
  public getUTCSeconds(): i64 {
    return partsFor(this.epochMilliseconds).second;
  }
  public getUTCMilliseconds(): i64 {
    return partsFor(this.epochMilliseconds).millisecond;
  }
  public toISOString(): string {
    const parts = partsFor(this.epochMilliseconds);
    let buffer = new BytesMut({
      capacity: 32,
    });
    appendYear( &mut buffer, parts.year);
    buffer.appendAscii("-");
    appendUnsignedNumber( &mut buffer, parts.month, 2);
    buffer.appendAscii("-");
    appendUnsignedNumber( &mut buffer, parts.day, 2);
    buffer.appendAscii("T");
    appendUnsignedNumber( &mut buffer, parts.hour, 2);
    buffer.appendAscii(":");
    appendUnsignedNumber( &mut buffer, parts.minute, 2);
    buffer.appendAscii(":");
    appendUnsignedNumber( &mut buffer, parts.second, 2);
    buffer.appendAscii(".");
    appendUnsignedNumber( &mut buffer, parts.millisecond, 3);
    buffer.appendAscii("Z");
    unsafe {
      return fromRaw(tn_string_from_bytes(buffer.nativePointer()as *const u8, buffer.length), buffer.length);
    }
  }
}
function dateWithEpochMilliseconds(value: i64): Date {
  let result = new Date();
  result.epochMilliseconds = value;
  return result;
}
function floorDivide(value: i64, divisor: i64): i64 {
  const quotient = value / divisor;
  const remainder = value % divisor;
  if (remainder<0) {
    return quotient - 1;
  }
  return quotient;
}
function partsFor(epochMilliseconds: i64): DateParts {
  const millisecondsPerDay: i64 = 86400000;
  const days = floorDivide(epochMilliseconds, millisecondsPerDay);
  const dayMilliseconds = epochMilliseconds - days * millisecondsPerDay;
  const civil = civilFromDays(days);
  const hour = dayMilliseconds / 3600000;
  const afterHour = dayMilliseconds % 3600000;
  const minute = afterHour / 60000;
  const afterMinute = afterHour % 60000;
  const second = afterMinute / 1000;
  return {
    year: civil.year, month: civil.month, day: civil.day, hour: hour, minute: minute, second: second, millisecond: afterMinute % 1000,
  };
}
struct CivilDate {
  public year: i64;
  public month: i64;
  public day: i64;
}
function civilFromDays(days: i64): CivilDate {
  let shifted = days + 719468;
  let era: i64 = 0;
  if (shifted >= 0) {
    era = shifted / 146097;
  } else {
    era =(shifted - 146096) / 146097;
  }
  const dayOfEra = shifted - era * 146097;
  const yearOfEra =(dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;
  let year = yearOfEra + era * 400;
  const dayOfYear = dayOfEra -(365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);
  const monthPart: i64 =(5 * dayOfYear + 2) / 153;
  const day = dayOfYear -(153 * monthPart + 2) / 5 + 1;
  let month: i64 = 0;
  if (monthPart<10) {
    month = monthPart + 3;
  } else {
    month = monthPart - 9;
  }
  if (month <= 2) {
    year += 1;
  }
  return {
    year: year, month: month, day: day,
  };
}
function appendYear(buffer: &mut BytesMut, year: i64): void {
  if (year >= 0 && year <= 9999) {
    appendUnsignedNumber(buffer, year, 4);
    return;
  }
  if (year > 9999) {
    buffer.push(43);
    appendUnsignedNumber(buffer, year, 6);
    return;
  }
  appendSignedNumber(buffer, year, 6);
}
function appendUnsignedNumber(buffer: &mut BytesMut, value: i64, minimumDigits: usize): void {
  let divisor: i64 = 1;
  let digits: usize = 1;
  while (value / divisor >= 10 && divisor <= 1000000000000000000) {
    divisor *= 10;
    digits += 1;
  }
  while (digits<minimumDigits) {
    buffer.push(48);
    digits += 1;
  }
  let remaining = value;
  while (divisor > 0) {
    let digit = remaining / divisor;
    if (digit<0) {
      digit = - digit;
    }
    buffer.push(asciiDigit(digit));
    remaining = remaining % divisor;
    divisor /= 10;
  }
}
function appendSignedNumber(buffer: &mut BytesMut, value: i64, minimumDigits: usize): void {
  if (value >= 0) {
    appendUnsignedNumber(buffer, value, minimumDigits);
    return;
  }
  buffer.push(45);
  let divisor: i64 = 1;
  let digits: usize = 1;
  while (value / divisor <= - 10 && divisor <= 1000000000000000000) {
    divisor *= 10;
    digits += 1;
  }
  while (digits<minimumDigits) {
    buffer.push(48);
    digits += 1;
  }
  let remaining = value;
  while (divisor > 0) {
    let digit = remaining / divisor;
    if (digit<0) {
      digit = - digit;
    }
    buffer.push(asciiDigit(digit));
    remaining = remaining % divisor;
    divisor /= 10;
  }
}
function asciiDigit(value: i64): u8 {
  if (value === 0)return 48;
  if (value === 1)return 49;
  if (value === 2)return 50;
  if (value === 3)return 51;
  if (value === 4)return 52;
  if (value === 5)return 53;
  if (value === 6)return 54;
  if (value === 7)return 55;
  if (value === 8)return 56;
  return 57;
}
