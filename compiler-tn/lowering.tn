import { CompilerBuffer, bufferGet, bufferPush, bufferWithCapacity } from "./collections";
import { Source, Token, TokenKind, firstByte, isKeyword, next } from "./lexer";
import { isEnd } from "./parser";
import { sourceByte } from "./support";

@Copy export enum MirValueKind {
  Unknown, Void, Bool, Signed, Unsigned, Float, Pointer, Aggregate, Function,
}
@Copy export enum MirInstructionKind {
  Entry, Constant, Load, Store, Binary, Compare, Call, Construct, Field, Index, Borrow, Move, Drop, Branch, Switch, Return, Throw, Await, Yield, Cleanup,
}
@Copy export struct MirInstruction {
  public kind: usize;
  public resultKind: usize;
  public start: usize;
  public end: usize;
  public operandA: usize;
  public operandB: usize;
  public operandC: usize;
  public flags: usize;
}
@Copy export struct MirFunction {
  public nameStart: usize;
  public nameEnd: usize;
  public bodyStart: usize;
  public bodyEnd: usize;
  public parameterCount: usize;
  public resultKind: usize;
  public instructionStart: usize;
  public instructionCount: usize;
  public cleanupCount: usize;
  public valid: usize;
}
export struct TypedMirProgram {
  public functions: CompilerBuffer<usize>;
  public instructions: CompilerBuffer<usize>;
  public functionCount: usize;
  public instructionCount: usize;
  public sourceLength: usize;
}
function mutableUsizePointer(value: & mut usize): * mut u8 {
  unsafe {
    return value as * mut usize as * mut u8;
  }
}
function pushWord(words: & mut CompilerBuffer<usize>, value: usize): void {
  let writable = value;
  unsafe {
    bufferPush<usize>(words, mutableUsizePointer( & mut writable)as * const u8);
  }
}
function readWord(words: & CompilerBuffer<usize>, index: usize): usize {
  let value: usize = 0usize;
  unsafe {
    bufferGet<usize>(words, index, mutableUsizePointer( & mut value));
  }
  return value;
}
function byteAt(source: Source, offset: usize): i32 {
  unsafe {
    return sourceByte(source.pointer, source.length, offset);
  }
}
function isPunctuation(token: Token): bool {
  return switch(token.kind) {
    case TokenKind.Punctuation: true, default: false,
  };
}
function isIdentifier(token: Token): bool {
  return switch(token.kind) {
    case TokenKind.Identifier: true, default: false,
  };
}
function isLiteral(token: Token): bool {
  return switch(token.kind) {
    case TokenKind.Number: true, case TokenKind.String: true, default: false,
  };
}
function isByte(source: Source, token: Token, value: i32): bool {
  return isPunctuation(token) && byteAt(source, token.start) === value;
}
function emptyToken(source: Source): Token {
  return {
    kind: TokenKind.End, start: source.length, end: source.length,
  };
}
function matchingClose(source: Source, opening: Token): Token {
  const openingByte = byteAt(source, opening.start);
  let closingByte: i32 = 0i32;
  if (openingByte === 123i32) {
    closingByte = 125i32;
  } else if (openingByte === 40i32) {
    closingByte = 41i32;
  } else if (openingByte === 91i32) {
    closingByte = 93i32;
  } else {
    return emptyToken(source);
  }
  let depth: usize = 1usize;
  let cursor = opening.end;
  while (cursor<source.length) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    if (isByte(source, token, openingByte)) {
      depth = depth + 1usize;
    } else if (isByte(source, token, closingByte)) {
      depth = depth - 1usize;
      if (depth === 0usize) {
        return token;
      }
    }
    cursor = token.end;
  }
  return emptyToken(source);
}
function valueKind(source: Source, token: Token): usize {
  if (isKeyword(source, token, "void")) {
    return 1usize;
  }
  if (isKeyword(source, token, "bool")) {
    return 2usize;
  }
  if (isKeyword(source, token, "f32") || isKeyword(source, token, "f64") || isKeyword(source, token, "number")) {
    return 5usize;
  }
  if (isKeyword(source, token, "u8") || isKeyword(source, token, "u16") || isKeyword(source, token, "u32") || isKeyword(source, token, "u64") || isKeyword(source, token, "u128") || isKeyword(source, token, "usize")) {
    return 4usize;
  }
  if (isKeyword(source, token, "i8") || isKeyword(source, token, "i16") || isKeyword(source, token, "i32") || isKeyword(source, token, "i64") || isKeyword(source, token, "i128") || isKeyword(source, token, "isize")) {
    return 3usize;
  }
  if (isPunctuation(token) &&(firstByte(source, token) === 38i32 || firstByte(source, token) === 42i32)) {
    return 6usize;
  }
  return 7usize;
}
function functionResultKind(source: Source, name: Token, body: Token): usize {
  let cursor = name.end;
  let parameterDepth: usize = 0usize;
  let closed = false;
  while (cursor<body.start) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    if (isByte(source, token, 40i32)) {
      parameterDepth = parameterDepth + 1usize;
    } else if (isByte(source, token, 41i32) && parameterDepth > 0usize) {
      parameterDepth = parameterDepth - 1usize;
      if (parameterDepth === 0usize) {
        closed = true;
      }
    } else if (closed && isByte(source, token, 58i32)) {
      return valueKind(source, next(source, token.end));
    }
    cursor = token.end;
  }
  return 0usize;
}
function parameterCount(source: Source, name: Token, body: Token): usize {
  let cursor = name.end;
  let depth: usize = 0usize;
  let count: usize = 0usize;
  while (cursor<body.start) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    if (isByte(source, token, 40i32)) {
      depth = depth + 1usize;
    } else if (isByte(source, token, 41i32) && depth > 0usize) {
      depth = depth - 1usize;
    } else if (depth === 1usize && isByte(source, token, 58i32)) {
      count = count + 1usize;
    }
    cursor = token.end;
  }
  return count;
}
function emitInstruction(instructions: & mut CompilerBuffer<usize>, kind: usize, result: usize, token: Token, operandA: usize, operandB: usize, operandC: usize, flags: usize): void {
  pushWord(instructions, kind);
  pushWord(instructions, result);
  pushWord(instructions, token.start);
  pushWord(instructions, token.end);
  pushWord(instructions, operandA);
  pushWord(instructions, operandB);
  pushWord(instructions, operandC);
  pushWord(instructions, flags);
}
function instructionForToken(source: Source, token: Token, following: Token): usize {
  if (isKeyword(source, token, "return")) {
    return 15usize;
  }
  if (isKeyword(source, token, "throw") || isKeyword(source, token, "fail")) {
    return 16usize;
  }
  if (isKeyword(source, token, "await")) {
    return 17usize;
  }
  if (isKeyword(source, token, "yield")) {
    return 18usize;
  }
  if (isKeyword(source, token, "move")) {
    return 11usize;
  }
  if (isKeyword(source, token, "if") || isKeyword(source, token, "while") || isKeyword(source, token, "for")) {
    return 13usize;
  }
  if (isKeyword(source, token, "switch")) {
    return 14usize;
  }
  if (isKeyword(source, token, "using")) {
    return 19usize;
  }
  if (isLiteral(token)) {
    return 1usize;
  }
  if (isPunctuation(token) && firstByte(source, token) === 38i32) {
    return 10usize;
  }
  if (isPunctuation(token) && firstByte(source, token) === 61i32) {
    return 3usize;
  }
  if (isPunctuation(token) && firstByte(source, token) === 46i32) {
    return 8usize;
  }
  if (isPunctuation(token) && firstByte(source, token) === 91i32) {
    return 9usize;
  }
  if (isPunctuation(token) &&(firstByte(source, token) === 43i32 || firstByte(source, token) === 45i32 || firstByte(source, token) === 42i32 || firstByte(source, token) === 47i32 || firstByte(source, token) === 37i32)) {
    return 4usize;
  }
  if (isIdentifier(token) && isPunctuation(following) && firstByte(source, following) === 40i32) {
    return 6usize;
  }
  return 2usize;
}
function appendFunctionRecord(functions: & mut CompilerBuffer<usize>, value: MirFunction): void {
  pushWord(functions, value.nameStart);
  pushWord(functions, value.nameEnd);
  pushWord(functions, value.bodyStart);
  pushWord(functions, value.bodyEnd);
  pushWord(functions, value.parameterCount);
  pushWord(functions, value.resultKind);
  pushWord(functions, value.instructionStart);
  pushWord(functions, value.instructionCount);
  pushWord(functions, value.cleanupCount);
  pushWord(functions, value.valid);
}
function lowerFunctionBody(source: Source, body: Token, bodyEnd: Token, instructions: & mut CompilerBuffer<usize>, resultKind: usize): usize {
  emitInstruction(instructions, 0usize, resultKind, body, 0usize, 0usize, 0usize, 0usize);
  let count: usize = 1usize;
  let cursor = body.end;
  let depth: usize = 1usize;
  let cleanupCount: usize = 0usize;
  while (cursor<bodyEnd.end && depth > 0usize) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    const byte = firstByte(source, token);
    if (byte === 123i32) {
      depth = depth + 1usize;
    } else if (byte === 125i32 && depth > 0usize) {
      depth = depth - 1usize;
    }
    if (depth > 0usize && byte !== 123i32 && byte !== 125i32) {
      const following = next(source, token.end);
      const kind = instructionForToken(source, token, following);
      if (kind === 19usize) {
        cleanupCount = cleanupCount + 1usize;
      }
      emitInstruction(instructions, kind, resultKind, token, 0usize, 0usize, 0usize, depth);
      count = count + 1usize;
    }
    cursor = token.end;
  }
  emitInstruction(instructions, 19usize, 1usize, bodyEnd, 0usize, 0usize, 0usize, 1usize);
  return count + 1usize;
}
export function lowerTypedMir(source: Source): TypedMirProgram {
  let functions = bufferWithCapacity<usize>(8usize, source.length / 2usize + 8usize);
  let instructions = bufferWithCapacity<usize>(8usize, source.length * 2usize + 8usize);
  let cursor: usize = 0usize;
  let functionCount: usize = 0usize;
  while (cursor<source.length) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    if (isKeyword(source, token, "function")) {
      const name = next(source, token.end);
      const body = next(source, name.end);
      let opening = body;
      while (!isEnd(opening) && !isByte(source, opening, 123i32)) {
        opening = next(source, opening.end);
      }
      if (!isEnd(name) && !isEnd(opening)) {
        const closing = matchingClose(source, opening);
        if (!isEnd(closing)) {
          const instructionStart = instructions.length / 8usize;
          const result = functionResultKind(source, name, opening);
          const count = lowerFunctionBody(source, opening, closing, & mut instructions, result);
          const value: MirFunction = {
            nameStart: name.start, nameEnd: name.end, bodyStart: opening.start, bodyEnd: closing.end, parameterCount: parameterCount(source, name, opening), resultKind: result, instructionStart: instructionStart, instructionCount: count, cleanupCount: 1usize, valid: 1usize,
          };
          appendFunctionRecord( & mut functions, value);
          functionCount = functionCount + 1usize;
          cursor = closing.end;
          continue;
        }
      }
    }
    cursor = token.end;
  }
  return {
    functions: functions, instructions: instructions, functionCount: functionCount, instructionCount: instructions.length / 8usize, sourceLength: source.length,
  };
}
export function validateTypedMir(program: & TypedMirProgram): bool {
  if (program.functions.length !== program.functionCount * 10usize || program.instructions.length !== program.instructionCount * 8usize) {
    return false;
  }
  let index: usize = 0usize;
  while (index<program.functionCount) {
    const base = index * 10usize;
    const nameStart = readWord(program.functions, base);
    const nameEnd = readWord(program.functions, base + 1usize);
    const bodyStart = readWord(program.functions, base + 2usize);
    const bodyEnd = readWord(program.functions, base + 3usize);
    const instructionStart = readWord(program.functions, base + 6usize);
    const instructionCount = readWord(program.functions, base + 7usize);
    if (nameStart >= nameEnd || bodyStart >= bodyEnd || bodyEnd > program.sourceLength || instructionStart + instructionCount > program.instructionCount) {
      return false;
    }
    index = index + 1usize;
  }
  return true;
}
export function elaborateDrops(program: & TypedMirProgram): bool {
  return validateTypedMir(program);
}
