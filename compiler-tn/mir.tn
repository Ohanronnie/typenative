export struct MirProgram {
  public blocks: usize;
  public locals: usize;
  public errors: usize;
  public functions: usize;
  public borrowOperations: usize;
  public moveOperations: usize;
  public awaitOperations: usize;
  public sourceIdentity: u64;
  public sourceLength: usize;
  public entryBlock: usize;
  public exitBlock: usize;
  public recordPointer: * mut u8;
  public recordCapacity: usize;
  public recordElementSize: usize;
  public recordLength: usize;
  public records: Vec<usize>;
}
function mutableUsizePointer(value: & mut usize): * mut usize {
  unsafe {
    return value as * mut usize;
  }
}
function mutableBytePointer(value: & mut usize): * mut u8 {
  unsafe {
    return value as * mut u8;
  }
}
function pushWord(words: & mut Vec<usize>, value: usize): void {
  let writable: usize = value;
  unsafe {
    const pointer = mutableUsizePointer( & mut writable);
    vecPush(words, pointer as * const u8);
  }
