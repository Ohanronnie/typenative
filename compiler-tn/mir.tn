  }
}
export function lower(source: Source, semantic: SemanticProgram): MirProgram {
  let records = vecWithCapacity<usize>(8usize, semantic.blockCount * 8usize + 8usize);
  let starts = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let endings = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let functionFlags = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let borrowCounts = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let moveCounts = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let awaitCounts = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let operationCounts = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let active = vecWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  const startsPointer = vecPointer( & starts);
  const startsCapacity = starts.capacity;
  const startsElementSize = starts.elementSize;
  const endingsPointer = vecPointer( & endings);
  const endingsCapacity = endings.capacity;
  const endingsElementSize = endings.elementSize;
  const functionFlagsPointer = vecPointer( & functionFlags);
  const functionFlagsCapacity = functionFlags.capacity;
  const functionFlagsElementSize = functionFlags.elementSize;
  const borrowCountsPointer = vecPointer( & borrowCounts);
  const borrowCountsCapacity = borrowCounts.capacity;
  const borrowCountsElementSize = borrowCounts.elementSize;
  const moveCountsPointer = vecPointer( & moveCounts);
  const moveCountsCapacity = moveCounts.capacity;
  const moveCountsElementSize = moveCounts.elementSize;
  const awaitCountsPointer = vecPointer( & awaitCounts);
  const awaitCountsCapacity = awaitCounts.capacity;
  const awaitCountsElementSize = awaitCounts.elementSize;
  const operationCountsPointer = vecPointer( & operationCounts);
  const operationCountsCapacity = operationCounts.capacity;
  const operationCountsElementSize = operationCounts.elementSize;
  const activePointer = vecPointer( & active);
  const activeCapacity = active.capacity;
  const activeElementSize = active.elementSize;
  let offset: usize = 0usize;
  let blockIndex: usize = 0usize;
  let previousWasFunction = false;
  while (offset<source.length) {
    const token = next(source, offset);
    if (isEnd(token)) {
      break;
    }
    if (isKeyword(source, token, "function")) {
      previousWasFunction = true;
    }
    const byte = firstByte(source, token);
    if (byte === 123i32) {
      pushWord( & mut starts, token.start);
      pushWord( & mut endings, source.length);
      pushWord( & mut functionFlags, previousWasFunction?1usize: 0usize);
      pushWord( & mut borrowCounts, 0usize);
      pushWord( & mut moveCounts, 0usize);
      pushWord( & mut awaitCounts, 0usize);
      pushWord( & mut operationCounts, 0usize);
      pushWord( & mut active, blockIndex);
      blockIndex = blockIndex + 1usize;
      previousWasFunction = false;
    } else if (byte === 125i32 && active.length > 0usize) {
      const activeBlock = rawVectorWord(activePointer, activeCapacity, activeElementSize, active.length - 1usize);
      active.length = active.length - 1usize;
      writeWord( & mut endings, activeBlock, token.end);
    }
    let operationKind: usize = 0usize;
    if (byte === 38i32) {
      operationKind = 1usize;
    } else if (isKeyword(source, token, "move")) {
      operationKind = 2usize;
    } else if (isKeyword(source, token, "await")) {
      operationKind = 3usize;
    }
    if (operationKind > 0usize && active.length > 0usize) {
      let activeIndex: usize = 0usize;
      while (activeIndex<active.length) {
        const activeBlock = rawVectorWord(activePointer, activeCapacity, activeElementSize, activeIndex);
        let value: usize = 0usize;
        if (operationKind === 1usize) {
          value = rawVectorWord(borrowCountsPointer, borrowCountsCapacity, borrowCountsElementSize, activeBlock);
          writeWord( & mut borrowCounts, activeBlock, value + 1usize);
        } else if (operationKind === 2usize) {
          value = rawVectorWord(moveCountsPointer, moveCountsCapacity, moveCountsElementSize, activeBlock);
          writeWord( & mut moveCounts, activeBlock, value + 1usize);
        } else {
          value = rawVectorWord(awaitCountsPointer, awaitCountsCapacity, awaitCountsElementSize, activeBlock);
          writeWord( & mut awaitCounts, activeBlock, value + 1usize);
        }
        value = rawVectorWord(operationCountsPointer, operationCountsCapacity, operationCountsElementSize, activeBlock);
        writeWord( & mut operationCounts, activeBlock, value + 1usize);
        activeIndex = activeIndex + 1usize;
      }
    }
    if (token.end <= offset) {
      break;
    }
    offset = token.end;
  }
  if (blockIndex === 0usize) {
    {
      pushWord( & mut records, 0usize);
    }
    {
      pushWord( & mut records, source.length);
    }
    {
      pushWord( & mut records, 0usize);
    }
    {
      pushWord( & mut records, 0usize);
    }
    {
      pushWord( & mut records, 0usize);
    }
    {
      pushWord( & mut records, 0usize);
    }
    {
      pushWord( & mut records, 0usize);
    }
    {
      pushWord( & mut records, 0usize);
    }
    blockIndex = 1usize;
  } else {
    let index: usize = 0usize;
    while (index<blockIndex) {
      {
        appendRawWord( & mut records, startsPointer, startsCapacity, startsElementSize, index);
      }
      {
        appendRawWord( & mut records, endingsPointer, endingsCapacity, endingsElementSize, index);
      }
      {
        appendRawWord( & mut records, functionFlagsPointer, functionFlagsCapacity, functionFlagsElementSize, index);
      }
      {
        pushWord( & mut records, index + 1usize);
      }
      {
        appendRawWord( & mut records, borrowCountsPointer, borrowCountsCapacity, borrowCountsElementSize, index);
      }
      {
        appendRawWord( & mut records, moveCountsPointer, moveCountsCapacity, moveCountsElementSize, index);
      }
      {
        appendRawWord( & mut records, awaitCountsPointer, awaitCountsCapacity, awaitCountsElementSize, index);
      }
      {
        appendRawWord( & mut records, operationCountsPointer, operationCountsCapacity, operationCountsElementSize, index);
      }
      index = index + 1usize;
    }
  }
  const recordPointer = vecPointer( & records);
  const recordCapacity = records.capacity;
  const recordElementSize = records.elementSize;
  const recordLength = records.length;
  return {
    blocks: blockIndex, locals: semantic.tokenCount, errors: semantic.errors, functions: semantic.functionCount, borrowOperations: semantic.borrowOperationCount, moveOperations: semantic.moveOperationCount, awaitOperations: semantic.awaitOperationCount, sourceIdentity: semantic.sourceIdentity, sourceLength: source.length, entryBlock: 0usize, exitBlock: blockIndex - 1usize, recordPointer: recordPointer, recordCapacity: recordCapacity, recordElementSize: recordElementSize, recordLength: recordLength, records: records
  };
}
export function validate(blocks: usize, entryBlock: usize, exitBlock: usize, sourceLength: usize, recordPointer: * mut u8, recordCapacity: usize, recordElementSize: usize, recordLength: usize): bool {
  if (blocks === 0usize || entryBlock >= blocks || exitBlock >= blocks) {
    return false;
  }
  if (recordPointerIsNull(recordPointer) || recordElementSize === 0usize || recordCapacity<recordLength) {
    return false;
  }
  if (recordLength !== blocks * 8usize) {
    return false;
  }
  let index: usize = 0usize;
  while (index<blocks) {
    const start = recordWord(recordPointer, recordCapacity, recordElementSize, index * 8usize);
    const ending = recordWord(recordPointer, recordCapacity, recordElementSize, index * 8usize + 1usize);
    const successor = recordWord(recordPointer, recordCapacity, recordElementSize, index * 8usize + 3usize);
    if (start > ending || ending > sourceLength || successor > blocks) {
      return false;
    }
    index = index + 1usize;
  }
  return true;
}
