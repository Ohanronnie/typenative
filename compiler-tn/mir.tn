function recordWord(recordPointer: * mut u8, recordCapacity: usize, recordElementSize: usize, index: usize): usize {
  let value: usize = 0usize;
  unsafe {
    tn_bytes_copy_at(recordPointer as * const u8, recordCapacity * recordElementSize, index * recordElementSize, recordElementSize, mutableUsizePointer( & mut value)as * mut u8);
  }
  return value;
}
extern "C" {
  function tn_bytes_copy_at(source: * const u8, length: usize, offset: usize, count: usize, destination: * mut u8): i32;
  function tn_bytes_copy_to_at(source: * const u8, sourceLength: usize, sourceOffset: usize, count: usize, destination: * mut u8, destinationLength: usize, destinationOffset: usize): i32;
}
function writeWord(words: & mut Vec<usize>, index: usize, value: usize): void {
  let writable: usize = value;
  unsafe {
    tn_bytes_copy_to_at(mutableUsizePointer( & mut writable)as * const u8, words.elementSize, 0usize, words.elementSize, words.pointer as * mut u8, words.capacity * words.elementSize, index * words.elementSize);
  }
