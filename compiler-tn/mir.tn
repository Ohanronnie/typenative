  }
}
export function lowerMir(source: Source, semantic: SemanticProgram): MirProgram {
  let records = bufferWithCapacity<usize>(8usize, semantic.blockCount * 8usize + 8usize);
  let starts = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let endings = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let functionFlags = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let borrowCounts = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let moveCounts = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let awaitCounts = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let operationCounts = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let active = bufferWithCapacity<usize>(8usize, semantic.blockCount + 1usize);
  let offset: usize = 0usize;
  let blockIndex: usize = 0usize;
  let previousWasFunction = false;
  while (offset<source.length) {
    const token = next(source, offset);
    if (isEnd(token)) {
      break;
    }
    if (isKeyword(source, token, "function")) {
      previousWasFunction = true;
    }
    const byte = firstByte(source, token);
    if (byte === 123i32) {
      pushWord( & mut starts, token.start);
      pushWord( & mut endings, source.length);
      pushWord( & mut functionFlags, previousWasFunction?1usize: 0usize);
      pushWord( & mut borrowCounts, 0usize);
      pushWord( & mut moveCounts, 0usize);
      pushWord( & mut awaitCounts, 0usize);
      pushWord( & mut operationCounts, 0usize);
      pushWord( & mut active, blockIndex);
      blockIndex = blockIndex + 1usize;
      previousWasFunction = false;
    } else if (byte === 125i32 && active.length > 0usize) {
      const activeBlock = readWord( & active, active.length - 1usize);
      active.length = active.length - 1usize;
      writeWord( & mut endings, activeBlock, token.end);
    }
    let operationKind: usize = 0usize;
    if (byte === 38i32) {
      operationKind = 1usize;
    } else if (isKeyword(source, token, "move")) {
      operationKind = 2usize;
    } else if (isKeyword(source, token, "await")) {
      operationKind = 3usize;
    }
    if (operationKind > 0usize && active.length > 0usize) {
      let activeIndex: usize = 0usize;
      while (activeIndex<active.length) {
        const activeBlock = readWord( & active, activeIndex);
        let value: usize = 0usize;
        if (operationKind === 1usize) {
          value = readWord( & borrowCounts, activeBlock);
          writeWord( & mut borrowCounts, activeBlock, value + 1usize);
        } else if (operationKind === 2usize) {
          value = readWord( & moveCounts, activeBlock);
          writeWord( & mut moveCounts, activeBlock, value + 1usize);
        } else {
          value = readWord( & awaitCounts, activeBlock);
          writeWord( & mut awaitCounts, activeBlock, value + 1usize);
        }
        value = readWord( & operationCounts, activeBlock);
        writeWord( & mut operationCounts, activeBlock, value + 1usize);
        activeIndex = activeIndex + 1usize;
      }
    }
    if (token.end <= offset) {
      break;
    }
    offset = token.end;
  }
  if (blockIndex === 0usize) {
    pushWord( & mut records, 0usize);
    pushWord( & mut records, source.length);
    pushWord( & mut records, 0usize);
    pushWord( & mut records, 0usize);
    pushWord( & mut records, 0usize);
    pushWord( & mut records, 0usize);
    pushWord( & mut records, 0usize);
    pushWord( & mut records, 0usize);
    blockIndex = 1usize;
  } else {
    let index: usize = 0usize;
    while (index<blockIndex) {
      appendWord( & mut records, & starts, index);
      appendWord( & mut records, & endings, index);
      appendWord( & mut records, & functionFlags, index);
      pushWord( & mut records, index + 1usize);
      appendWord( & mut records, & borrowCounts, index);
      appendWord( & mut records, & moveCounts, index);
      appendWord( & mut records, & awaitCounts, index);
      appendWord( & mut records, & operationCounts, index);
      index = index + 1usize;
    }
  }
  const recordPointer = vecPointer( & records);
  const recordCapacity = records.capacity;
  const recordElementSize = records.elementSize;
  const recordLength = records.length;
  return {
    blocks: blockIndex, locals: semantic.tokenCount, errors: semantic.errors, functions: semantic.functionCount, borrowOperations: semantic.borrowOperationCount, moveOperations: semantic.moveOperationCount, awaitOperations: semantic.awaitOperationCount, sourceIdentity: semantic.sourceIdentity, sourceLength: source.length, entryBlock: 0usize, exitBlock: blockIndex - 1usize, recordPointer: recordPointer, recordCapacity: recordCapacity, recordElementSize: recordElementSize, recordLength: recordLength, records: records
  };
}
export function validateMir(blocks: usize, entryBlock: usize, exitBlock: usize, sourceLength: usize, recordPointer: * mut u8, recordCapacity: usize, recordElementSize: usize, recordLength: usize): bool {
  if (blocks === 0usize || entryBlock >= blocks || exitBlock >= blocks) {
    return false;
  }
  if (recordPointerIsNull(recordPointer) || recordElementSize === 0usize || recordCapacity<recordLength) {
    return false;
  }
  if (recordLength !== blocks * 8usize) {
    return false;
  }
  let index: usize = 0usize;
  while (index<blocks) {
    const start = recordWord(recordPointer, recordCapacity, recordElementSize, index * 8usize);
    const ending = recordWord(recordPointer, recordCapacity, recordElementSize, index * 8usize + 1usize);
    const successor = recordWord(recordPointer, recordCapacity, recordElementSize, index * 8usize + 3usize);
    if (start > ending || ending > sourceLength || successor > blocks) {
      return false;
    }
    index = index + 1usize;
  }
  return true;
}
