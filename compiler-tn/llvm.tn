export function emitI32Return(output: * const u8, moduleName: & str, functionName: & str, value: i64): i32 {
  let context = createContext();
  if (pointerIsNull(context.handle)) {
    return 1i32;
  }
  let module = createModule( & context, moduleName);
  if (pointerIsNull(module.handle)) {
    disposeContext( & mut context);
    return 1i32;
  }
  let functionType: * mut u8 = nullPointer<u8>();
  let functionValue: * mut u8 = nullPointer<u8>();
  let block: * mut u8 = nullPointer<u8>();
  let builder: * mut u8 = nullPointer<u8>();
  let constant: * mut u8 = nullPointer<u8>();
