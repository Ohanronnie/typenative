function collectDeclarations(source: Source, summary: ParseSummary): CompilerBuffer<usize> {
  let declarations = bufferWithCapacity<usize>(8usize, summary.declarationCount * 8usize + 8usize);
  const sourceHash = sourceIdentity(source);
