import { rawAlloc, rawFree } from "std/alloc";
import { byteAddress, storeRaw } from "./support";

declare extern "C" {
  function tn_bytes_copy(source: * const u8, length: usize, destination: * mut u8): usize;
}
@Drop export struct CompilerBuffer<T> {
  public pointer: * mut u8;
  public length: usize;
  public capacity: usize;
  public elementSize: usize;
  mut drop(): void {
    unsafe {
      rawFree(this.pointer);
    }
  }
}
function grow<T>(vector: & mut CompilerBuffer<T>, required: usize): void {
  if (required <= vector.capacity) {
    return;
  }
  let next = vector.capacity;
  if (next === 0usize) {
    next = 1usize;
  }
  while (next<required) {
    next = next * 2usize;
  }
  const replacement = rawAlloc(next * vector.elementSize);
  unsafe {
    tn_bytes_copy(vector.pointer as * const u8, vector.length * vector.elementSize, replacement);
    rawFree(vector.pointer);
  }
  vector.pointer = replacement;
  vector.capacity = next;
}
export function bufferWithCapacity<T>(elementSize: usize, capacity: usize): CompilerBuffer<T> {
  let actualCapacity = capacity;
  if (actualCapacity === 0usize) {
    actualCapacity = 1usize;
  }
  return {
    pointer: rawAlloc(actualCapacity * elementSize), length: 0usize, capacity: actualCapacity, elementSize: elementSize,
  };
}
export function bufferPushValue<T>(vector: & mut CompilerBuffer<T>, value: T): void {
  const required = vector.length + 1usize;
  grow<T>(vector, required);
  unsafe {
    const destination = byteAddress(vector.pointer as * const u8, vector.length * vector.elementSize);
    storeRaw<T>(destination as * mut T, value);
  }
  vector.length = vector.length + 1usize;
}
export function bufferValue<T>(vector: & CompilerBuffer<T>, index: usize): T {
  unsafe {
    const source = byteAddress(vector.pointer as * const u8, index * vector.elementSize);
    return *(source as * const T);
  }
}
export function bufferStoreValue<T>(vector: & mut CompilerBuffer<T>, index: usize, value: T): void {
  unsafe {
    const destination = byteAddress(vector.pointer as * const u8, index * vector.elementSize);
    storeRaw<T>(destination as * mut T, value);
  }
}
export function bufferPop<T>(vector: & mut CompilerBuffer<T >): bool {
  if (vector.length === 0usize) {
    return false;
  }
  vector.length = vector.length - 1usize;
  return true;
}
