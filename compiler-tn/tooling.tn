import { Source, byteAt } from "./lexer";
@derive(Copy)export struct ToolingResult {
  public diagnostics: usize;
  public documentVersion: usize;
  public lineCount: usize;
  public byteLength: usize;
}
export function document(source: Source, version: usize, diagnostics: usize): ToolingResult {
  let lineCount: usize = 1usize;
  let offset: usize = 0usize;
  while (offset<source.length) {
    if (byteAt(source, offset) === 10i32) {
      lineCount = lineCount + 1usize;
    }
    offset = offset + 1usize;
  }
  return {
    diagnostics: diagnostics, documentVersion: version, lineCount: lineCount, byteLength: source.length
  };
}
