@Copy export enum BackendResultKind {
  Unknown, Void, Value,
}
@Copy export struct BackendFunction {
  public nameStart: usize;
  public nameEnd: usize;
  public bodyStart: usize;
  public bodyEnd: usize;
  public parameterCount: usize;
  public resultStart: usize;
  public resultEnd: usize;
  public resultKind: usize;
  public statementCount: usize;
  public returnCount: usize;
  public callCount: usize;
  public loweringValid: usize;
  public instructionCount: usize;
}
export struct BackendProgram {
  public functions: CompilerBuffer<usize>;
  public functionData: * const u8;
  public functionCount: usize;
  public entryIndex: usize;
  public malformedFunctions: usize;
  public lowerableFunctions: usize;
  public instructionWords: usize;
}
function mutableUsizePointer(value: & mut usize): * mut u8 {
  unsafe {
    return value as * mut usize as * mut u8;
  }
}
function pushWord(words: & mut CompilerBuffer<usize>, value: usize): void {
  let writable = value;
  unsafe {
    bufferPush<usize>(words, mutableUsizePointer( & mut writable)as * const u8);
  }
}
function readWord(words: & CompilerBuffer<usize>, index: usize): usize {
  let value: usize = 0usize;
  unsafe {
    bufferGet<usize>(words, index, mutableUsizePointer( & mut value));
  }
  return value;
}
function functionPointer(functions: & CompilerBuffer<usize >): * const u8 {
  unsafe {
    return functions.pointer as * const u8;
  }
}
function byteAt(source: Source, offset: usize): i32 {
  unsafe {
    return sourceByte(source.pointer, source.length, offset);
  }
}
function isPunctuation(token: Token): bool {
  return switch(token.kind) {
    case TokenKind.Punctuation: true, default: false,
  };
}
function isIdentifier(token: Token): bool {
  return switch(token.kind) {
    case TokenKind.Identifier: true, default: false,
  };
}
function isByte(source: Source, token: Token, value: i32): bool {
  return isPunctuation(token) && byteAt(source, token.start) === value;
}
function emptyToken(source: Source): Token {
  return {
    kind: TokenKind.End, start: source.length, end: source.length,
  };
}
function matchingClose(source: Source, opening: Token): Token {
  const openingByte = byteAt(source, opening.start);
  let closingByte: i32 = 0i32;
  if (openingByte === 123i32) {
    closingByte = 125i32;
  } else if (openingByte === 40i32) {
    closingByte = 41i32;
  } else if (openingByte === 91i32) {
    closingByte = 93i32;
  } else {
    return emptyToken(source);
  }
  let depth: usize = 1usize;
  let cursor = opening.end;
  while (cursor<source.length) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    if (isByte(source, token, openingByte)) {
      depth = depth + 1usize;
    } else if (isByte(source, token, closingByte)) {
      depth = depth - 1usize;
      if (depth === 0usize) {
        return token;
      }
    }
    cursor = token.end;
  }
  return emptyToken(source);
}
function functionBody(source: Source, name: Token): Token {
  let cursor = name.end;
  while (cursor<source.length) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      return emptyToken(source);
    }
    if (isByte(source, token, 123i32)) {
      return token;
    }
    if (isByte(source, token, 59i32)) {
      return emptyToken(source);
    }
    cursor = token.end;
  }
  return emptyToken(source);
}
function classifyResultKind(source: Source, typeToken: Token): usize {
  if (isKeyword(source, typeToken, "void")) {
    return 1usize;
  }
  if (isIdentifier(typeToken)) {
    return 2usize;
  }
  return 0usize;
}
function functionHeader(source: Source, name: Token, body: Token, bodyEnd: usize): BackendFunction {
  let parameterCount: usize = 0usize;
  let resultStart: usize = 0usize;
  let resultEnd: usize = 0usize;
  let result: usize = 0usize;
  let cursor = name.end;
  let parameterDepth: usize = 0usize;
  let parametersSeen = false;
  while (cursor<body.start) {
    const token = next(source, cursor);
    if (isEnd(token) || token.start >= body.start) {
      break;
    }
    if (isByte(source, token, 40i32)) {
      parameterDepth = parameterDepth + 1usize;
      parametersSeen = true;
    } else if (isByte(source, token, 41i32) && parameterDepth > 0usize) {
      parameterDepth = parameterDepth - 1usize;
    } else if (parametersSeen && parameterDepth === 1usize && isByte(source, token, 58i32)) {
      parameterCount = parameterCount + 1usize;
    } else if (parametersSeen && parameterDepth === 0usize && isByte(source, token, 58i32)) {
      const typeToken = next(source, token.end);
      if (!isEnd(typeToken)) {
        resultStart = typeToken.start;
        resultEnd = typeToken.end;
        result = classifyResultKind(source, typeToken);
      }
      break;
    }
    cursor = token.end;
  }
  let statementCount: usize = 0usize;
  let returnCount: usize = 0usize;
  let callCount: usize = 0usize;
  cursor = body.end;
  let depth: usize = 1usize;
  while (cursor<bodyEnd && depth > 0usize) {
    const token = next(source, cursor);
    if (isEnd(token)) {
      break;
    }
    const byte = firstByte(source, token);
    if (byte === 123i32) {
      depth = depth + 1usize;
    } else if (byte === 125i32 && depth > 0usize) {
      depth = depth - 1usize;
    } else if (depth > 0usize && isByte(source, token, 59i32)) {
      statementCount = statementCount + 1usize;
    } else if (depth > 0usize && isKeyword(source, token, "return")) {
      returnCount = returnCount + 1usize;
    } else if (depth > 0usize && isIdentifier(token)) {
      const following = next(source, token.end);
      if (isByte(source, following, 40i32)) {
        callCount = callCount + 1usize;
      }
    }
    cursor = token.end;
  }
  const valid = bodyEnd > body.start && bodyEnd <= source.length && name.end > name.start?1usize: 0usize;
  return {
    nameStart: name.start, nameEnd: name.end, bodyStart: body.start, bodyEnd: bodyEnd, parameterCount: parameterCount, resultStart: resultStart, resultEnd: resultEnd, resultKind: result, statementCount: statementCount, returnCount: returnCount, callCount: callCount, loweringValid: valid, instructionCount: statementCount + returnCount + callCount + 1usize,
  };
}
function appendFunction(functions: & mut CompilerBuffer<usize>, candidate: BackendFunction): void {
  pushWord(functions, candidate.nameStart);
  pushWord(functions, candidate.nameEnd);
  pushWord(functions, candidate.bodyStart);
  pushWord(functions, candidate.bodyEnd);
  pushWord(functions, candidate.parameterCount);
  pushWord(functions, candidate.resultStart);
  pushWord(functions, candidate.resultEnd);
  pushWord(functions, candidate.resultKind);
  pushWord(functions, candidate.statementCount);
  pushWord(functions, candidate.returnCount);
  pushWord(functions, candidate.callCount);
  pushWord(functions, candidate.loweringValid);
  pushWord(functions, candidate.instructionCount);
  pushWord(functions, candidate.instructionCount);
}
export function backendFunction(program: & BackendProgram, index: usize): BackendFunction {
  const base = index * 14usize;
  return {
    nameStart: readWord(program.functions, base), nameEnd: readWord(program.functions, base + 1usize), bodyStart: readWord(program.functions, base + 2usize), bodyEnd: readWord(program.functions, base + 3usize), parameterCount: readWord(program.functions, base + 4usize), resultStart: readWord(program.functions, base + 5usize), resultEnd: readWord(program.functions, base + 6usize), resultKind: readWord(program.functions, base + 7usize), statementCount: readWord(program.functions, base + 8usize), returnCount: readWord(program.functions, base + 9usize), callCount: readWord(program.functions, base + 10usize), loweringValid: readWord(program.functions, base + 11usize), instructionCount: readWord(program.functions, base + 12usize),
  };
}
export function validateBackend(functions: & CompilerBuffer<usize>, functionCount: usize, entryIndex: usize, malformedFunctions: usize, sourceLength: usize): bool {
  if (functionCount * 14usize > functions.length) {
    return false;
  }
  if (entryIndex !== sourceLength && entryIndex >= functionCount) {
    return false;
  }
  let index: usize = 0usize;
  while (index<functionCount) {
    const base = index * 14usize;
    const nameStart = readWord(functions, base);
    const nameEnd = readWord(functions, base + 1usize);
    const bodyStart = readWord(functions, base + 2usize);
    const bodyEnd = readWord(functions, base + 3usize);
    const resultKind = readWord(functions, base + 7usize);
    const loweringValid = readWord(functions, base + 11usize);
    const instructionCount = readWord(functions, base + 12usize);
    if (nameStart >= nameEnd || nameEnd > sourceLength || bodyStart >= bodyEnd || bodyEnd > sourceLength || resultKind > 2usize || loweringValid > 1usize || instructionCount === 0usize) {
      return false;
    }
    index = index + 1usize;
  }
  return malformedFunctions === 0usize;
}
export function lowerBackend(source: Source, hir: & HirProgram): BackendProgram {
  let functions = bufferWithCapacity<usize>(8usize, hir.functionCount * 14usize + 8usize);
  let functionCount: usize = 0usize;
  let entryIndex = source.length;
  let malformedFunctions: usize = 0usize;
  let lowerableFunctions: usize = 0usize;
  let instructionWords: usize = 0usize;
  let index: usize = 0usize;
  while (index<hir.declarationCount) {
    const base = index * 8usize;
    const kind = readWord(hir.declarations, base);
    if (kind === 1usize) {
      const nameStart = readWord(hir.declarations, base + 3usize);
      const nameEnd = readWord(hir.declarations, base + 4usize);
      const bodyStart = readWord(hir.declarations, base + 5usize);
      const bodyEnd = readWord(hir.declarations, base + 6usize);
      const name: Token = {
        kind: TokenKind.Identifier, start: nameStart, end: nameEnd,
      };
      if (bodyStart === 0usize || bodyEnd <= bodyStart || bodyEnd > source.length) {
        malformedFunctions = malformedFunctions + 1usize;
      } else {
        const body: Token = {
          kind: TokenKind.Punctuation, start: bodyStart, end: bodyStart + 1usize,
        };
        const candidate = functionHeader(source, name, body, bodyEnd);
        appendFunction( & mut functions, candidate);
        if (candidate.loweringValid !== 0usize) {
          lowerableFunctions = lowerableFunctions + 1usize;
        }
        instructionWords = instructionWords + candidate.instructionCount;
        if (candidate.nameEnd - candidate.nameStart === 4usize && byteAt(source, candidate.nameStart) === 109i32 && byteAt(source, candidate.nameStart + 1usize) === 97i32 && byteAt(source, candidate.nameStart + 2usize) === 105i32 && byteAt(source, candidate.nameStart + 3usize) === 110i32) {
          entryIndex = functionCount;
        }
        functionCount = functionCount + 1usize;
      }
    }
    index = index + 1usize;
  }
  return {
    functions: functions, functionData: functionPointer( & functions), functionCount: functionCount, entryIndex: entryIndex, malformedFunctions: malformedFunctions, lowerableFunctions: lowerableFunctions, instructionWords: instructionWords,
  };
}
