export function emitDirectNodeAddon(project: & DirectProject, context: * mut u8, module: * mut u8): bool {
  if (!nodeEmitClassCallbacks(project, context, module)) {
    return false;
  }
  let index: usize = 0usize;
  while (index<project.functions.length) {
    if (!nodeEmitFunctionCallback(project, context, module, directFunctionAt(project, index), index)) {
      return false;
    }
    index = index + 1usize;
  }
  return nodeEmitModuleInit(project, context, module);
}
function nodeAppendTypeScriptKind(output: & mut BytesMut, source: Source, start: usize, end: usize, result: bool): void {
  const kind = nodeTypeKind(source, start, end);
  if (kind === 9i32) {
    const innerEnd = nodeOptionalInnerEnd(source, start, end);
    nodeAppendTypeScriptKind(output, source, start, innerEnd, result);
    output.appendAscii(" | undefined");
    return;
  }
  if (kind === 0i32) {
    output.appendAscii("void");
  } else if (kind === 1i32 || kind === 4i32) {
    output.appendAscii("number");
  } else if (kind === 2i32) {
    output.appendAscii("bigint");
  } else if (kind === 3i32) {
    output.appendAscii("boolean");
  } else if (kind === 5i32) {
    output.appendAscii("string");
  } else if (kind === 6i32) {
    output.appendAscii("Uint8Array");
  } else if (kind === 7i32 || kind === 8i32) {
    output.appendAscii("Array<unknown>");
  } else if (result) {
    output.appendAscii("unknown");
  } else {
    output.appendAscii("unknown");
  }
}
function nodeAppendName(output: & mut BytesMut, name: & BytesMut): void {
  let index: usize = 0usize;
  while (index + 1usize < name.length) {
    output.push(directByteValue(sourceByte(nodeConstBuffer(name), name.length, index)));
    index = index + 1usize;
  }
}
function nodeClassExported(source: Source, nameStart: usize): bool {
  let offset: usize = 0usize;
  let exported = false;
  while (offset<nameStart) {
    const token = next(source, offset);
    if (isEnd(token) || token.start >= nameStart) {
      break;
    }
    if (isPunctuation(source, token, 64i32)) {
      const annotation = next(source, token.end);
      exported = nameMatches(source, annotation, "Export");
    } else if (isKeyword(source, token, "class")) {
      return exported;
    } else if (isKeyword(source, token, "struct") || isKeyword(source, token, "function")) {
      exported = false;
    }
    offset = token.end;
  }
  return false;
}
function nodeMethodIsPublic(source: Source, functionValue: DirectFunction): bool {
  const previous = nodePreviousToken(source, functionValue.keywordStart);
  return isKeyword(source, previous, "public");
}
function nodePromiseInnerBounds(source: Source, start: usize, end: usize): DirectBounds {
  const promise = next(source, start);
  if (!nameMatches(source, promise, "Promise")) {
    return {
      start: start, end: end,
    };
  }
  const opening = next(source, promise.end);
  if (!isPunctuation(source, opening, 60i32)) {
    return {
      start: start, end: end,
    };
  }
  const inner = next(source, opening.end);
  return {
    start: inner.start, end: skipDirectType(source, opening.end),
  };
}
function nodeAppendFunctionDeclaration(output: & mut BytesMut, project: & DirectProject, functionValue: DirectFunction): void {
  const source = sourceValue(directSourceAt(project, functionValue.sourceIndex));
  const name = nodeNameBuffer(project, functionValue, true);
  output.appendAscii("export function ");
  nodeAppendName(output, & name);
  output.push(40u8);
  let cursor = next(source, functionValue.parameterOpeningStart + 1usize);
  let index: usize = 0usize;
  while (!isEnd(cursor) && cursor.start<functionValue.parameterClosingStart) {
    if (isIdentifier(cursor) && !isKeyword(source, cursor, "mut") && !isKeyword(source, cursor, "const")) {
      const colon = next(source, cursor.end);
      if (isPunctuation(source, colon, 58i32)) {
        if (index > 0usize) {
          output.appendAscii(", ");
        }
        output.appendAscii("arg");
        output.appendUnsignedDecimal(index);
        output.appendAscii(": ");
        const typeToken = next(source, colon.end);
        const typeEnd = skipDirectType(source, colon.end);
        nodeAppendTypeScriptKind(output, source, typeToken.start, typeEnd, false);
        index = index + 1usize;
        cursor = next(source, typeEnd);
        continue;
      }
    }
    cursor = next(source, cursor.end);
  }
  output.appendAscii("): ");
  if (directFunctionIsAsync(project, functionValue)) {
    const promise = nodePromiseInnerBounds(source, functionValue.resultStart, functionValue.resultEnd);
    output.appendAscii("Promise<");
    nodeAppendTypeScriptKind(output, source, promise.start, promise.end, true);
    output.appendAscii(">");
  } else {
    nodeAppendTypeScriptKind(output, source, functionValue.resultStart, functionValue.resultEnd, true);
