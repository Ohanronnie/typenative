function nodeEmitModuleInit(project: & DirectProject, context: * mut u8, module: * mut u8): bool {
  const types = nodeTypeArray(2usize);
  nodePointerStore(types, 0usize, llvmPointerType(context));
  nodePointerStore(types, 1usize, llvmPointerType(context));
