      unsafe {
        callbackFunction = llvmGetNamedFunction(module, nodeConstBuffer( & callback));
      }
      if (directPointerMissing(callbackFunction)) {
        llvmDisposeBuilder(builder);
        return false;
      }
      const nameBuffer = nodeNameBuffer(project, functionValue, true);
      const nameValue = llvmGlobalString(builder, nodeConstBuffer( & nameBuffer), directEmptyName());
      const resultStorage = llvmAlloca(builder, llvmPointerType(context), directEmptyName());
      let createArguments = nodeArguments(6usize);
      nodePointerStore(createArguments, 0usize, env);
      nodePointerStore(createArguments, 1usize, nameValue);
      nodePointerStore(createArguments, 2usize, llvmConstInt(llvmInt64Type(context), - 1i64, false));
      nodePointerStore(createArguments, 3usize, callbackFunction);
      nodePointerStore(createArguments, 4usize, llvmConstNull(llvmPointerType(context)));
      nodePointerStore(createArguments, 5usize, resultStorage);
      const createTypes = nodeTypeArray(6usize);
      nodePointerStore(createTypes, 0usize, llvmPointerType(context));
      nodePointerStore(createTypes, 1usize, llvmPointerType(context));
      nodePointerStore(createTypes, 2usize, llvmInt64Type(context));
      nodePointerStore(createTypes, 3usize, llvmPointerType(context));
      nodePointerStore(createTypes, 4usize, llvmPointerType(context));
      nodePointerStore(createTypes, 5usize, llvmPointerType(context));
