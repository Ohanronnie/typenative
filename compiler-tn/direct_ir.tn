export function writeDirectNodeDeclarations(project: & DirectProject, output: * const u8): i32 {
  let declarations = new BytesMut({
    capacity: 4096usize,
  });
  declarations.appendAscii("// Generated from the direct TypeNative export model.\n\n");
  let index: usize = 0usize;
  while (index<project.functions.length) {
    const functionValue = directFunctionAt(project, index);
    const bounds = nodeExportBounds(project, functionValue);
    if (!functionValue.method && !functionValue.external && bounds.start<bounds.end) {
      nodeAppendFunctionDeclaration( & mut declarations, project, functionValue);
    }
    index = index + 1usize;
  }
  let structureIndex: usize = 0usize;
  while (structureIndex<project.structs.length) {
    const structure = directStructAt(project, structureIndex);
    const source = sourceValue(directSourceAt(project, structure.sourceIndex));
    if (nodeClassExported(source, structure.nameStart)) {
      declarations.appendAscii("export class ");
      let nameIndex: usize = structure.nameStart;
      while (nameIndex<structure.nameEnd) {
        declarations.push(directByteValue(directByte(source, nameIndex)));
        nameIndex = nameIndex + 1usize;
      }
      declarations.appendAscii(" {\n");
      let methodIndex: usize = 0usize;
      while (methodIndex<project.functions.length) {
        const method = directFunctionAt(project, methodIndex);
        if (method.method && method.ownerIndex === structureIndex && method.sourceIndex === structure.sourceIndex && nodeMethodIsPublic(source, method)) {
          const methodName = next(source, method.nameStart);
          if (nameMatches(source, methodName, "constructor")) {
            declarations.appendAscii("  constructor(");
          } else {
            declarations.appendAscii("  ");
            let methodNameIndex: usize = method.nameStart;
            while (methodNameIndex<method.nameEnd) {
              declarations.push(directByteValue(directByte(source, methodNameIndex)));
              methodNameIndex = methodNameIndex + 1usize;
            }
            declarations.push(40u8);
          }
          let parameter = next(source, method.parameterOpeningStart + 1usize);
          let parameterIndex: usize = 0usize;
          while (!isEnd(parameter) && parameter.start<method.parameterClosingStart) {
            if (isIdentifier(parameter) && !isKeyword(source, parameter, "mut") && !isKeyword(source, parameter, "const")) {
              const colon = next(source, parameter.end);
              if (isPunctuation(source, colon, 58i32)) {
                if (parameterIndex > 0usize) {
                  declarations.appendAscii(", ");
                }
                declarations.appendAscii("arg");
                declarations.appendUnsignedDecimal(parameterIndex);
                declarations.appendAscii(": ");
                const typeToken = next(source, colon.end);
                const typeEnd = skipDirectType(source, colon.end);
                nodeAppendTypeScriptKind( & mut declarations, source, typeToken.start, typeEnd, false);
                parameterIndex = parameterIndex + 1usize;
                parameter = next(source, typeEnd);
                continue;
              }
            }
            parameter = next(source, parameter.end);
          }
          declarations.appendAscii("): ");
          nodeAppendTypeScriptKind( & mut declarations, source, method.resultStart, method.resultEnd, true);
          declarations.appendAscii(";\n");
        }
        methodIndex = methodIndex + 1usize;
      }
      declarations.appendAscii("}\n\n");
    }
    structureIndex = structureIndex + 1usize;
  }
  let outputLength: usize = 0usize;
  unsafe {
    outputLength = strlen(output);
  }
  let path = new BytesMut({
    capacity: outputLength + 8usize,
  });
  let pathIndex: usize = 0usize;
  const nodeSuffix = outputLength >= 5usize && sourceByte(output, outputLength, outputLength - 5usize) === 46i32 && sourceByte(output, outputLength, outputLength - 4usize) === 110i32 && sourceByte(output, outputLength, outputLength - 3usize) === 111i32 && sourceByte(output, outputLength, outputLength - 2usize) === 100i32 && sourceByte(output, outputLength, outputLength - 1usize) === 101i32;
  const pathLengthValue = nodeSuffix?outputLength - 5usize: outputLength;
  while (pathIndex<pathLengthValue) {
    path.push(directByteValue(sourceByte(output, outputLength, pathIndex)));
    pathIndex = pathIndex + 1usize;
  }
  path.appendAscii(".d.ts");
  let result: i32 = 1i32;
  unsafe {
    result = writeFile(nodeConstBuffer( & path), nodeConstBuffer( & declarations), declarations.length);
  }
  return result === 0i32?0i32: 1i32;
}
