  if (directPointerMissing(init)) {
    return false;
  }
  const block = llvmAppendBlock(context, init, directEmptyName());
  const builder = llvmCreateBuilder(context);
  if (directPointerMissing(block) || directPointerMissing(builder)) {
    if (!directPointerMissing(builder)) {
      llvmDisposeBuilder(builder);
    }
    return false;
  }
  llvmPosition(builder, block);
  const env = llvmGetParam(init, 0u32);
  const exports = llvmGetParam(init, 1u32);
  let index: usize = 0usize;
  let exposed: usize = 0usize;
  while (index<project.functions.length) {
    const functionValue = directFunctionAt(project, index);
    const bounds = nodeExportBounds(project, functionValue);
    if (!functionValue.method && !functionValue.external && bounds.start<bounds.end) {
      const callback = nodeCallbackName(index);
