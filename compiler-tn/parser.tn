  let declarationCount: usize = 0usize;
  let depth: usize = 0usize;
  let maxDepth: usize = 0usize;
  let expected: u64 = 0u64;
  let hasPrevious = false;
  let previous: Token = {
    kind: TokenKind.End, start: 0usize, end: 0usize
  };
  let typeAlias = false;
  let throwsClause = false;
  let optionalBarPending = false;
  let angleDepth: usize = 0usize;
  let angleLastIdentifier = false;
