import { Lexer, Source, Token, TokenKind, byteAt, firstByte, isInvalid, isKeyword, isNumberValid, isTemplateInvalid, lexer, next, numericErrorStart } from "./lexer";
export struct Parser {
  public source: Source;
  public offset: usize;
}
export function parser(lexer: Lexer): Parser {
