function endsGenericContext(byte: i32): bool {
  return byte === 33i32 || byte === 37i32 || byte === 38i32 || byte === 40i32 || byte === 41i32 || byte === 42i32 || byte === 43i32 || byte === 45i32 || byte === 47i32 || byte === 58i32 || byte === 59i32 || byte === 61i32 || byte === 63i32 || byte === 91i32 || byte === 93i32 || byte === 123i32 || byte === 124i32 || byte === 125i32;
