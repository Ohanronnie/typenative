      } else {
        expected = expected / 4u64;
        depth = depth - 1usize;
      }
    }
    tokenCount = tokenCount + 1usize;
    previous = token;
    hasPrevious = true;
    state.offset = token.end;
  }
  if (depth > 0usize) {
    recordError( & mut errors, 1013i32, source.length, source.length);
  }
  return {
    tokenCount: tokenCount, errorCount: errors.count, declarationCount: declarationCount, maxDelimiterDepth: maxDepth, firstErrorCode: errors.firstCode, firstErrorStart: errors.firstStart, firstErrorEnd: errors.firstEnd
  };
