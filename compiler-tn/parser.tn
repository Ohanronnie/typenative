@derive(Copy)struct ErrorState {
  public count: usize;
  public firstCode: i32;
  public firstStart: usize;
  public firstEnd: usize;
}
function recordError(state: & mut ErrorState, code: i32, start: usize, end: usize): void {
  state.count = state.count + 1usize;
  if (state.firstCode === 0i32) {
    state.firstCode = code;
    state.firstStart = start;
    state.firstEnd = end;
  }
}
function isOpen(byte: i32): bool {
  return byte === 40i32 || byte === 91i32 || byte === 123i32;
}
function isClose(byte: i32): bool {
  return byte === 41i32 || byte === 93i32 || byte === 125i32;
}
function isDeclaration(source: Source, token: Token): bool {
  return isKeyword(source, token, "function") || isKeyword(source, token, "struct") || isKeyword(source, token, "enum") || isKeyword(source, token, "class") || isKeyword(source, token, "interface") || isKeyword(source, token, "impl") || isKeyword(source, token, "type") || isKeyword(source, token, "const") || isKeyword(source, token, "static") || isKeyword(source, token, "extern");
}
function isIdentifierToken(token: Token): bool {
  match (token.kind) {
    case TokenKind.Identifier: {
      return true;
    }
    case TokenKind.Number: {
      return false;
    }
    case TokenKind.String: {
      return false;
    }
    case TokenKind.Punctuation: {
      return false;
    }
    case TokenKind.Invalid: {
      return false;
    }
    case TokenKind.End: {
      return false;
    }
  };
  return false;
}
function isWordByte(value: i32): bool {
  return(value >= 65i32 && value <= 90i32) ||(value >= 97i32 && value <= 122i32) ||(value >= 48i32 && value <= 57i32) || value === 95i32 || value >= 128i32;
}
function tokenEndsWithWord(source: Source, token: Token): bool {
  return token.end > token.start && isWordByte(byteAt(source, token.end - 1usize));
}
function isLooseEquality(source: Source, token: Token): bool {
  const byte = firstByte(source, token);
  if (byte === 33i32 && token.end<source.length && byteAt(source, token.end) === 61i32) {
    return token.end + 1usize >= source.length || byteAt(source, token.end + 1usize) !== 61i32;
  }
  if (byte !== 61i32 || token.end >= source.length || byteAt(source, token.end) !== 61i32) {
    return false;
  }
  if (token.end + 1usize < source.length && byteAt(source, token.end + 1usize) === 61i32) {
    return false;
  }
  if (token.start >= 1usize && byteAt(source, token.start - 1usize) === 33i32) {
    return false;
  }
  if (token.start >= 1usize && byteAt(source, token.start - 1usize) === 61i32 && token.end<source.length && byteAt(source, token.end) === 61i32) {
    return false;
  }
  if (token.start >= 2usize && byteAt(source, token.start - 1usize) === 61i32 && byteAt(source, token.start - 2usize) === 33i32) {
