    if (isEnd(token)) {
      break;
    }
    if (token.end <= state.offset) {
      recordError( & mut errors, 1010i32, token.start, token.end);
      break;
    }
    if (isInvalid(token) || isTemplateInvalid(source, token)) {
      recordError( & mut errors, 1001i32, token.start, token.end);
    }
    const tokenByte = firstByte(source, token);
    if (tokenByte >= 48i32 && tokenByte <= 57i32 && isNumberValid(source, token) === 0i32) {
      recordError( & mut errors, 1015i32, numericErrorStart(source, token), token.end);
    }
    if (isKeyword(source, token, "null")) {
      recordError( & mut errors, 1002i32, token.start, token.end);
    }
    if (optionalBarPending) {
      if (!isKeyword(source, token, "undefined")) {
        recordError( & mut errors, 1003i32, token.start, token.end);
      }
      optionalBarPending = false;
    }
    if (isLooseEquality(source, token)) {
      recordError( & mut errors, 1004i32, token.start, token.end);
    }
    if (firstByte(source, token) === 33i32 && !isLooseEquality(source, token) && token.end <= source.length &&(token.end >= source.length || byteAt(source, token.end) !== 61i32) && hasPrevious && !isKeyword(source, previous, "return") && !isKeyword(source, previous, "throw") && !isKeyword(source, previous, "try") &&(isIdentifierToken(previous) || tokenEndsWithWord(source, previous) || firstByte(source, previous) === 41i32 || firstByte(source, previous) === 93i32 || firstByte(source, previous) === 125i32)) {
      recordError( & mut errors, 1005i32, token.start, token.end);
    }
    if (firstByte(source, token) === 46i32 && token.start + 2usize < source.length && byteAt(source, token.start + 1usize) === 46i32 && byteAt(source, token.start + 2usize) === 46i32 && depth > 0usize && expected % 4u64 === 3u64) {
      recordError( & mut errors, 1006i32, token.start, token.end);
    }
    if (typeAlias && firstByte(source, token) === 124i32 && !throwsClause) {
      optionalBarPending = true;
    }
    if (typeAlias && firstByte(source, token) === 38i32 && !throwsClause && hasPrevious && firstByte(source, previous) !== 61i32 && firstByte(source, previous) !== 40i32 && firstByte(source, previous) !== 44i32 && firstByte(source, previous) !== 60i32) {
      recordError( & mut errors, 1007i32, token.start, token.end);
    }
    if (hasPrevious && isKeyword(source, previous, "function") && isKeyword(source, token, "return")) {
      recordError( & mut errors, 1008i32, previous.start, token.end);
    }
    if (isKeyword(source, token, "type")) {
      typeAlias = true;
      throwsClause = false;
    } else if (typeAlias && isKeyword(source, token, "throws")) {
      throwsClause = true;
    }
    if (typeAlias && firstByte(source, token) === 59i32) {
      typeAlias = false;
      throwsClause = false;
      optionalBarPending = false;
    }
    const syntaxByte = firstByte(source, token);
    if (angleDepth > 0usize && endsGenericContext(syntaxByte)) {
      angleDepth = 0usize;
      angleLastIdentifier = false;
    }
    if (syntaxByte === 60i32) {
      angleDepth = angleDepth + 1usize;
      angleLastIdentifier = false;
    } else if (syntaxByte === 62i32) {
      if (angleDepth > 0usize) {
        angleDepth = angleDepth - 1usize;
      }
      angleLastIdentifier = false;
    } else if (tokenEndsWithWord(source, token)) {
      if (angleDepth > 0usize) {
        const lifetimeParameter = hasPrevious &&(isKeyword(source, previous, "lifetime") || isKeyword(source, previous, "throws"));
        if (angleLastIdentifier && !lifetimeParameter) {
          recordError( & mut errors, 1009i32, previous.start, token.end);
        }
        angleLastIdentifier = true;
      }
    } else if (syntaxByte === 44i32 || syntaxByte === 46i32) {
      angleLastIdentifier = false;
    } else if (syntaxByte !== 60i32 && syntaxByte !== 62i32) {
      angleLastIdentifier = false;
    }
    if (isDeclaration(source, token)) {
      declarationCount = declarationCount + 1usize;
    }
    const byte = firstByte(source, token);
    if (isOpen(byte)) {
      if (depth >= 32usize) {
        recordError( & mut errors, 1011i32, token.start, token.end);
      } else {
        let marker: u64 = 3u64;
        if (byte === 40i32) {
          marker = 1u64;
        } else if (byte === 91i32) {
          marker = 2u64;
        }
        expected = expected * 4u64 + marker;
        depth = depth + 1usize;
        if (depth > maxDepth) {
          maxDepth = depth;
        }
      }
    } else if (isClose(byte)) {
      let marker: u64 = 3u64;
      if (byte === 41i32) {
        marker = 1u64;
      } else if (byte === 93i32) {
        marker = 2u64;
      }
      if (depth === 0usize || expected % 4u64 !== marker) {
