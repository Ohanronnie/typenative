extern struct Pair {
  public left: i32;
  public right: i32;
}
enum Kind: u8 {
  Zero, Answer = 42,
}
export extern "C" function add(left: i32, right: i32): i32 {
  return left + right;
}
export function pairValue(pair: Pair): i32 {
  return pair.left + pair.right;
}
export function kindValue(kind: Kind): i32 {
  return switch(kind) {
    case Kind.Zero: 0, case Kind.Answer: 42,
  };
}
