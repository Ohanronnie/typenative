extern struct Pair {
  left: i32;
  right: i32;
}
enum Kind: u8 {
  Zero, Answer = 42,
}
declare extern "C" {
  function add(left: i32, right: i32): i32;
  function pairValue(pair: Pair): i32;
  function kindValue(kind: Kind): i32;
}
function main(): i32 {
  unsafe {
    const pair: Pair = {
      left: 19, right: 23,
    };
    if (add(19, 23) !== 42 || pairValue(pair) !== 42 || kindValue(Kind.Answer) !== 42) {
      return 1;
    }
    return 0;
  }
}
