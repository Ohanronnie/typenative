export struct Element {
  public code: i32;
}
export function jsx<P, E, K>(component: (P) => E, properties: P, key: K): E {
  return component(properties);
}
export function jsxs<P, E, K>(component: (P) => E, properties: P, key: K): E {
  return component(properties);
}
export function fragment<C>(children: C): Element {
  return new Element({
    code: 0
  });
}
