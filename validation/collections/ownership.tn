import { AllocError } from "std/alloc";
import { Map } from "std/collections";

declare extern "C" {
  function tn_runtime_reset_allocation_count(): void;
  function tn_runtime_free_count(): u64;
}
function main(): i32 {
  unsafe {
    tn_runtime_reset_allocation_count();
  }
  {
    let map = new Map<string, string>({
      capacity: 8,
    });
    map.set(String("key"), String("first")).set(String("key"), String("second"));
    const query: string = "key";
    const stored = map.get( &query);
    if (stored === undefined || stored! !== "second") {
      return 1;
    }
  }
  unsafe {
    if (tn_runtime_free_count() !== 12) {
      return 3;
    }
    tn_runtime_reset_allocation_count();
  }
  {
    let map = new Map<string, string>({
      capacity: 8,
    });
    map.set(String("key"), String("value"));
    const query: string = "key";
    const removed = map.delete( &query);
    if (removed === undefined || map.length !== 0) {
      return 4;
    }
    if (removed! !== "value") {
      return 5;
    }
  }
  unsafe {
    if (tn_runtime_free_count() !== 10) {
      return 6;
    }
    tn_runtime_reset_allocation_count();
  }
  {
    let map = new Map<string, string>({
      capacity: 8,
    });
    map.set(String("one"), String("1"));
    map.set(String("two"), String("2"));
    map.clear();
    if (map.length !== 0) {
      return 7;
    }
  }
  unsafe {
    if (tn_runtime_free_count() !== 11) {
      return 8;
    }
    tn_runtime_reset_allocation_count();
  }
  {
    let map = new Map<string, string>({
      capacity: 8,
    });
    try {
      try map.reserve(64);
    } catch (error: AllocError) {
      return 9;
    }
    map.set(String("one"), String("1"));
    map.set(String("two"), String("2"));
    try {
      try map.shrinkToFit();
    } catch (error: AllocError) {
      return 10;
    }
    if (map.capacity !== 8) {
      return 11;
    }
  }
  unsafe {
    if (tn_runtime_free_count() !== 21) {
      return 12;
    }
    tn_runtime_reset_allocation_count();
  }
  {
    let map = new Map<string, string>({
      capacity: 8,
    });
    map.set(String("one"), String("1"));
    map.set(String("two"), String("2"));
    map.set(String("three"), String("3"));
    let seen: i32 = 0;
    for (const entry of move map) {
      seen = seen + 1;
      if (seen === 1) {
        break;
      }
    }
    if (seen !== 1) {
      return 13;
    }
  }
  unsafe {
    if (tn_runtime_free_count() !== 14) {
      return 14;
    }
  }
  return 42;
}
