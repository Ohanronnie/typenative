      const outputRef = & mut orderedMapOutput;
      if (!orderedMapContains<i32, i32>( & ordered, keyRef as * const i32) || !orderedMapGet<i32, i32>( & ordered, keyRef as * const i32, outputRef as * mut i32)) {
        return 20i32;
