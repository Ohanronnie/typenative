import { AllocError } from "std/alloc";
import { Array, Deque, Map, OrderedMap, OrderedSet, Queue, Set, heapAllocate, heapPop, heapPush } from "std/collections";

function main(): i32 {
  let key: i32 = 16i32;
  let value: i32 = 42i32;
  let canonicalMapOutput: i32 = 0i32;
  let orderedMapOutput: i32 = 0i32;
  let canonicalArrayOutput: i32 = 0i32;
  let sliceOutput: i32 = 0i32;
  let canonicalArrayPopOutput: i32 = 0i32;
  let canonicalQueuePopOutput: i32 = 0i32;
  let canonicalQueueSecondOutput: i32 = 0i32;
  let canonicalQueueThirdOutput: i32 = 0i32;
  let canonicalDequePopOutput: i32 = 0i32;
  let canonicalDequeBackOutput: i32 = 0i32;
  let canonicalHeapPopOutput: i32 = 0i32;
  let canonicalHeapSecondOutput: i32 = 0i32;
  let legacyMapOutput: i32 = 0i32;
  let array = new Array<i32>({
    capacity: 4usize,
  });
  let queue = new Queue<i32>({
    capacity: 2usize,
  });
  let textQueue = new Queue<string>({
    capacity: 1usize,
  });
  let deque = new Deque<i32>({
    capacity: 2usize,
  });
  let textDeque = new Deque<string>({
    capacity: 1usize,
  });
  let heap = heapAllocate<i32>(4usize, 2usize);
  let canonical = new Map<i32, i32>({
    capacity: 4usize,
  });
  let canonicalSetValue = new Set<i32>({
    capacity: 4usize,
  });
  let textSet = new Set<string>({
    capacity: 4usize,
  });
  let ordered = new OrderedMap<i32, i32>({
    capacity: 4usize,
  });
  let orderedValues = new OrderedSet<i32>({
    capacity: 4usize,
  });
  let map = new Map<i32, i32>({
    capacity: 4usize,
  });
  unsafe {
    array.push(value);
    queue.push(value);
    queue.push(key);
    deque.push(value);
    deque.pushFront(key);
    {
      const valueRef = & value;
      heapPush<i32>( & mut heap, valueRef as * const u8);
    }
    {
      const keyRef = & key;
      heapPush<i32>( & mut heap, keyRef as * const u8);
    }
    try {
      try canonical.reserve(64usize);
    } catch (error: AllocError) {
      return 49i32;
    }
    if (canonical.capacity<64usize) {
      return 50i32;
    }
    canonical.set(key, value);
    ordered.set(key, value);
    orderedValues.insert(key);
    try {
      try canonicalSetValue.reserve(64usize);
    } catch (error: AllocError) {
      return 45i32;
    }
    if (canonicalSetValue.capacity<64usize) {
      return 46i32;
    }
    canonicalSetValue.insert(key);
    if (!canonicalSetValue.contains( & key)) {
      return 3i32;
    }
    textSet.insert("key");
    {
      const textKey: string = "key";
      if (!textSet.contains( & textKey)) {
        return 44i32;
      }
    }
    {
      const output = canonical.get( & key);
      if (output === undefined) {
        return 4i32;
      }
      canonicalMapOutput = output!;
    }
    {
      const output = array.get(0usize);
      if (output === undefined) {
        return 5i32;
      }
      canonicalArrayOutput = output!;
    }
    {
      const slice = array.slice();
      if (slice.length !== 1usize) {
        return 18i32;
      }
      const output = slice.get(0usize);
      if (output === undefined) {
        return 19i32;
      }
      sliceOutput = output!;
    }
    {
      const output = array.pop();
      if (output === undefined) {
        return 6i32;
      }
      canonicalArrayPopOutput = output!;
    }
    {
      const output = queue.pop();
      if (output === undefined) {
        return 7i32;
      }
      canonicalQueuePopOutput = output!;
    }
    queue.push(7i32);
    queue.reserve(6usize);
    if (queue.capacity<6usize || queue.length !== 2usize) {
      return 22i32;
    }
    {
      const output = queue.pop();
      if (output === undefined) {
        return 12i32;
      }
      canonicalQueueSecondOutput = output!;
    }
    {
      const output = queue.pop();
      if (output === undefined) {
        return 23i32;
      }
      canonicalQueueThirdOutput = output!;
    }
    queue.shrinkToFit();
    if (queue.capacity !== 0usize || queue.length !== 0usize) {
      return 24i32;
    }
    textQueue.push("a");
    textQueue.push("b");
    {
      const output = textQueue.pop();
      if (output === undefined) {
        return 25i32;
      }
      const bytes = output!.bytes();
      if (bytes[0usize] !== 97u8) {
        return 26i32;
      }
    }
    textQueue.clear();
    if (textQueue.length !== 0usize) {
      return 27i32;
    }
    {
      const output = deque.pop();
      if (output === undefined) {
        return 8i32;
      }
      canonicalDequePopOutput = output!;
    }
    {
      const output = deque.popBack();
      if (output === undefined) {
        return 9i32;
      }
      canonicalDequeBackOutput = output!;
    }
    deque.shrinkToFit();
    if (deque.capacity !== 0usize || deque.length !== 0usize) {
      return 28i32;
    }
    textDeque.push("b");
    textDeque.pushFront("a");
    {
      const output = textDeque.popBack();
      if (output === undefined) {
        return 29i32;
      }
      const bytes = output!.bytes();
      if (bytes[0usize] !== 98u8) {
        return 30i32;
      }
    }
    textDeque.clear();
    {
      const outputRef = & mut canonicalHeapPopOutput;
      if (!heapPop<i32>( & mut heap, outputRef as * mut u8)) {
        return 13i32;
      }
    }
    {
      const outputRef = & mut canonicalHeapSecondOutput;
      if (!heapPop<i32>( & mut heap, outputRef as * mut u8)) {
        return 14i32;
      }
    }
    {
      if (!canonical.contains( & key)) {
        return 15i32;
      }
    }
    {
      if (canonical.length !== 1usize) {
        return 15i32;
      }
    }
    {
      if (!canonical.remove( & key)) {
        return 16i32;
      }
    }
    {
      if (canonical.length !== 0usize) {
        return 16i32;
      }
    }
    try {
      try canonical.shrinkToFit();
    } catch (error: AllocError) {
      return 51i32;
    }
    if (canonical.capacity !== 8usize) {
      return 52i32;
    }
    {
      if (!ordered.contains( & key)) {
        return 20i32;
      }
      const output = ordered.get( & key);
      if (output === undefined) {
        return 20i32;
      }
      orderedMapOutput = output!;
      if (!orderedValues.contains( & key)) {
        return 21i32;
      }
    }
    {
      if (!canonicalSetValue.remove( & key)) {
        return 17i32;
      }
    }
    {
      if (canonicalSetValue.length !== 0usize) {
        return 17i32;
      }
    }
    try {
      try canonicalSetValue.shrinkToFit();
    } catch (error: AllocError) {
      return 47i32;
    }
    if (canonicalSetValue.capacity !== 8usize) {
      return 48i32;
    }
    map.set(key, value);
    {
      if (!map.contains( & key)) {
        return 1i32;
      }
    }
    {
      const output = map.get( & key);
      if (output === undefined) {
        return 2i32;
      }
      legacyMapOutput = output!;
    }
    map.remove( & key);
  }
  if (canonicalMapOutput !== value) {
    return 31i32;
  }
  if (orderedMapOutput !== value) {
    return 32i32;
  }
  if (canonicalArrayOutput !== value) {
    return 33i32;
  }
  if (sliceOutput !== value) {
    return 34i32;
  }
  if (canonicalArrayPopOutput !== value) {
    return 35i32;
  }
  if (canonicalQueuePopOutput !== value) {
    return 36i32;
  }
  if (canonicalQueueSecondOutput !== key) {
    return 37i32;
  }
  if (canonicalQueueThirdOutput !== 7i32) {
    return 43i32;
  }
  if (canonicalDequePopOutput !== key) {
    return 38i32;
  }
  if (canonicalDequeBackOutput !== value) {
    return 39i32;
  }
  if (canonicalHeapPopOutput !== key) {
    return 40i32;
  }
  if (canonicalHeapSecondOutput !== value) {
    return 41i32;
  }
  if (legacyMapOutput !== value) {
    return 42i32;
  }
  return value;
}
