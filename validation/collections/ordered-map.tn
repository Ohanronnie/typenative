import { OrderedMap } from "std/collections";
function main(): i32 {
  let map = new OrderedMap<i32, i32>({
    capacity: 2,
  });
  map.set(26, 2);
  map.set(16, 1);
  let output: i32 = 0;
  for (const entry of move map) {
    output = output * 100 + entry.key;
  }
  if (output === 2616) {
    return 42;
  }
  if (output === 26) {
    return 43;
  }
  if (output === 16) {
    return 44;
  }
  if (output === 0) {
    return 45;
  }
  return 46;
}
