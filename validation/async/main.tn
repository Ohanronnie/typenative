import { runI32 } from "std/async";
declare extern "C" {
  function tn_runtime_abort(code: u32): void;
}
async function coldProbe(): Promise<i32, never> {
  unsafe {
    tn_runtime_abort(77u32);
  }
  return 0i32;
}
async function immediate(value: i32): Promise<i32, never> {
  return value + 1i32;
}
async function caller(): Promise<i32, never> {
  const value = await immediate(41i32);
  return value + 1i32;
}
function main(): i32 {
  const cold = coldProbe();
  return runI32(caller());
}
