import { runI32, Task, TaskGroup } from "std/async";
struct TaskFailure {
  public rawCode: i32;
}
async function typedTask(): Promise<i32, TaskFailure> {
  return 42;
}
async function inspectTask(): Promise<i32, never> {
  await using group = new TaskGroup();
  const task: Task<i32, TaskFailure > = group.spawn(typedTask());
  try {
    return try await task;
  } catch (error: TaskFailure) {
    return error.rawCode;
  }
}
function main(): i32 {
  return runI32(inspectTask());
}
