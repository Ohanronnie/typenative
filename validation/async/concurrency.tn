import { runI32, Task, TaskGroup } from "std/async";
import { sleep } from "std/thread";
import { Duration, Instant } from "std/time";

async function delayed(value: i32): Promise<i32, never> {
  sleep(Duration.fromMilliseconds(25));
  return value;
}
async function concurrentTasks(): Promise<i32, never> {
  await using group = new TaskGroup();
  const first: Task<i32, never > = group.spawn(delayed(1));
  const second: Task<i32, never > = group.spawn(delayed(2));
  const third: Task<i32, never > = group.spawn(delayed(3));
  const fourth: Task<i32, never > = group.spawn(delayed(4));
  const start = Instant.now();
  const firstValue: i32 = await first;
  const secondValue: i32 = await second;
  const thirdValue: i32 = await third;
  const fourthValue: i32 = await fourth;
  const total = firstValue + secondValue + thirdValue + fourthValue;
  if (total !== 10 || start.elapsed().milliseconds() >= 90) {
    return 1;
  }
  return 0;
}
function main(): i32 {
  return runI32(concurrentTasks());
}
