import { runI32, Task, TaskGroup } from "std/async";
import { sleep } from "std/thread";
import { Duration, Instant } from "std/time";

async function delayed(value: i32): Task<i32, never> {
  sleep(Duration.fromMilliseconds(25u64));
  return value;
}
function delayedTask(value: i32): Task<i32, never> {
  return delayed(value);
}
function main(): i32 {
  let group = new TaskGroup();
  const first: Promise<i32, never > = group.spawn(delayedTask(1i32));
  const second: Promise<i32, never > = group.spawn(delayedTask(2i32));
  const third: Promise<i32, never > = group.spawn(delayedTask(3i32));
  const fourth: Promise<i32, never > = group.spawn(delayedTask(4i32));
  const start = Instant.now();
  group.close();
  if (start.elapsed().milliseconds() >= 90u64) {
    return 1i32;
  }
  if (runI32(first) !== 1i32 || runI32(second) !== 2i32 || runI32(third) !== 3i32 || runI32(fourth) !== 4i32) {
    return 2i32;
  }
  return 0i32;
}
