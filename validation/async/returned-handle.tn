import { Task, TaskGroup, runI32 } from "std/async";
async function value(): Promise<i32, never> {
  return 42;
}
async function returnedHandles(): Promise<i32, never> {
  await using group = new TaskGroup();
  const first: Task<i32, never > = group.spawn(value());
  const second: Task<i32, never > = group.spawn(value());
  const firstValue: i32 = await first;
  if (firstValue !== 42) {
    return 1;
  }
  const secondValue: i32 = await second;
  if (secondValue !== 42) {
    return 2;
  }
  return 0;
}
function main(): i32 {
  return runI32(returnedHandles());
}
