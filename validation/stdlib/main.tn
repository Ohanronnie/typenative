import { fromStatic, cursor } from "std/bytes";
function main(): i32 {
  const bytes = fromStatic("abc");
  let input = cursor(bytes.asSlice());
  const value = input.readU8();
  if (value === undefined) {
    return 1;
  }
  if (value! !== 97 || !input.advance(2) || input.position() !== 3) {
    return 2;
  }
  const text = String("hé");
  if (text !== "hé") {
    return 3;
  }
  return 42;
}
