import { fromStatic, cursor, readU8, advance } from "std/bytes";
import { Utf8Error, sliceOwned } from "std/string";

function main(): i32 throws Utf8Error {
  const bytes = fromStatic("abc");
  let input = cursor(bytes);
  let value: u8 = 0u8;
  if (!readU8( & mut input, & mut value)) {
    return 1i32;
  }
  if (value !== 97u8 || !advance( & mut input, 2usize) || input.offset !== 3usize) {
    return 2i32;
  }
  let text = try sliceOwned("héllo", 0usize, 3usize);
  if (text.length !== 3usize) {
    return 3i32;
  }
  return 42i32;
}
