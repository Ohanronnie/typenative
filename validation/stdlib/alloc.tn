import { AllocError, Arc, boxNew, rcClone, rcNew, tryBoxNew, tryRcNew } from "std/alloc";
import { c_size } from "std/ffi";

declare extern "C" {
  function tn_runtime_reset_allocation_count(): void;
  function tn_runtime_free_count(): u64;
  function tn_runtime_fail_alloc_after(successfulAllocations: c_size): void;
  function tn_runtime_clear_alloc_failure(): void;
}
function main(): i32 {
  unsafe {
    tn_runtime_reset_allocation_count();
    tn_runtime_clear_alloc_failure();
  }
  {
    let value = String("box-failure");
    unsafe {
      tn_runtime_fail_alloc_after(0);
    }
    try {
      let ignored = try tryBoxNew(move value);
      return 10;
    } catch (error: AllocError) {
      unsafe {
        tn_runtime_clear_alloc_failure();
        if (tn_runtime_free_count() !== 3) {
          return 11;
        }
      }
    }
  }
  {
    let value = String("rc-failure");
    unsafe {
      tn_runtime_fail_alloc_after(0);
    }
    try {
      let ignored = try tryRcNew(move value);
      return 12;
    } catch (error: AllocError) {
      unsafe {
        tn_runtime_clear_alloc_failure();
        if (tn_runtime_free_count() !== 6) {
          return 13;
        }
      }
    }
  }
  {
    let boxed = boxNew(String("box"));
  }
  unsafe {
    if (tn_runtime_free_count() !== 8) {
      return 1;
    }
  }
  unsafe {
    tn_runtime_reset_allocation_count();
  }
  {
    let owner = new Arc(String("arc"));
    let clone = owner.clone();
    let weak = owner.downgrade();
    const upgraded = weak.upgrade();
    if (upgraded === undefined) {
      return 2;
    }
  }
  unsafe {
    if (tn_runtime_free_count() !== 5) {
      return 3;
    }
  }
  unsafe {
    tn_runtime_reset_allocation_count();
  }
  {
    let owner = rcNew(String("rc"));
    let clone = rcClone( &owner);
  }
  unsafe {
    if (tn_runtime_free_count() !== 2) {
      return 5;
    }
  }
  return 42;
}
