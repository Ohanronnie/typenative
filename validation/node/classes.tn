import { c_size } from "std/ffi";
declare extern "C" {
  function tn_runtime_free_count(): c_size;
}
export function freeCount(): usize {
  unsafe {
    return tn_runtime_free_count();
  }
}
export class Counter {
  public value: i32;
  public constructor(value: i32) {
    this.value = value;
  }
  public increment(delta: i32): i32 {
    this.value = this.value + delta;
    return this.value;
  }
  [Symbol.dispose](): void {
  }
}
