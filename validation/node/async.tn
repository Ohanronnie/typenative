import { Bytes } from "std/bytes";
struct Failure {
  public code: i32;
}
function failure(): Failure {
  return {
    code: 23i32,
  };
}
@Export("immediate")
async function immediate(value: i32): Promise<i32, never> {
  return value + 1i32;
}
@Export("asyncEcho")
async function asyncEcho(value: Bytes): Promise<Bytes, never> {
  return value;
}
@Export("asyncFail")
async function asyncFail(value: i32): Promise<i32, Failure> {
  if (value >= 0i32) {
    throw failure();
  }
  return value;
}
