import { Bytes } from "std/bytes";
import { Array } from "std/collections";
export function optional(value: i32 | undefined): i32 | undefined {
  return value;
}
export function bytesLength(value: Bytes): usize {
  return value.length;
}
export function echoString(value: string): string {
  return value;
}
export function vectorLength(value: & Array<i32 >): usize {
  return value.length;
}
export function makeVector(): Array<i32> {
  let values = new Array<i32>({
    capacity: 3usize,
  });
  values.push(7i32);
  values.push(8i32);
  values.push(9i32);
  return move values;
}
export function fixedMiddle(value:[i32;
3]): i32 {
  return value[1];
}
export function echoI8(value: i8): i8 {
  return value;
}
export function echoI16(value: i16): i16 {
  return value;
}
export function echoU8(value: u8): u8 {
  return value;
}
export function echoU16(value: u16): u16 {
  return value;
}
export function echoF32(value: f32): f32 {
  return value;
}
export function echoChar(value: char): char {
  return value;
}
export function echoI128(value: i128): i128 {
  return value;
}
export function echoU128(value: u128): u128 {
  return value;
}
