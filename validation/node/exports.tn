import { Bytes } from "std/bytes";
import { Array } from "std/collections";

@Export("optional")
function optional(value: i32 | undefined): i32 | undefined {
  return value;
}
@Export("bytesLength")
function bytesLength(value: Bytes): usize {
  return value.length;
}
@Export("echoString")
function echoString(value: string): string {
  return value;
}
@Export("vectorLength")
function vectorLength(value: & Array<i32 >): usize {
  return value.length;
}
@Export("makeVector")
function makeVector(): Array<i32> {
  let values = new Array<i32>({
    capacity: 3usize,
  });
  values.push(7i32);
  values.push(8i32);
  values.push(9i32);
  return move values;
}
@Export("fixedMiddle")
function fixedMiddle(value:[i32;
3]): i32 {
  return value[1];
}
@Export("echoI8")
function echoI8(value: i8): i8 {
  return value;
}
@Export("echoI16")
function echoI16(value: i16): i16 {
  return value;
}
@Export("echoU8")
function echoU8(value: u8): u8 {
  return value;
}
@Export("echoU16")
function echoU16(value: u16): u16 {
  return value;
}
@Export("echoF32")
function echoF32(value: f32): f32 {
  return value;
}
@Export("echoChar")
function echoChar(value: char): char {
  return value;
}
@Export("echoI128")
function echoI128(value: i128): i128 {
  return value;
}
@Export("echoU128")
function echoU128(value: u128): u128 {
  return value;
}
