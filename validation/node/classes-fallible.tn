import { Bytes } from "std/bytes";
struct Failure {
  public rawCode: i32;
}
function failure(): Failure {
  return {
    rawCode: 17,
  };
}
export function syncFail(): i32 throws Failure {
  throw failure();
}
export class Holder {
  public constructor() {
  }
  public echo(value: Bytes): Bytes throws Failure {
    return value;
  }
  [Symbol.dispose](): void {
  }
}
