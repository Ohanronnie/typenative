import { FileKind, metadata, FileError } from "std/fs";
function isRegular(kind: FileKind): bool {
  return switch(kind) {
    case FileKind.Regular: true, case FileKind.Directory: false, case FileKind.Other: false,
  };
}
function isDirectory(kind: FileKind): bool {
  return switch(kind) {
    case FileKind.Regular: false, case FileKind.Directory: true, case FileKind.Other: false,
  };
}
function check(path: &static str, expectedSize: usize): i32 throws FileError {
  const first = try metadata(path);
  if (first.size !== expectedSize || !isRegular(first.kind) || first.modifiedNanoseconds === 0) {
    return 1;
  }
  const second = try metadata(path);
  if (second.size !== first.size || !isRegular(second.kind) || second.modifiedNanoseconds !== first.modifiedNanoseconds) {
    return 2;
  }
  return 0;
}
function missingPathCheck(): i32 {
  let missing = false;
  try {
    const ignored = try metadata("/tmp/typenative-fs-does-not-exist");
  } catch (error: FileError) {
    missing = error.rawCode !== 0;
  }
  if (!missing) {
    return 3;
  }
  return 0;
}
function directoryCheck(path: &static str): i32 throws FileError {
  const first = try metadata(path);
  if (!isDirectory(first.kind) || first.modifiedNanoseconds === 0) {
    return 1;
  }
  const second = try metadata(path);
  if (!isDirectory(second.kind) || second.modifiedNanoseconds !== first.modifiedNanoseconds) {
    return 2;
  }
  return 0;
}
function main(): i32 throws FileError {
  const empty = try check("/tmp/typenative-fs-empty", 0);
  if (empty !== 0) {
    return 10 + empty;
  }
  const oneByte = try check("/tmp/typenative-fs-one-byte", 1);
  if (oneByte !== 0) {
    return 20 + oneByte;
  }
  const multiMegabyte = try check("/tmp/typenative-fs-multi-megabyte", 8388608);
  if (multiMegabyte !== 0) {
    return 30 + multiMegabyte;
  }
  const sparse = try check("/tmp/typenative-fs-sparse", 67108864);
  if (sparse !== 0) {
    return 40 + sparse;
  }
  const directory = try directoryCheck("/tmp/typenative-fs-directory");
  if (directory !== 0) {
    return 50 + directory;
  }
  const unicode = try check("/tmp/typenative-fs-雪", 7);
  if (unicode !== 0) {
    return 60 + unicode;
  }
  return missingPathCheck();
}
