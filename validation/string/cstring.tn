import { InteriorNulError, fromStr } from "std/ffi";
function main(): i32 {
  try {
    let invalid = try fromStr("a\0b");
    return 1;
  } catch (error: InteriorNulError) {
    if (error.offset !== 1) {
      return 2;
    }
  }
  try {
    let valid = try fromStr("ok");
    if (valid.isFreed()) {
      return 3;
    }
    valid.free();
    if (!valid.isFreed()) {
      return 4;
    }
  } catch (error: InteriorNulError) {
    return 5;
  }
  return 42;
}
