import { MemoryOrder, atomicCompareExchangeI32, atomicFetchAddI32, atomicLoadI32, atomicStoreI32 } from "std/core";
import { JoinHandle, Thread, ThreadError } from "std/thread";

static mut counter: i32 = 0;
function worker(): i32 {
  unsafe {
    let index: usize = 0;
    while (index !== 250000) {
      atomicFetchAddI32(( &mut counter)as *mut i32, 1, MemoryOrder.Relaxed);
      index = index + 1;
    }
  }
  return 0;
}
function startWorker(): JoinHandle<i32> {
  return Thread.spawn<i32>(move() => worker());
}
function joinWorker(handle: &mut JoinHandle<i32 >): i32 throws ThreadError {
  const result = try handle.join();
  return result;
}
function main(): i32 throws ThreadError {
  let first = startWorker();
  let second = startWorker();
  let third = startWorker();
  let fourth = startWorker();
  if (try joinWorker( &mut first) !== 0) {
    return 1;
  }
  if (try joinWorker( &mut second) !== 0) {
    return 2;
  }
  if (try joinWorker( &mut third) !== 0) {
    return 3;
  }
  if (try joinWorker( &mut fourth) !== 0) {
    return 4;
  }
  unsafe {
    if (atomicLoadI32(( &counter)as *const i32, MemoryOrder.Acquire) !== 1000000) {
      return 5;
    }
    atomicStoreI32(( &mut counter)as *mut i32, 7, MemoryOrder.Release);
    let expected = atomicLoadI32(( &counter)as *const i32, MemoryOrder.Acquire);
    if (!atomicCompareExchangeI32(( &mut counter)as *mut i32,( &mut expected)as *mut i32, 9, MemoryOrder.AcquireRelease, MemoryOrder.Acquire)) {
      return 6;
    }
    if (atomicLoadI32(( &counter)as *const i32, MemoryOrder.SeqCst) !== 9) {
      return 7;
    }
  }
  return 42;
}
