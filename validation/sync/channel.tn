import { channel } from "std/sync";
function main(): i32 {
  let messages = channel<string>(16, 2);
  if (messages.send(String("first")) !== 0) {
    messages.destroy();
    return 1;
  }
  const received = messages.receive();
  if (received === undefined || received! !== "first") {
    messages.destroy();
    return 2;
  }
  if (messages.send(String("queued")) !== 0) {
    messages.destroy();
    return 3;
  }
  if (messages.close() !== 0) {
    messages.destroy();
    return 4;
  }
  if (messages.receive() === undefined) {
    messages.destroy();
    return 5;
  }
  if (messages.receive() !== undefined) {
    messages.destroy();
    return 6;
  }
  if (messages.destroy() !== 0) {
    return 7;
  }
  return 42;
}
