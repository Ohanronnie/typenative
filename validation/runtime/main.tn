import { Arc, isNull, rawAlloc, rawFree } from "std/alloc";
import { run } from "std/async";
import { Map } from "std/collections";
import { currentDirectory, lookup } from "std/env";
import { Mutex } from "std/sync";
import { Instant } from "std/time";

declare extern "C" {
  function tn_file_open(path: *const u8, flags: i32, mode: i32): i32;
  function tn_file_close(handle: i32): i32;
  function tn_file_remove(path: *const u8): i32;
}
async function answer(): Promise<i32, never> {
  return 42;
}
function checkFile(): bool {
  unsafe {
    const handle = tn_file_open("/tmp/typenative-runtime.tn" as *const u8, 577, 420);
    if (handle<0) {
      return false;
    }
    return tn_file_close(handle) === 0 && tn_file_remove("/tmp/typenative-runtime.tn" as *const u8) === 0;
  }
}
function main(): i32 {
  let values = new Map<i32, i32>({
    capacity: 4,
  });
  let key: i32 = 16;
  const answerValue: i32 = 42;
  values.set(key, answerValue);
  const stored = values.get( &key);
  if (stored === undefined || !values.has( &key)) {
    return 1;
  }
  let storedValue: i32 = 0;
  unsafe {
    storedValue = * stored!;
  }
  if (storedValue !== 42) {
    return 1;
  }
  const removed = values.delete( &key);
  if (removed === undefined || removed! !== 42 || values.length !== 0) {
    return 2;
  }
  let owner: Arc<i32 > = new Arc<i32>(42);
  let clone: Arc<i32 > = owner.clone();
  let cloneValue: i32 = 0;
  unsafe {
    cloneValue = * clone.get();
  }
  if (cloneValue !== 42) {
    return 3;
  }
  let mutex = new Mutex<i32>(7);
  {
    using locked = mutex.lock();
    let value: i32 = 0;
    unsafe {
      value = * locked.getMut();
    }
    if (value !== 7) {
      return 4;
    }
  }
  const answerResult: i32 = run(answer());
  if (answerResult !== 42) {
    return 6;
  }
  if (!checkFile()) {
    return 7;
  }
  unsafe {
    const directory = rawAlloc(4096);
    if (currentDirectory(directory, 4096) !== 0 || *(directory as *const u8) === 0) {
      rawFree(directory);
      return 9;
    }
    rawFree(directory);
  }
  let pathPresent = false;
  unsafe {
    pathPresent = !isNull(lookup("PATH"));
  }
  if (!pathPresent) {
    return 10;
  }
  const start = Instant.now();
  const finish = Instant.now();
  if (finish.durationSince( &start).nanoseconds() < 0) {
    return 11;
  }
  return 0;
}
