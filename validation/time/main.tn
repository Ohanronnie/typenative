import { c_size } from "std/ffi";
import { sleep } from "std/thread";
import { Duration, Instant, Date } from "std/time";

declare extern "C" {
  function tn_io_write_all(fd: i32, bytes: *const u8, length: c_size): i32;
  function tn_string_length(bytes: *const u8): c_size;
}
function writeReport(): i32 {
  const epochDate = Date.fromEpochMilliseconds(0);
  const epoch = epochDate.toISOString();
  const currentDate = new Date();
  const current = currentDate.toISOString();
  unsafe {
    const epochPointer = epoch as *const u8;
    const currentPointer = current as *const u8;
    let status = tn_io_write_all(1, epochPointer, tn_string_length(epochPointer));
    if (status !== 0) {
      return status;
    }
    status = tn_io_write_all(1, "\n" as *const u8, 1);
    if (status !== 0) {
      return status;
    }
    status = tn_io_write_all(1, currentPointer, tn_string_length(currentPointer));
    if (status !== 0) {
      return status;
    }
    return tn_io_write_all(1, "\n" as *const u8, 1);
  }
}
function dateChecks(): i32 {
  const epoch = Date.fromEpochMilliseconds(0);
  if (epoch.getTime() !== 0 || epoch.toISOString() !== "1970-01-01T00:00:00.000Z") {
    return 1;
  }
  if (epoch.getUTCFullYear() !== 1970 || epoch.getUTCMonth() !== 0 || epoch.getUTCDate() !== 1) {
    return 2;
  }
  if (epoch.getUTCHours() !== 0 || epoch.getUTCMinutes() !== 0 || epoch.getUTCSeconds() !== 0 || epoch.getUTCMilliseconds() !== 0) {
    return 3;
  }
  const beforeEpoch = Date.fromEpochMilliseconds( - 1);
  if (beforeEpoch.toISOString() !== "1969-12-31T23:59:59.999Z") {
    return 4;
  }
  const leapDay = Date.fromEpochMilliseconds(951827696789);
  if (leapDay.toISOString() !== "2000-02-29T12:34:56.789Z" || leapDay.getUTCMonth() !== 1 || leapDay.getUTCDate() !== 29) {
    return 5;
  }
  const monthBoundary = Date.fromEpochMilliseconds(951868800000);
  if (monthBoundary.toISOString() !== "2000-03-01T00:00:00.000Z") {
    return 6;
  }
  const dayBoundary = Date.fromEpochMilliseconds(951868799999);
  if (dayBoundary.toISOString() !== "2000-02-29T23:59:59.999Z") {
    return 7;
  }
  const now = Date.now();
  const constructed = new Date();
  const difference = now - constructed.getTime();
  if (difference > 1000 || difference< - 1000) {
    return 8;
  }
  return 0;
}
function durationChecks(): i32 {
  if (Duration.fromNanoseconds(17).nanoseconds() !== 17) {
    return 10;
  }
  if (Duration.fromMicroseconds(3).nanoseconds() !== 3000 || Duration.fromMilliseconds(4).microseconds() !== 4000 || Duration.fromSeconds(2).milliseconds() !== 2000) {
    return 11;
  }
  const maximumDuration = Duration.fromSeconds(~0);
  const oneNanosecond = Duration.fromNanoseconds(1);
  const saturated = maximumDuration.saturatingAdd(oneNanosecond);
  if (saturated.nanoseconds() !== ~0) {
    return 12;
  }
  const shortDuration = Duration.fromNanoseconds(1);
  const longerDuration = Duration.fromNanoseconds(2);
  if (shortDuration.saturatingSub(longerDuration).nanoseconds() !== 0) {
    return 13;
  }
  const start = Instant.now();
  const before = Instant.now();
  if (start.timestampNanoseconds === 0 || before.timestampNanoseconds<start.timestampNanoseconds) {
    return 14;
  }
  sleep(Duration.fromMilliseconds(10));
  const elapsed = start.elapsed();
  if (elapsed.nanoseconds() < 5000000) {
    return 15;
  }
  const after = Instant.now();
  if (after.timestampNanoseconds<before.timestampNanoseconds) {
    return 16;
  }
  return 0;
}
function main(): i32 {
  const dates = dateChecks();
  if (dates !== 0) {
    return dates;
  }
  const durations = durationChecks();
  if (durations !== 0) {
    return durations;
  }
  return writeReport();
}
