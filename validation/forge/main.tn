import { isNull } from "std/alloc";
import { Bytes } from "std/bytes";
import { Array } from "std/collections";
import { ParseIntegerError } from "std/core";
import { lookup } from "std/env";
import { health, metrics, model, plugin, probe, protocol, scheduler } from "./probe";
import { serverMain } from "./server";

export function forgeHealth(): i32 {
  return health();
}
export function forgeModelProbe(): i32 {
  return model();
}
export function forgeProtocolProbe(): i32 {
  return protocol();
}
export function forgeSchedulerProbe(): i32 {
  return scheduler();
}
export function forgeMetricsProbe(): i32 {
  return metrics();
}
export function forgePluginProbe(): i32 {
  return plugin();
}
export function forgeFeatureProbe(): i32 {
  const result = probe();
  return result === 42?0: result;
}
export function forgeNodeOptional(value: i32 | undefined): i32 | undefined {
  return value;
}
export function forgeNodeString(value: string): string {
  return value;
}
export function forgeNodeBytesLength(value: Bytes): usize {
  return value.length;
}
export function forgeNodeArrayLength(value: &Array<i32 >): usize {
  return value.length;
}
export function forgeNodeFixedMiddle(value:[i32;
3]): i32 {
  return value[1];
}
export async function forgeNodeAsync(value: i32): Promise<i32, never> {
  return value + 1;
}
struct ForgeNodeError {
}
function forgeNodeError(): ForgeNodeError {
  return {
  };
}
export async function forgeNodeAsyncFail(): Promise<i32, ForgeNodeError> {
  throw forgeNodeError();
}
export class ForgeJob {
  public value: i32;
  public constructor(value: i32) {
    this.value = value;
  }
  public run(delta: i32): i32 {
    this.value = this.value + delta;
    return this.value;
  }
  [Symbol.dispose](): void {
  }
}
export function forgeProbe(): i32 {
  return probe();
}
function serveMode(): bool {
  let active = false;
  unsafe {
    active = !isNull(lookup("FORGE_MODE"));
  }
  return active;
}
function main(): i32 {
  if (serveMode()) {
    try {
      return try serverMain();
    } catch (error: ParseIntegerError) {
      return 80;
    }
  }
  const probe = forgeProbe();
  return probe === 42?0: probe;
}
