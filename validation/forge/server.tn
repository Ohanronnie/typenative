import { isNull } from "std/alloc";
import { runI32, TaskGroup } from "std/async";
import { error as consoleError } from "std/console";
import { ParseIntegerError } from "std/core";
import { lookup, lookupU16 } from "std/env";
import { Endpoint, NetworkError, TcpListener, TcpStream } from "std/net";
import { Command, RedisError, Reply, RespConnection } from "../redis/resp";

async function serveClient(stream: TcpStream): Promise<void, RedisError> {
  await using connection = new RespConnection(move stream);
  const command = try await connection.readCommand();
  if (command === undefined) {
    return;
  }
  let reply = Reply.Error(string.from("ERR unknown forge command"));
  if (command!.name === "PING") {
    reply = Reply.Simple(string.from("PONG"));
  } else if (command!.name === "BUILD") {
    reply = Reply.Simple(string.from("QUEUED"));
  } else if (command!.name === "STATUS") {
    reply = Reply.Simple(string.from("READY"));
  }
  try await connection.writeReply(reply);
}
async function serveClientTask(stream: TcpStream): Promise<void, never> {
  try {
    try await serveClient(move stream);
  } catch (error: RedisError) {
    return;
  }
  return;
}
async function serve(endpoint: Endpoint): Promise<i32, NetworkError> {
  await using listener = try new TcpListener(endpoint);
  using clients = new TaskGroup<RedisError>();
  while (true) {
    const stream = try await listener.accept();
    if (!clients.spawn(serveClientTask(move stream))) {
      return 1i32;
    }
  }
  return 0i32;
}
async function runServer(port: u16): Promise<i32, never> {
  try {
    try await serve({
      host: "127.0.0.1", port: port,
    });
  } catch (error: NetworkError) {
    consoleError("Forge server failed");
    return 1i32;
  }
  return 0i32;
}
function serveRequested(): bool {
  let requested = false;
  unsafe {
    requested = !isNull(lookup("FORGE_MODE"));
  }
  return requested;
}
export function serverMain(): i32 throws ParseIntegerError {
  if (!serveRequested()) {
    return 0i32;
  }
  const port = try lookupU16("FORGE_PORT");
  return runI32(runServer(port));
}
