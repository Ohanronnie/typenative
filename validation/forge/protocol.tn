import { BytesMut, cursor, fromStatic, SliceError } from "std/bytes";
import { Error } from "std/core";

export enum ProtocolError implements Error {
  Truncated, Invalid,
}
export enum Command {
  Ping, Build, Shutdown,
}
export struct Request {
  public command: Command;
  public id: u8;
}
function encode(request: Request): BytesMut {
  let output = new BytesMut({
    capacity: 8,
  });
  const marker: u8 = switch(request.command) {
    case Command.Ping: 1, case Command.Build: 2, case Command.Shutdown: 3,
  };
  output.push(marker);
  output.push(request.id);
  return output;
}
function decode(input: &BytesMut): Request throws ProtocolError | SliceError {
  let view = try input.slice(0, input.length);
  let inputCursor = cursor(view);
  const marker = inputCursor.readU8();
  const id = inputCursor.readU8();
  if (marker === undefined || id === undefined) {
    throw ProtocolError.Truncated;
  }
  const markerValue: u8 = marker!;
  const idValue: u8 = id!;
  let command = Command.Ping;
  if (markerValue === 2) {
    command = Command.Build;
  } else if (markerValue === 3) {
    command = Command.Shutdown;
  } else if (markerValue !== 1) {
    throw ProtocolError.Invalid;
  }
  return {
    command: command, id: idValue,
  };
}
export function protocolProbe(): i32 {
  const request: Request = {
    command: Command.Build, id: 42,
  };
  let encoded = encode(request);
  try {
    const decoded = try decode( &encoded);
    const commandMatches = switch(decoded.command) {
      case Command.Build: true, default: false,
    };
    if (!commandMatches || decoded.id !== 42) {
      return 1;
    }
  } catch (error: ProtocolError) {
    return 2;
  } catch (error: SliceError) {
    return 2;
  }
  let malformed = new BytesMut({
    capacity: 1,
  });
  malformed.push(1);
  try {
    const ignored = try decode( &malformed);
    return 3;
  } catch (error: ProtocolError) {
    return switch(error) {
      case ProtocolError.Truncated: 0, default: 4,
    };
  } catch (error: SliceError) {
    return 4;
  }
}
export function staticProtocolProbe(): i32 {
  const bytes = fromStatic("forge");
  return bytes.length === 5?0: 1;
}
