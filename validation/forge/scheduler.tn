import { run, runI32, TaskGroup } from "std/async";
import { AtomicI32, MemoryOrder } from "std/core";
import { Mutex, channel } from "std/sync";

async function compute(value: i32): Promise<i32, never> {
  return value * 2;
}
export function schedulerProbe(): i32 {
  const initial: i32 = 0;
  let counter = new AtomicI32(initial);
  counter.fetchAdd(4, MemoryOrder.Relaxed);
  if (counter.load(MemoryOrder.Acquire) !== 4) {
    return 1;
  }
  let mutex = new Mutex<i32>(8);
  {
    using locked = mutex.lock();
    let value: i32 = 0;
    unsafe {
      value = * locked.getMut();
    }
    if (value !== 8) {
      return 2;
    }
  }
  let messages = channel<i32>(4, 2);
  const sent: i32 = 17;
  if (messages.send(sent) !== 0) {
    messages.destroy();
    return 4;
  }
  const received = messages.receive();
  if (received === undefined || received! !== 17) {
    messages.destroy();
    return 5;
  }
  messages.close();
  messages.destroy();
  let group = new TaskGroup();
  group.spawn(compute(21));
  run(group.close());
  if (runI32(compute(21)) !== 42) {
    return 7;
  }
  return 0;
}
