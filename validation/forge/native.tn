import { isNull } from "std/alloc";
import { ParseIntegerError } from "std/core";
import { lookup } from "std/env";
import { health, metrics, model, plugin, probe, protocol, scheduler } from "./probe";
import { serverMain } from "./server";

export function forgeHealth(): i32 {
  return health();
}
export function forgeModelProbe(): i32 {
  return model();
}
export function forgeProtocolProbe(): i32 {
  return protocol();
}
export function forgeSchedulerProbe(): i32 {
  return scheduler();
}
export function forgeMetricsProbe(): i32 {
  return metrics();
}
export function forgePluginProbe(): i32 {
  return plugin();
}
export function forgeFeatureProbe(): i32 {
  const result = probe();
  return result === 42?0: result;
}
export function forgeProbe(): i32 {
  return probe();
}
function serveMode(): bool {
  let active = false;
  unsafe {
    active = !isNull(lookup("FORGE_MODE"));
  }
  return active;
}
function main(): i32 {
  if (serveMode()) {
    try {
      return try serverMain();
    } catch (error: ParseIntegerError) {
      return 80;
    }
  }
  const result = probe();
  return result === 42?0: result;
}
