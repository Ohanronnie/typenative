import { isNull } from "std/alloc";
import { ParseIntegerError } from "std/core";
import { lookup } from "std/env";
import { health, metrics, model, plugin, probe, protocol, scheduler } from "./probe";
import { serverMain } from "./server";

@Export("forge_health")
function forgeHealth(): i32 {
  return health();
}
@Export("forge_model_probe")
function forgeModelProbe(): i32 {
  return model();
}
@Export("forge_protocol_probe")
function forgeProtocolProbe(): i32 {
  return protocol();
}
@Export("forge_scheduler_probe")
function forgeSchedulerProbe(): i32 {
  return scheduler();
}
@Export("forge_metrics_probe")
function forgeMetricsProbe(): i32 {
  return metrics();
}
@Export("forge_plugin_probe")
function forgePluginProbe(): i32 {
  return plugin();
}
@Export("forge_feature_probe")
function forgeFeatureProbe(): i32 {
  const result = probe();
  return result === 42i32?0i32: result;
}
@Export("forge_probe")
function forgeProbe(): i32 {
  return probe();
}
function serveMode(): bool {
  let active = false;
  unsafe {
    active = !isNull(lookup("FORGE_MODE"));
  }
  return active;
}
function main(): i32 {
  if (serveMode()) {
    try {
      return try serverMain();
    } catch (error: ParseIntegerError) {
      return 80i32;
    }
  }
  const result = probe();
  return result === 42i32?0i32: result;
}
