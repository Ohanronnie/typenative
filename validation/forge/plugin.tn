import { isNull } from "std/alloc";
import { lookup } from "std/env";
import { closeLibrary, FfiError, openLibraryPointerChecked, symbol } from "std/ffi";

export function pluginProbe(): i32 {
  const path = lookup("FORGE_PLUGIN_PATH");
  if (isNull(path)) {
    return 1i32;
  }
  try {
    unsafe {
      let library = try openLibraryPointerChecked(path);
      const pointer = symbol( & library, "strlen");
      const status = closeLibrary( & mut library);
      let missing = false;
      missing = isNull(pointer as * const u8);
      return missing || status !== 0i32?2i32: 0i32;
    }
  } catch (error: FfiError) {
    return 2i32;
  }
}
