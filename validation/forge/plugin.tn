import { isNull } from "std/alloc";
import { lookup } from "std/env";
import { FfiError, tryOpenLibraryPointer } from "std/ffi";

export function pluginProbe(): i32 {
  try {
    unsafe {
      const path = lookup("FORGE_PLUGIN_PATH");
      if (isNull(path)) {
        return 1;
      }
      let library = try tryOpenLibraryPointer(path);
      const pointer = library.symbol("strlen");
      const status = library.close();
      let missing = false;
      missing = isNull(pointer as *const u8);
      return missing || status !== 0?2: 0;
    }
  } catch (error: FfiError) {
    return 2;
  }
}
