import { fromStatic } from "std/bytes";
import { Map } from "std/collections";
import { FileError, metadata, remove, tryOpenWrite } from "std/fs";

export struct ArtifactStore {
  public count: i32;
}
export function storeProbe(): i32 throws FileError {
  let values = new Map<i32, i32>({
    capacity: 8,
  });
  values.set(7, 49);
  const key: i32 = 7;
  const stored = values.get( &key);
  if (stored === undefined) {
    return 1;
  }
  unsafe {
    if ( * stored! !== 49) {
      return 1;
    }
  }
  let file = try tryOpenWrite("/tmp/typenative-forge-artifact");
  const marker = fromStatic("forge-artifact\n");
  unsafe {
    try file.writeAllRaw(marker.nativePointer(), marker.length);
  }
  file.close();
  const info = try metadata("/tmp/typenative-forge-artifact");
  if (info.size !== marker.length) {
    remove("/tmp/typenative-forge-artifact");
    return 2;
  }
  if (remove("/tmp/typenative-forge-artifact") !== 0) {
    return 3;
  }
  return 0;
}
