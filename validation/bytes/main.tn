import { BytesMut, SliceError } from "std/bytes";
import { Map } from "std/collections";
import { Utf8Error } from "std/string";

function main(): i32 throws Utf8Error | SliceError {
  let bytes = new BytesMut({
    capacity: 4
  });
  bytes.push(97);
  bytes.push(98);
  bytes.push(99);
  {
    const root = bytes.asBytes();
    if (root.length !== 3 || root.get(0)! !== 97) {
      return 1;
    }
    if (root.get(3) !== undefined) {
      return 2;
    }
    const empty = try root.slice(1, 1);
    if (empty.length !== 0 || empty.get(0) !== undefined) {
      return 3;
    }
    const tail = try root.slice(1, 3);
    const nested = try tail.slice(0, 1);
    const repeated = try root.slice(1, 2);
    if (nested.get(0)! !== 98 || repeated.get(0)! !== 98) {
      return 4;
    }
    const text = try String.fromUtf8(tail);
    if (text !== "bc") {
      return 6;
    }
    const owned: string = text.clone();
    if (owned !== "bc") {
      return 7;
    }
    let values = new Map<string, string>({
      capacity: 8
    });
    values.set(text.clone(), String("found"));
    const found = values.get( &text);
    if (found === undefined || found!.byteLength !== 5) {
      return 8;
    }
  }
  bytes.discardPrefix(1);
  if (bytes.length !== 2 || bytes.get(0)! !== 98) {
    return 9;
  }
  let invalid = new BytesMut({
    capacity: 1
  });
  invalid.push(255);
  try {
    const ignored = try String.fromUtf8(invalid.asBytes());
    return 10;
  } catch (error: Utf8Error) {
  }
  let multibyte = new BytesMut({
    capacity: 2
  });
  multibyte.push(195);
  multibyte.push(169);
  const multibyteText = try String.fromUtf8(multibyte.asBytes());
  if (multibyteText !== "é") {
    return 20;
  }
  try {
    const valid = try bytes.slice(0, 2);
    if (valid[0] !== 98 || valid[1] !== 99) {
      return 11;
    }
  } catch (error: SliceError) {
    return 12;
  }
  try {
    const invalidSlice = try bytes.slice(1, 3);
    return 13;
  } catch (error: SliceError) {
    if (error.start !== 1 || error.end !== 3 || error.length !== 2) {
      return 14;
    }
  }
  return 42;
}
