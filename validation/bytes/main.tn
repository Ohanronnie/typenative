import { BytesMut, SliceError } from "std/bytes";
import { Map } from "std/collections";
import { Utf8Error } from "std/string";

function main(): i32 throws Utf8Error | SliceError {
  let bytes = new BytesMut({
    capacity: 4usize
  });
  bytes.push(97u8);
  bytes.push(98u8);
  bytes.push(99u8);
  {
    const root = bytes.asBytes();
    if (root.length !== 3usize || root.get(0usize)! !== 97u8) {
      return 1i32;
    }
    if (root.get(3usize) !== undefined) {
      return 2i32;
    }
    const empty = try root.slice(1usize, 1usize);
    if (empty.length !== 0usize || empty.get(0usize) !== undefined) {
      return 3i32;
    }
    const tail = try root.slice(1usize, 3usize);
    const nested = try tail.slice(0usize, 1usize);
    const repeated = try root.slice(1usize, 2usize);
    if (nested.get(0usize)! !== 98u8 || repeated.get(0usize)! !== 98u8) {
      return 4i32;
    }
    const text = try String.fromUtf8(tail);
    if (text !== "bc") {
      return 6i32;
    }
    const owned: string = text.clone();
    if (owned !== "bc") {
      return 7i32;
    }
    let values = new Map<string, string>({
      capacity: 8usize
    });
    values.set(text.clone(), String("found"));
    const found = values.get( & text);
    if (found === undefined || found!.byteLength !== 5usize) {
      return 8i32;
    }
  }
  bytes.discardPrefix(1usize);
  if (bytes.length !== 2usize || bytes.get(0usize)! !== 98u8) {
    return 9i32;
  }
  let invalid = new BytesMut({
    capacity: 1usize
  });
  invalid.push(255u8);
  try {
    const ignored = try String.fromUtf8(invalid.asBytes());
    return 10i32;
  } catch (error: Utf8Error) {
  }
  let multibyte = new BytesMut({
    capacity: 2usize
  });
  multibyte.push(195u8);
  multibyte.push(169u8);
  const multibyteText = try String.fromUtf8(multibyte.asBytes());
  if (multibyteText !== "é") {
    return 20i32;
  }
  try {
    const valid = try bytes.slice(0usize, 2usize);
    if (valid[0usize] !== 98u8 || valid[1usize] !== 99u8) {
      return 11i32;
    }
  } catch (error: SliceError) {
    return 12i32;
  }
  try {
    const invalidSlice = try bytes.slice(1usize, 3usize);
    return 13i32;
  } catch (error: SliceError) {
    if (error.start !== 1usize || error.end !== 3usize || error.length !== 2usize) {
      return 14i32;
    }
  }
  return 42i32;
}
