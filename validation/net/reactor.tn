import { IoEvent, ReactorError, reactor } from "std/async";
import { NetworkError, tryUdpBind } from "std/net";
import { Duration } from "std/time";

function main(): i32 {
  try {
    let socket = try tryUdpBind("127.0.0.1", 0);
    let poller = reactor();
    try poller.watch(socket.ioHandle(), IoEvent.Readable);
    const ready = try poller.poll(Duration.fromMilliseconds(0));
    try poller.unwatch(socket.ioHandle());
    poller.close();
    socket.close();
    return ready === undefined?0: 1;
  } catch (error: NetworkError) {
    return 2;
  } catch (error: ReactorError) {
    return 3;
  }
}
