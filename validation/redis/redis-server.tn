import { Arc, u64ToUsize } from "std/alloc";
import { run, TaskGroup } from "std/async";
import { Bytes, BytesMut } from "std/bytes";
import { Map } from "std/collections";
import { error as consoleError } from "std/console";
import { ParseIntegerError } from "std/core";
import { Endpoint, NetworkError, TcpListener, TcpStream } from "std/net";
import { Mutex } from "std/sync";
import { Instant } from "std/time";
import { ParsedCommand, RedisError, RespConnection } from "./resp";

function redisText(value: Bytes): &str throws RedisError {
  const text = value.asStr();
  if (text === undefined) {
    throw RedisError.InvalidUtf8;
  }
  return text!;
}
function parseUnsigned(value: Bytes): usize | undefined {
  try {
    return try usize.parseAscii(value);
  } catch (error: ParseIntegerError) {
    return undefined;
  }
}
function appendBulk(outputPointer: *mut BytesMut, value: Bytes): void {
  const output = outputRef(outputPointer);
  output.appendAscii("$");
  output.appendUnsignedDecimal(value.length);
  output.appendAscii("\r\n");
  output.append(value);
  output.appendAscii("\r\n");
}
function appendInteger(outputPointer: *mut BytesMut, value: usize): void {
  const output = outputRef(outputPointer);
  output.appendAscii(":");
  output.appendUnsignedDecimal(value);
  output.appendAscii("\r\n");
}
function executeStateless(name: Bytes, command: &ParsedCommand, output: &mut BytesMut,): i32 throws RedisError {
  if (name.equalsAsciiIgnoreCase("ECHO")) {
    if (command.count<2) {
      output.appendAscii("-ERR ECHO requires a message\r\n");
      return 0;
    }
    unsafe {
      appendBulk(output as *mut BytesMut, command.part(1)!);
    }
    return 0;
  }
  if (name.equalsAsciiIgnoreCase("PING")) {
    if (command.count >= 2) {
      unsafe {
        appendBulk(output as *mut BytesMut, command.part(1)!);
      }
      return 0;
    }
    output.appendAscii("+PONG\r\n");
    return 0;
  }
  if (name.equalsAsciiIgnoreCase("COMMAND")) {
    output.appendAscii("*0\r\n");
    return 0;
  }
  if (name.equalsAsciiIgnoreCase("QUIT")) {
    output.appendAscii("+OK\r\n");
    return 1;
  }
  return - 1;
}
function numberValue(value: usize): BytesMut {
  let bytes = new BytesMut({
    capacity: 32,
  });
  bytes.appendUnsignedDecimal(value);
  return move bytes;
}
function storedValue(value: Bytes): BytesMut {
  let bytes = new BytesMut({
    capacity: value.length + 1,
  });
  bytes.append(value);
  return move bytes;
}
function replaceStoredValue(value: &mut BytesMut, source: Bytes): void {
  value.length = 0;
  value.append(source);
}
function monotonicNanoseconds(): usize {
  const instant = Instant.now();
  return u64ToUsize(instant.timestampNanoseconds);
}
function expirationDeadline(seconds: usize): usize {
  const maximumSeconds: usize = ~0 / 1000000000;
  let scaled: usize = 0;
  if (seconds > maximumSeconds) {
    scaled = ~0;
  } else {
    scaled = seconds * 1000000000;
  }
  const now = monotonicNanoseconds();
  if (scaled > ~0 - now) {
    return ~0;
  }
  return now + scaled;
}
struct RedisEntry {
  public value: BytesMut;
  public expiration: usize;
}
function entryIsExpired(entry: &RedisEntry): bool {
  return entry.expiration !== 0 && monotonicNanoseconds() >= entry.expiration;
}
export class Database {
  public state: Map<string, RedisEntry>;
  public constructor(capacity: usize) {
    this.state = new Map<string, RedisEntry>({
      capacity: capacity
    });
  }
}
function outputRef(pointer: *mut BytesMut): &mut BytesMut {
  unsafe {
    return &mut * pointer;
  }
}
function executeStatefulNamed(database: &mut Database, name: Bytes, command: &ParsedCommand, outputPointer: *mut BytesMut,): void throws RedisError {
  const output = outputRef(outputPointer);
  if (name.equalsAsciiIgnoreCase("SET")) {
    if (command.count<3) {
      output.appendAscii("-ERR SET requires a key and value\r\n");
      return;
    }
    const setKeyBytes = command.part(1)!;
    const setKeyText = setKeyBytes.asStr()!;
    let setKey = String(setKeyText);
    const setValueBytes = command.part(2)!;
    let inserted = true;
    {
      const existing = database.state.getMut( &setKey);
      if (existing !== undefined) {
        replaceStoredValue(existing!.value, setValueBytes);
        existing!.expiration = 0;
        inserted = false;
      }
    }
    if (inserted) {
      database.state.set(move setKey, {
        value: storedValue(setValueBytes), expiration: 0
      });
    }
    output.appendAscii("+OK\r\n");
    return;
  }
  if (name.equalsAsciiIgnoreCase("GET")) {
    if (command.count<2) {
      output.appendAscii("-ERR GET requires a key\r\n");
      return;
    }
    let getKey = String(try redisText(command.part(1)!));
    let expired = false;
    {
      const getEntry = database.state.get( &getKey);
      if (getEntry === undefined) {
        output.appendAscii("$-1\r\n");
        return;
      }
      expired = entryIsExpired(getEntry!);
    }
    if (expired) {
      database.state.delete( &getKey);
      output.appendAscii("$-1\r\n");
      return;
    }
    const getEntry = database.state.get( &getKey)!;
    const getValue = getEntry.value.asBytes();
    output.appendAscii("$");
    output.appendUnsignedDecimal(getValue.length);
    output.appendAscii("\r\n");
    output.append(getValue);
    output.appendAscii("\r\n");
    return;
  }
  if (name.equalsAsciiIgnoreCase("DEL")) {
    if (command.count<2) {
      output.appendAscii("-ERR DEL requires a key\r\n");
      return;
    }
    let removedCount: usize = 0;
    let index: usize = 1;
    while (index<command.count) {
      let deleteKey = String(try redisText(command.part(index)!));
      let expired = false;
      {
        const entry = database.state.get( &deleteKey);
        if (entry !== undefined) {
          expired = entryIsExpired(entry!);
        }
      }
      if (expired) {
        database.state.delete( &deleteKey);
      } else {
        const removed = database.state.delete( &deleteKey);
        if (removed !== undefined) {
          removedCount += 1;
        }
      }
      index += 1;
    }
    appendInteger(outputPointer, removedCount);
    return;
  }
  if (name.equalsAsciiIgnoreCase("EXISTS")) {
    let foundCount: usize = 0;
    let index: usize = 1;
    while (index<command.count) {
      let key = String(try redisText(command.part(index)!));
      let expired = false;
      {
        const entry = database.state.get( &key);
        if (entry !== undefined) {
          expired = entryIsExpired(entry!);
        }
      }
      if (expired) {
        database.state.delete( &key);
      }
      if (database.state.has( &key)) {
        foundCount += 1;
      }
      index += 1;
    }
    appendInteger(outputPointer, foundCount);
    return;
  }
  if (name.equalsAsciiIgnoreCase("INCR")) {
    if (command.count<2) {
      output.appendAscii("-ERR INCR requires a key\r\n");
      return;
    }
    let key = String(try redisText(command.part(1)!));
    let expired = false;
    {
      const entry = database.state.get( &key);
      if (entry !== undefined) {
        expired = entryIsExpired(entry!);
      }
    }
    if (expired) {
      database.state.delete( &key);
    }
    let value: usize = 0;
    const stored = database.state.getMut( &key);
    if (stored !== undefined) {
      const parsed = parseUnsigned(stored!.value.asBytes());
      if (parsed === undefined) {
        output.appendAscii("-ERR value is not an integer\r\n");
        return;
      }
      value = parsed!;
    }
    if (value === ~0) {
      output.appendAscii("-ERR increment or decrement would overflow\r\n");
      return;
    }
    value += 1;
    if (stored !== undefined) {
      stored!.value.length = 0;
      stored!.value.appendUnsignedDecimal(value);
      stored!.expiration = 0;
      appendInteger(outputPointer, value);
      return;
    }
    const replacement = numberValue(value);
    const insertedKey = key.clone();
    database.state.set(move insertedKey, {
      value: move replacement, expiration: 0
    });
    appendInteger(outputPointer, value);
    return;
  }
  if (name.equalsAsciiIgnoreCase("EXPIRE")) {
    if (command.count<3) {
      output.appendAscii("-ERR EXPIRE requires a key and seconds\r\n");
      return;
    }
    let key = String(try redisText(command.part(1)!));
    const seconds = parseUnsigned(command.part(2)!);
    if (seconds === undefined) {
      output.appendAscii("-ERR value is not an integer\r\n");
      return;
    }
    let expired = false;
    {
      const entry = database.state.get( &key);
      if (entry !== undefined) {
        expired = entryIsExpired(entry!);
      }
    }
    if (expired) {
      database.state.delete( &key);
    }
    if (!database.state.has( &key)) {
      output.appendAscii(":0\r\n");
      return;
    }
    const stored = database.state.getMut( &key)!;
    stored.expiration = expirationDeadline(seconds!);
    output.appendAscii(":1\r\n");
    return;
  }
  if (name.equalsAsciiIgnoreCase("TTL")) {
    if (command.count<2) {
      output.appendAscii("-ERR TTL requires a key\r\n");
      return;
    }
    let key = String(try redisText(command.part(1)!));
    let expired = false;
    {
      const entry = database.state.get( &key);
      if (entry !== undefined) {
        expired = entryIsExpired(entry!);
      }
    }
    if (expired) {
      database.state.delete( &key);
    }
    if (!database.state.has( &key)) {
      output.appendAscii(":-2\r\n");
      return;
    }
    const entry = database.state.get( &key)!;
    if (entry.expiration === 0) {
      output.appendAscii(":-1\r\n");
      return;
    }
    const now = monotonicNanoseconds();
    let remaining: usize = 0;
    const deadline = entry.expiration;
    if (deadline > now) {
      remaining =(deadline - now) / 1000000000;
    } else {
      remaining = 0;
    }
    output.appendAscii(":");
    output.appendUnsignedDecimal(remaining);
    output.appendAscii("\r\n");
    return;
  }
  output.appendAscii("-ERR unknown command\r\n");
  return;
}
function databaseRef(pointer: *mut Database): &mut Database {
  unsafe {
    return &mut * pointer;
  }
}
export unsafe function executeDatabase(databasePointer: *mut Database, command: &ParsedCommand, outputPointer: *mut BytesMut,): bool {
  const database = databaseRef(databasePointer);
  const output = outputRef(outputPointer);
  const name = command.part(0);
  if (name !== undefined) {
    if (name!.equalsAsciiIgnoreCase("PING")) {
      output.appendAscii("+PONG\r\n");
    } else if (name!.equalsAsciiIgnoreCase("SET") && command.count >= 3) {
      const keyBytes = command.part(1);
      const valueBytes = command.part(2);
      if (keyBytes !== undefined && valueBytes !== undefined) {
        const keyText = keyBytes!.asStr();
        if (keyText !== undefined) {
          let key = String(keyText!);
          let stored = storedValue(valueBytes!);
          database.state.set(move key, {
            value: move stored, expiration: 0
          });
          output.appendAscii("+OK\r\n");
        }
      }
    } else if (name!.equalsAsciiIgnoreCase("GET") && command.count >= 2) {
      const keyBytes = command.part(1);
      if (keyBytes !== undefined) {
        const keyText = keyBytes!.asStr();
        if (keyText !== undefined) {
          const entry = database.state.get("k");
          if (entry === undefined) {
            output.appendAscii("$-1\r\n");
          } else {
            const value = entry!.value.asBytes();
            output.appendAscii("$");
            output.appendUnsignedDecimal(value.length);
            output.appendAscii("\r\n");
            output.append(value);
            output.appendAscii("\r\n");
          }
        }
      }
    }
  }
  return true;
}
function executeLocked(mutex: &Mutex<Database>, name: Bytes, command: &ParsedCommand, output: &mut BytesMut,): void throws RedisError {
  using locked = mutex.lock();
  unsafe {
    try executeStatefulNamed(locked.getMut(), name, command, output as *mut BytesMut);
  }
}
async function serveClient(stream: TcpStream, database: Arc<Mutex<Database> >,): Promise<void, RedisError> {
  await using connection = new RespConnection(move stream);
  let output = new BytesMut({
    capacity: 8192
  });
  try {
    while (try await connection.readCommandAvailable()) {
      let offset: usize = 0;
      let batchSize: usize = 0;
      let shouldClose = false;
      while (batchSize<1024) {
        let nextOffset = offset;
        let complete = false;
        {
          const command = try connection.readBufferedCommand(offset);
          if (command !== undefined) {
            nextOffset = command!.consumed;
            const commandName = try command!.name();
            const stateless = try executeStateless(commandName, &command!, &mut output);
            if (stateless === - 1) {
              try executeLocked(database.get(), commandName, &command!, &mut output);
            } else {
              shouldClose = stateless === 1;
            }
            complete = true;
            if (shouldClose) {
              offset = nextOffset;
              batchSize += 1;
              break;
            }
          }
        }
        if (!complete) {
          break;
        }
        offset = nextOffset;
        batchSize += 1;
      }
      connection.consume(offset);
      const outputBytes = output.asBytes();
      if (!try connection.flushNow(outputBytes)) {
        try await connection.flush(outputBytes);
      }
      output.length = 0;
      if (shouldClose) {
        connection.close();
        return;
      }
    }
    connection.close();
    return;
  } catch (error: RedisError) {
    connection.close();
    throw error;
  }
}
async function serveClientTask(stream: TcpStream, database: Arc<Mutex<Database> >,): Promise<void, never> {
  try {
    try await serveClient(move stream, database);
  } catch (error: RedisError) {
    return;
  }
  return;
}
export async function serve(endpoint: Endpoint, capacity: usize,): Promise<void, NetworkError> {
  await using listener = try new TcpListener(endpoint);
  await using clients = new TaskGroup();
  const database: Arc<Mutex<Database> > = new Arc<Mutex<Database> >(new Mutex<Database>(new Database(capacity)));
  while (true) {
    const stream = try await listener.accept();
    const shared: Arc<Mutex<Database> > = database.clone();
    const task: Promise<void, never > = serveClientTask(stream, shared);
    clients.spawn(move task);
  }
}
export async function servePort(port: u16, capacity: usize,): Promise<void, NetworkError> {
  await using listener = try new TcpListener({
    host: "127.0.0.1", port: port,
  });
  await using clients = new TaskGroup();
  const database: Arc<Mutex<Database> > = new Arc<Mutex<Database> >(new Mutex<Database>(new Database(capacity)));
  while (true) {
    const stream = try await listener.accept();
    const shared: Arc<Mutex<Database> > = database.clone();
    const task: Promise<void, never > = serveClientTask(stream, shared);
    clients.spawn(move task);
  }
}
async function runServer(endpoint: Endpoint, capacity: usize,): Promise<i32, never> {
  try {
    try await serve(endpoint, capacity);
  } catch (error: NetworkError) {
    consoleError("Redis server failed");
    return 1;
  }
  return 0;
}
export function main(): i32 {
  return run(runServer({
    host: "127.0.0.1", port: 6379,
  }, 4096,),);
}
