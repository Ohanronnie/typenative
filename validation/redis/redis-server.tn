import { Arc } from "std/alloc";
import { run, TaskGroup } from "std/async";
import { appendAscii as appendBytesAscii, appendUnsignedDecimal as appendBytesUnsignedDecimal, BytesMut, push as pushByte } from "std/bytes";
import { StringMap } from "std/collections";
import { error as consoleError } from "std/console";
import { Endpoint, NetworkError, TcpListener, TcpStream } from "std/net";
import { Mutex } from "std/sync";
import { ParsedCommand, RedisError, RespConnection } from "./resp";

@Sealed export final class Database {
  private state: StringMap<string>;
  public constructor(capacity: usize) {
    this.state = new StringMap<string>({
      capacity: capacity
    });
  }
  public mut execute<lifetime a>(command: & ParsedCommand<a>, output: & mut BytesMut,): void {
    const nameKey = command.nameKey();
    if (nameKey === 288230377348024656u64) {
      appendBytesAscii(output, "+PONG\r\n");
      return;
    }
    this.executeNamed(nameKey, command, output);
  }
  public mut executeNamed<lifetime a>(nameKey: u64, command: & ParsedCommand<a>, output: & mut BytesMut,): void {
    if (nameKey === 216172782119306579u64) {
      if (command.count<3usize) {
        appendBytesAscii(output, "-ERR SET requires a key and value\r\n");
        return;
      }
      const setKeyView = command.hashedPart(1usize)!;
      const setValueView = command.part(2usize)!;
      const setValue: string = setValueView.toOwned();
      this.state.setBorrowed( & setKeyView, move setValue);
      appendBytesAscii(output, "+OK\r\n");
      return;
    }
    if (nameKey === 216172782119306567u64) {
      if (command.count<2usize) {
        appendBytesAscii(output, "-ERR GET requires a key\r\n");
        return;
      }
      const getKey = command.hashedPart(1usize)!;
      const getValue = this.state.getHashed( & getKey);
      if (getValue === undefined) {
        appendBytesAscii(output, "$-1\r\n");
        return;
      }
      pushByte(output, 36u8);
      appendBytesUnsignedDecimal(output, getValue!.byteLength());
      appendBytesAscii(output, "\r\n");
      appendBytesAscii(output, getValue!.asStr());
      appendBytesAscii(output, "\r\n");
      return;
    }
    if (nameKey === 216172782118782276u64) {
      if (command.count<2usize) {
        appendBytesAscii(output, "-ERR DEL requires a key\r\n");
        return;
      }
      const deleteKey = command.hashedPart(1usize)!;
      const removed = this.state.removeHashed( & deleteKey);
      if (removed === undefined) {
        appendBytesAscii(output, ":0\r\n");
      } else {
        appendBytesAscii(output, ":1\r\n");
      }
      return;
    }
    appendBytesAscii(output, "-ERR unknown command\r\n");
  }
}
function executeLocked<lifetime a>(database: & Mutex<Database>, command: & ParsedCommand<a>, output: & mut BytesMut,): void {
  const nameKey = command.nameKey();
  if (nameKey === 288230377348024656u64) {
    appendBytesAscii(output, "+PONG\r\n");
    return;
  }
  using locked = database.lock();
  locked.getMut().executeNamed(nameKey, command, output);
}
async function serveClient(stream: TcpStream, database: Arc<Mutex<Database> >,): Promise<void, RedisError> {
  await using connection = new RespConnection(move stream);
  let output = new BytesMut({
    capacity: 8192usize
  });
  try {
    while (try await connection.readCommandAvailable()) {
      let offset: usize = 0usize;
      let batchSize: usize = 0usize;
      while (batchSize<1024usize) {
        let nextOffset = offset;
        let complete = false;
        {
          const command = try connection.readBufferedCommand(offset);
          if (command !== undefined) {
            nextOffset = command!.consumed;
            executeLocked(database.get(), & command!, & mut output);
            complete = true;
          }
        }
        if (!complete) {
          break;
        }
        offset = nextOffset;
        batchSize += 1usize;
      }
      connection.consume(offset);
      try await connection.flush( & mut output);
    }
    connection.close();
    return;
  } catch (error: RedisError) {
    connection.close();
    throw error;
  }
}
async function serveClientTask(stream: TcpStream, database: Arc<Mutex<Database> >,): Promise<void, never> {
  try {
    try await serveClient(move stream, database);
  } catch (error: RedisError) {
    return;
  }
  return;
}
export async function serve(endpoint: Endpoint, capacity: usize,): Promise<void, NetworkError> {
  await using listener = try new TcpListener(endpoint);
  using clients = new TaskGroup<RedisError>();
  const database = new Arc(new Mutex(new Database(capacity)));
  while (true) {
    const stream = try await listener.accept();
    if (!clients.spawn(serveClientTask(move stream, database.clone()))) {
      return;
    }
  }
}
export async function servePort(port: u16, capacity: usize,): Promise<void, NetworkError> {
  await using listener = try new TcpListener({
    host: "127.0.0.1", port: port,
  });
  using clients = new TaskGroup<RedisError>();
  const database = new Arc(new Mutex(new Database(capacity)));
  while (true) {
    const stream = try await listener.accept();
    if (!clients.spawn(serveClientTask(move stream, database.clone()))) {
      return;
    }
  }
}
async function runServer(endpoint: Endpoint, capacity: usize,): Promise<i32, never> {
  try {
    try await serve(endpoint, capacity);
  } catch (error: NetworkError) {
    consoleError("Redis server failed");
    return 1;
  }
  return 0;
}
export function main(): i32 {
  return run(runServer({
    host: "127.0.0.1", port: 6379u16,
  }, 4096,),);
}
