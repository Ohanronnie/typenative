import { AsciiKeyUtf8View, borrow as borrowBytes, ByteView, BytesMut, HashedUtf8View, Utf8View } from "std/bytes";
import { AsyncDisposable } from "std/core";
import { NetworkError, TcpStream } from "std/net";

@Conform(Error)
export enum RedisError {
  BindFailed, ConnectionFailed, InvalidFrame, InvalidLength, InvalidUtf8, FrameTooLarge, UnexpectedEnd,
}
struct ParsedLength {
  public readonly value: usize;
  public readonly next: usize;
}
@Copy export struct ParsedCommand<lifetime a> {
  private frame: ByteView<a>;
  private start: usize;
  private first: AsciiKeyUtf8View<a>;
  private second: HashedUtf8View<a > | undefined;
  private thirdStart: usize;
  private thirdEnd: usize;
  public readonly count: usize;
  public readonly consumed: usize;
  public part(index: usize): Utf8View<a > | undefined {
    if (index >= this.count) {
      return undefined;
    }
    if (index === 0usize) {
      return this.first.text;
    }
    if (index === 1usize) {
      if (this.second === undefined) {
        return undefined;
      }
      return this.second!.text;
    }
    if (index === 2usize) {
      const third = this.frame.view(this.thirdStart, this.thirdEnd)!;
      return third.utf8()!;
    }
    const countEnd = lineEnd( & this.frame, this.start + 1usize)!;
    let offset = countEnd + 2usize;
    let current: usize = 0usize;
    while (current <= index) {
      const lengthEnd = lineEnd( & this.frame, offset + 1usize)!;
      const lengthView = this.frame.view(offset + 1usize, lengthEnd)!;
      const length = lengthView.parseUnsigned()!;
      const payloadStart = lengthEnd + 2usize;
      const payloadEnd = payloadStart + length;
      if (current === index) {
        const payload = this.frame.view(payloadStart, payloadEnd)!;
        return payload.utf8()!;
      }
      offset = payloadEnd + 2usize;
      current += 1usize;
    }
    return undefined;
  }
  public nameKey(): u64 {
    return this.first.key();
  }
  public hashedPart(index: usize): HashedUtf8View<a > | undefined {
    if (index === 1usize) {
      return this.second;
    }
    const text = this.part(index);
    if (text === undefined) {
      return undefined;
    }
    return text!.hashed();
  }
}
function lineEnd<lifetime a>(input: & ByteView<a>, start: usize): usize | undefined {
  return input.findCrlf(start);
}
function readLength<lifetime a>(input: & ByteView<a>, start: usize, marker: u8): ParsedLength | undefined throws RedisError {
  const parsed = input.parseUnsignedLine(start, marker);
  if (parsed.isIncomplete()) {
    return undefined;
  }
  if (parsed.hasInvalidMarker()) {
    throw RedisError.InvalidFrame;
  }
  if (parsed.hasInvalidNumber()) {
    throw RedisError.InvalidLength;
  }
  return {
    value: parsed.value, next: parsed.next
  };
}
export function parseCommand(input: & BytesMut, start: usize): ParsedCommand<scope > | undefined throws RedisError {
  const frame = borrowBytes(input);
  const countLength = try readLength( & frame, start, 42u8);
  if (countLength === undefined) {
    return undefined;
  }
  const count = countLength!.value;
  if (count === 0usize || count > 1024usize) {
    throw RedisError.InvalidFrame;
  }
  let offset = countLength!.next;
  let index: usize = 0usize;
  let first: AsciiKeyUtf8View<scope > | undefined = undefined;
  let second: HashedUtf8View<scope > | undefined = undefined;
  let thirdStart: usize = 0usize;
  let thirdEnd: usize = 0usize;
  while (index<count) {
    const partLength = try readLength( & frame, offset, 36u8);
    if (partLength === undefined) {
      return undefined;
    }
    const length = partLength!.value;
    if (length > 536870912usize) {
      throw RedisError.FrameTooLarge;
    }
    const payloadStart = partLength!.next;
    if (payloadStart > frame.length() || length > frame.length() - payloadStart) {
      return undefined;
    }
    const payloadEnd = payloadStart + length;
    if (frame.length() - payloadEnd<2usize) {
      return undefined;
    }
    if (!frame.hasCrlfAt(payloadEnd)) {
      throw RedisError.InvalidFrame;
    }
    const payload = frame.view(payloadStart, payloadEnd)!;
    if (index === 0usize) {
      const text = payload.asciiKeyUtf8();
      if (text === undefined) {
        throw RedisError.InvalidUtf8;
      }
      first = text!;
    } else if (index === 1usize) {
      const text = payload.hashedUtf8();
      if (text === undefined) {
        throw RedisError.InvalidUtf8;
      }
      second = text!;
    } else if (index === 2usize) {
      const text = payload.utf8();
      if (text === undefined) {
        throw RedisError.InvalidUtf8;
      }
      thirdStart = payloadStart;
      thirdEnd = payloadEnd;
    } else if (payload.utf8() === undefined) {
      throw RedisError.InvalidUtf8;
    }
    offset = payloadEnd + 2usize;
    index += 1usize;
  }
  return {
    frame: frame, start: start, first: first!, second: second, thirdStart: thirdStart, thirdEnd: thirdEnd, count: count, consumed: offset
  };
}
function readMore(stream: & TcpStream, buffer: & mut BytesMut): usize throws NetworkError {
  return try stream.readInto(buffer);
}
function writeAll(stream: & TcpStream, buffer: & BytesMut): void throws RedisError {
  try {
    try stream.writeAll(buffer);
  } catch (error: NetworkError) {
    throw RedisError.ConnectionFailed;
  }
  return;
}
@Sealed
@Conform(AsyncDisposable)
export class RespConnection {
  private stream: TcpStream;
  private input: BytesMut;
  public constructor(stream: TcpStream) {
    this.stream = move stream;
    this.input = new BytesMut({
      capacity: 4096usize
    });
  }
  public readBufferedCommand(offset: usize): ParsedCommand<scope > | undefined throws RedisError {
    return try parseCommand( & this.input, offset);
  }
  public mut async readCommandAvailable(): Promise<bool, RedisError> {
    while (true) {
      let available = false;
      {
        const parsed = try parseCommand( & this.input, 0usize);
        available = parsed !== undefined;
      }
      if (available) {
        return true;
      }
      if (this.input.length > 536870912usize) {
        throw RedisError.FrameTooLarge;
      }
      let received: usize = 0usize;
      try {
        received = try readMore( & this.stream, & mut this.input);
      } catch (error: NetworkError) {
        throw RedisError.ConnectionFailed;
      }
      if (received === 0usize) {
        if (this.input.length === 0usize) {
          return false;
        }
        throw RedisError.UnexpectedEnd;
      }
    }
    return false;
  }
  public mut consume(count: usize): void {
    this.input.discardPrefix(count);
  }
  public mut async flush(output: & mut BytesMut): Promise<void, RedisError> {
    if (output.length === 0usize) {
      return;
    }
    try writeAll( & this.stream, output);
    output.length = 0usize;
  }
  public close(): void {
    this.stream.close();
  }
  public move async dispose(): Promise<void, never> {
    this.stream.close();
  }
}
