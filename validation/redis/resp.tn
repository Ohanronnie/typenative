import { Bytes, BytesMut } from "std/bytes";
import { AsyncDisposable, Error } from "std/core";
import { NetworkError, TcpStream } from "std/net";

export enum RedisError implements Error {
  BindFailed, ConnectionFailed, InvalidFrame, InvalidLength, InvalidUtf8, FrameTooLarge, UnexpectedEnd,
}
struct ParsedLength {
  public readonly value: usize;
  public readonly next: usize;
}
enum LineStatus {
  Complete, Incomplete, InvalidMarker, InvalidNumber,
}
struct ParsedLine {
  public readonly status: LineStatus;
  public readonly value: usize;
  public readonly next: usize;
}
export struct ParsedCommand {
  private frame: Bytes;
  private start: usize;
  public readonly count: usize;
  public readonly consumed: usize;
  private firstStart: usize;
  private firstEnd: usize;
  private secondStart: usize;
  private secondEnd: usize;
  private thirdStart: usize;
  private thirdEnd: usize;
  public part(index: usize): Bytes | undefined {
    if (index >= this.count) {
      return undefined;
    }
    if (index === 0) {
      return this.frame.trySlice(this.firstStart, this.firstEnd);
    }
    if (index === 1) {
      return this.frame.trySlice(this.secondStart, this.secondEnd);
    }
    if (index === 2) {
      return this.frame.trySlice(this.thirdStart, this.thirdEnd);
    }
    const countEnd = lineEnd( &this.frame, this.start + 1)!;
    let offset = countEnd + 2;
    let current: usize = 0;
    while (current <= index) {
      const lengthEnd = lineEnd( &this.frame, offset + 1)!;
      const lengthView = this.frame.trySlice(offset + 1, lengthEnd)!;
      const length = parseUnsigned( &lengthView)!;
      const payloadStart = lengthEnd + 2;
      const payloadEnd = payloadStart + length;
      if (current === index) {
        return this.frame.trySlice(payloadStart, payloadEnd);
      }
      offset = payloadEnd + 2;
      current += 1;
    }
    return undefined;
  }
  public name(): Bytes throws RedisError {
    const value = this.frame.trySlice(this.firstStart, this.firstEnd)!;
    if (!value.isValidUtf8()) {
      throw RedisError.InvalidUtf8;
    }
    return value;
  }
}
function lineEnd(input: &Bytes, start: usize): usize | undefined {
  const bytes = input.asSlice();
  let index = start;
  while (index + 1 < input.length) {
    if (bytes[index] === 13 && bytes[index + 1] === 10) {
      return index;
    }
    index += 1;
  }
  return undefined;
}
function lineIsIncomplete(status: LineStatus): bool {
  return switch(status) {
    case LineStatus.Incomplete: true, default: false,
  };
}
function lineHasInvalidMarker(status: LineStatus): bool {
  return switch(status) {
    case LineStatus.InvalidMarker: true, default: false,
  };
}
function lineHasInvalidNumber(status: LineStatus): bool {
  return switch(status) {
    case LineStatus.InvalidNumber: true, default: false,
  };
}
function decimalDigit(byte: u8): usize | undefined {
  if (byte === 48) {
    return 0;
  }
  if (byte === 49) {
    return 1;
  }
  if (byte === 50) {
    return 2;
  }
  if (byte === 51) {
    return 3;
  }
  if (byte === 52) {
    return 4;
  }
  if (byte === 53) {
    return 5;
  }
  if (byte === 54) {
    return 6;
  }
  if (byte === 55) {
    return 7;
  }
  if (byte === 56) {
    return 8;
  }
  if (byte === 57) {
    return 9;
  }
  return undefined;
}
function readLength(input: &Bytes, start: usize, marker: u8): ParsedLength | undefined throws RedisError {
  const parsed = parseLine(input, start, marker);
  if (lineIsIncomplete(parsed.status)) {
    return undefined;
  }
  if (lineHasInvalidMarker(parsed.status)) {
    throw RedisError.InvalidFrame;
  }
  if (lineHasInvalidNumber(parsed.status)) {
    throw RedisError.InvalidLength;
  }
  return {
    value: parsed.value, next: parsed.next,
  };
}
function parseUnsigned(input: &Bytes): usize | undefined {
  const bytes = input.asSlice();
  let value: usize = 0;
  let index: usize = 0;
  while (index<input.length) {
    const digit = decimalDigit(bytes[index]);
    if (digit === undefined) {
      return undefined;
    }
    value = value * 10 + digit!;
    index += 1;
  }
  return value;
}
function parseLine(input: &Bytes, start: usize, marker: u8): ParsedLine {
  const bytes = input.asSlice();
  if (start >= input.length) {
    return {
      status: LineStatus.Incomplete, value: 0, next: 0
    };
  }
  if (bytes[start] !== marker) {
    return {
      status: LineStatus.InvalidMarker, value: 0, next: 0
    };
  }
  let index = start + 1;
  let value: usize = 0;
  let digits = 0;
  while (index<input.length) {
    const byte = bytes[index];
    if (byte === 13) {
      if (index + 1 >= input.length) {
        return {
          status: LineStatus.Incomplete, value: 0, next: 0
        };
      }
      if (bytes[index + 1] !== 10 || digits === 0) {
        return {
          status: LineStatus.InvalidNumber, value: 0, next: 0
        };
      }
      return {
        status: LineStatus.Complete, value, next: index + 2
      };
    }
    if (byte<48 || byte > 57) {
      return {
        status: LineStatus.InvalidNumber, value: 0, next: 0
      };
    }
    const digit = decimalDigit(byte);
    if (digit === undefined) {
      return {
        status: LineStatus.InvalidNumber, value: 0, next: 0
      };
    }
    value = value * 10 + digit!;
    digits += 1;
    index += 1;
  }
  return {
    status: LineStatus.Incomplete, value: 0, next: 0
  };
}
export function parseCommand(input: &BytesMut, start: usize): ParsedCommand | undefined throws RedisError {
  const frame = input.asBytes();
  const frameBytes = frame.asSlice();
  const countLength = try readLength( &frame, start, 42);
  if (countLength === undefined) {
    return undefined;
  }
  const count = countLength!.value;
  if (count === 0 || count > 1024) {
    throw RedisError.InvalidFrame;
  }
  let offset = countLength!.next;
  let index: usize = 0;
  let firstStart: usize = 0;
  let firstEnd: usize = 0;
  let secondStart: usize = 0;
  let secondEnd: usize = 0;
  let thirdStart: usize = 0;
  let thirdEnd: usize = 0;
  while (index<count) {
    const partLength = try readLength( &frame, offset, 36);
    if (partLength === undefined) {
      return undefined;
    }
    const length = partLength!.value;
    if (length > 536870912) {
      throw RedisError.FrameTooLarge;
    }
    const payloadStart = partLength!.next;
    if (payloadStart > frame.length || length > frame.length - payloadStart) {
      return undefined;
    }
    const payloadEnd = payloadStart + length;
    if (frame.length - payloadEnd<2) {
      return undefined;
    }
    if (!(frameBytes[payloadEnd] === 13 && frameBytes[payloadEnd + 1] === 10)) {
      throw RedisError.InvalidFrame;
    }
    if (index === 0) {
      firstStart = payloadStart;
      firstEnd = payloadEnd;
    } else if (index === 1) {
      secondStart = payloadStart;
      secondEnd = payloadEnd;
    } else if (index === 2) {
      thirdStart = payloadStart;
      thirdEnd = payloadEnd;
    }
    offset = payloadEnd + 2;
    index += 1;
  }
  return {
    frame: frame, start: start, count: count, consumed: offset, firstStart: firstStart, firstEnd: firstEnd, secondStart: secondStart, secondEnd: secondEnd, thirdStart: thirdStart, thirdEnd: thirdEnd,
  };
}
export class RespConnection implements AsyncDisposable {
  private stream: TcpStream;
  private input: BytesMut;
  public constructor(stream: TcpStream) {
    this.stream = move stream;
    this.input = new BytesMut({
      capacity: 4096
    });
  }
  public readBufferedCommand(offset: usize): ParsedCommand | undefined throws RedisError {
    return try parseCommand( &this.input, offset);
  }
  public async readCommandAvailable(): Promise<bool, RedisError> {
    while (true) {
      let available = false;
      {
        const parsed = try parseCommand( &this.input, 0);
        available = parsed !== undefined;
      }
      if (available) {
        return true;
      }
      if (this.input.length > 536870912) {
        throw RedisError.FrameTooLarge;
      }
      let received: usize = 0;
      try {
        received = try await this.stream.readInto( &mut this.input);
      } catch (error: NetworkError) {
        throw RedisError.ConnectionFailed;
      }
      if (received === 0) {
        if (this.input.length === 0) {
          return false;
        }
        throw RedisError.UnexpectedEnd;
      }
    }
    return false;
  }
  public consume(count: usize): void {
    this.input.discardPrefix(count);
  }
  public async flush(output: Bytes): Promise<void, RedisError> {
    if (output.length === 0) {
      return;
    }
    try {
      try await this.stream.writeBytes(output);
    } catch (error: NetworkError) {
      throw RedisError.ConnectionFailed;
    }
  }
  public flushNow(output: Bytes): bool throws RedisError {
    try {
      return try this.stream.tryWriteBytes(output);
    } catch (error: NetworkError) {
      throw RedisError.ConnectionFailed;
    }
  }
  public close(): void {
    this.stream.close();
  }
  public async [Symbol.asyncDispose](): Promise<void, never> {
    this.stream.close();
  }
}
