import { Bytes, BytesMut } from "std/bytes";
import { Array } from "std/collections";
import { AsyncDisposable, ParseIntegerError } from "std/core";
import { NetworkError, TcpStream } from "std/net";
import { Utf8Error } from "std/string";

@Conform(Error)
export enum RedisError {
  BindFailed, ConnectionFailed, InvalidFrame, InvalidLength, InvalidUtf8, FrameTooLarge, UnexpectedEnd,
}
export struct Command {
  public readonly name: string;
  public readonly arguments: Array<string>;
}
export enum Reply {
  Simple(string), Bulk(string), Integer(number), Missing, Error(string),
}
struct ParsedCommand {
  public readonly command: Command;
  public readonly consumed: usize;
}
class Cursor {
  private input: & BytesMut;
  private offset: usize;
  public constructor(input: & BytesMut) {
    this.input = input;
    this.offset = 0;
  }
  public position(): usize {
    return this.offset;
  }
  public mut readLine(): Bytes | undefined {
    const start = this.offset;
    while (this.offset + 1 < this.input.length) {
      const current = this.input.get(this.offset)!;
      const next = this.input.get(this.offset + 1)!;
      if (current === 13 && next === 10) {
        const line = this.input.slice(start, this.offset);
        this.offset += 2;
        return line;
      }
      this.offset += 1;
    }
    this.offset = start;
    return undefined;
  }
  public mut readLength(marker: u8,): usize | undefined throws RedisError {
    const start = this.offset;
    if (this.offset >= this.input.length) {
      return undefined;
    }
    if (this.input.get(this.offset)! !== marker) {
      throw RedisError.InvalidFrame;
    }
    this.offset += 1;
    const line = this.readLine();
    if (line === undefined) {
      this.offset = start;
      return undefined;
    }
    let parsed: usize = 0;
    try {
      parsed = try usize.parseAscii(line!);
    } catch (error: ParseIntegerError) {
      throw RedisError.InvalidLength;
    }
    return parsed;
  }
  public mut readBulkBytes(): Bytes | undefined throws RedisError {
    const start = this.offset;
    const length = try this.readLength(36);
    if (length === undefined) {
      this.offset = start;
      return undefined;
    }
    if (length! > 536870912) {
      throw RedisError.FrameTooLarge;
    }
    const payloadEnd = this.offset + length!;
    if (payloadEnd + 2 > this.input.length) {
      this.offset = start;
      return undefined;
    }
    if (this.input.get(payloadEnd)! !== 13 || this.input.get(payloadEnd + 1)! !== 10) {
      throw RedisError.InvalidFrame;
    }
    const payload = this.input.slice(this.offset, payloadEnd);
    this.offset = payloadEnd + 2;
    return payload;
  }
}
function decodePayload(payload: Bytes): string throws RedisError {
  try {
    return try string.fromUtf8(payload);
  } catch (error: Utf8Error) {
    throw RedisError.InvalidUtf8;
  }
}
function parseCommand(input: & BytesMut,): ParsedCommand | undefined throws RedisError {
  let cursor = new Cursor(input);
  const count = try cursor.readLength(42);
  if (count === undefined) {
    return undefined;
  }
  if (count! === 0 || count! > 1024) {
    throw RedisError.InvalidFrame;
  }
  let parts = new Array<Bytes>({
    capacity: 16,
  });
  let index: usize = 0;
  while (index<count!) {
    const part = try cursor.readBulkBytes();
    if (part === undefined) {
      return undefined;
    }
    parts.push(part!);
    index += 1;
  }
  const nameBytes = parts.get(0);
  if (nameBytes === undefined) {
    throw RedisError.InvalidFrame;
  }
  const nameValue = try decodePayload(nameBytes!);
  let arguments = new Array<string>({
    capacity: 8,
  });
  let argumentIndex: usize = 1;
  while (argumentIndex<parts.length) {
    const argumentBytes = parts.get(argumentIndex);
    if (argumentBytes === undefined) {
      throw RedisError.InvalidFrame;
    }
    const argument = try decodePayload(argumentBytes!);
    arguments.push(argument);
    argumentIndex += 1;
  }
  const result: ParsedCommand = {
    command: {
      name: nameValue.toAsciiUppercase(), arguments: arguments,
    }, consumed: cursor.position(),
  };
  return result;
}
function appendCrLf(output: & mut BytesMut): void {
  output.push(13);
  output.push(10);
}
function appendSafeLine(output: & mut BytesMut, text: string,): void {
  output.appendSafeString(text);
}
function encodeReply(reply: Reply, output: & mut BytesMut,): void {
  switch(reply) {
    case Reply.Simple(simpleMessage): {
      output.push(43);
      appendSafeLine(output, simpleMessage);
      appendCrLf(output);
    }
    case Reply.Bulk(bulkMessage): {
      let body = new BytesMut({
        capacity: 32,
      });
      body.appendString(bulkMessage);
      output.push(36);
      output.appendUnsignedDecimal(body.length);
      appendCrLf(output);
      output.append(body.slice(0, body.length));
      appendCrLf(output);
    }
    case Reply.Integer(value): {
      output.push(58);
      output.appendDecimal(value);
      appendCrLf(output);
    }
    case Reply.Missing: {
      output.appendAscii("$-1\r\n");
    }
    case Reply.Error(errorMessage): {
      output.push(45);
      appendSafeLine(output, errorMessage);
      appendCrLf(output);
    }
  }
}
function readMore(stream: & TcpStream, buffer: & mut BytesMut,): usize throws NetworkError {
  return try stream.readInto(buffer);
}
function writeAll(stream: & TcpStream, buffer: & BytesMut,): void throws RedisError {
  try {
    try stream.writeAll(buffer);
  } catch (error: NetworkError) {
    throw RedisError.ConnectionFailed;
  }
  return;
}
@Sealed
@Conform(AsyncDisposable)
export class RespConnection {
  private stream: TcpStream;
  private input: BytesMut;
  public constructor(stream: TcpStream) {
    this.stream = move stream;
    this.input = new BytesMut({
      capacity: 4096,
    });
  }
  public mut async readCommand(): Promise<Command | undefined, RedisError> {
    while (true) {
      const parsed = try parseCommand( & this.input);
      if (parsed !== undefined) {
        const complete = parsed!;
        const consumed = complete.consumed;
        const command = move complete.command;
        this.input.discardPrefix(consumed);
        return command;
      }
      if (this.input.length > 536870912) {
        throw RedisError.FrameTooLarge;
      }
      let received: usize = 0;
      try {
        received = try readMore( & this.stream, & mut this.input,);
      } catch (error: NetworkError) {
        throw RedisError.ConnectionFailed;
      }
      if (received === 0) {
        if (this.input.length === 0) {
          return undefined;
        }
        throw RedisError.UnexpectedEnd;
      }
    }
    return undefined;
  }
  public close(): void {
    this.stream.close();
  }
  public async writeReply(reply: Reply,): Promise<void, RedisError> {
    let output = new BytesMut({
      capacity: 128,
    });
    encodeReply(reply, & mut output);
    try writeAll( & this.stream, & output);
  }
  public move async dispose(): Promise<void, never> {
    this.stream.close();
  }
}
