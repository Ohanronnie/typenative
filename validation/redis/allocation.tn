import { BytesMut } from "std/bytes";
import { Database, executeDatabase } from "./redis-server";
import { ParsedCommand, parseCommand, RedisError } from "./resp";

declare extern "C" {
  function tn_runtime_reset_allocation_count(): void;
  function tn_runtime_allocation_count_i32(): i32;
  function tn_runtime_free_count(): u64;
}
function runCommand(database: &mut Database, command: &ParsedCommand, output: &mut BytesMut): bool {
  unsafe {
    return executeDatabase(database as *mut Database, command, output as *mut BytesMut);
  }
}
function measure(): i32 throws RedisError {
  let input = new BytesMut({
    capacity: 16
  });
  input.appendAscii("*1\r\n$4\r\nPING\r\n");
  let output = new BytesMut({
    capacity: 64
  });
  let database = new Database(8);
  let setupInput = new BytesMut({
    capacity: 32
  });
  setupInput.appendAscii("*3\r\n$3\r\nSET\r\n$1\r\nk\r\n$1\r\nv\r\n");
  {
    const setupCommand = try parseCommand( &setupInput, 0)!;
    if (!runCommand( &mut database, &setupCommand, &mut output)) {
      return ~(1 << 31);
    }
  }
  output.length = 0;
  let getInput = new BytesMut({
    capacity: 24
  });
  getInput.appendAscii("*2\r\n$3\r\nGET\r\n$1\r\nk\r\n");
  unsafe {
    tn_runtime_reset_allocation_count();
  }
  let iteration: usize = 0;
  while (iteration<1000000){{const command = try parseCommand( &input, 0)!;
  if (!runCommand( &mut database, &command, &mut output)) {
    return ~(1 << 31);
  }
  if (output.length !== 7) {
    return ~(1 << 31);
    }}output.length = 0;
    iteration += 1;
  }
  unsafe {
    if (tn_runtime_allocation_count_i32() !== 0) {
      return 1;
    }
    if (tn_runtime_free_count() !== 0) {
      return 2;
    }
    tn_runtime_reset_allocation_count();
  }
  iteration = 0;
  while (iteration<100000){{const command = try parseCommand( &getInput, 0)!;
  if (!runCommand( &mut database, &command, &mut output)) {
    return ~(1 << 31);
  }
  if (output.length !== 7) {
    return ~(1 << 31);
    }}output.length = 0;
    iteration += 1;
  }
  unsafe {
    if (tn_runtime_allocation_count_i32() !== 0) {
      return 3;
    }
    if (tn_runtime_free_count() !== 0) {
      return 4;
    }
    return 0;
  }
}
function main(): i32 {
  try {
    return try measure();
  } catch (error: RedisError) {
    return ~(1 << 31);
  }
}
