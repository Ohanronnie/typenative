class User {
  public id: i32;
  public text: string;
  public constructor(id: i32, text: string) {
    this.id = id;
    this.text = move text;
  }
  public clone(): User {
    return new User(this.id, this.text.clone());
  }
}
function main(): i32 {
  const original = new User(42, String("class"));
  const copied = original.clone();
  if (copied.id !== 42 || copied.text !== "class") {
    return 1;
  }
  return 42;
}
