struct User {
  public id: u64;
  public name: string;
  public clone(): User {
    return {
      id: this.id, name: this.name.clone(),
    };
  }
}
function main(): i32 {
  const original = new User({
    id: 42, name: String("clone"),
  });
  const copied = original.clone();
  if (copied.id !== 42 || copied.name !== "clone") {
    return 1;
  }
  return 42;
}
