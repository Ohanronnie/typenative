@Intrinsic("is_null")
export function platformIsNull<T>(pointer: * const T): bool {
  return false;
}
@Intrinsic("size_of")
export function platformSizeOf<T>(): usize {
  return 0usize;
}
@Intrinsic("store_raw")
export function platformStoreRaw<T>(pointer: * mut T, value: T): bool {
  return false;
}
@Intrinsic("borrow_element")
