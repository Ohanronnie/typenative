}
function modifiedNanoseconds(value: & LinuxStatLayout): i64 {
  const seconds = value.modifySeconds;
  const nanoseconds = value.modifyNanoseconds;
  return seconds * 1000000000i64 + nanoseconds;
}
@Export("tn_file_stat")
export function fileStat(path: * const u8, size: * mut usize, modified: * mut i64, mode: * mut u32): i32 {
  unsafe {
    if (platformIsNull<u8>(path)) {
      return - 22i32;
    }
    const output = runtimeAlloc(platformSizeOf<LinuxStatLayout>());
    if (stat(path, output) !== 0i32) {
      const error = statError();
      runtimeFree(output);
      return - error;
    }
    const value = *(output as * const LinuxStatLayout);
    if (!platformIsNull<usize>(size as * const usize)) {
      platformStoreRaw<usize>(size, value.size);
    }
    if (!platformIsNull<i64>(modified as * const i64)) {
      platformStoreRaw<i64>(modified, modifiedNanoseconds( & value));
    }
    if (!platformIsNull<u32>(mode as * const u32)) {
      platformStoreRaw<u32>(mode, value.mode);
