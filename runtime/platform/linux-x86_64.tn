@Export("tn_dir_open")
export function directoryOpen(path: * const u8): * mut u8 {
  unsafe {
    return opendir(path);
  }
}
@Export("tn_dir_next")
export function directoryNext(handle: * mut u8, name: * mut u8, capacity: usize, kind: * mut u32): i32 {
  unsafe {
    if (platformIsNull<u8>(handle as * const u8) || platformIsNull<u8>(name as * const u8) || capacity === 0usize) {
      return - 22i32;
    }
    const entry = readdir(handle);
    if (platformIsNull<u8>(entry as * const u8)) {
      return 0i32;
    }
    const recordLength = direntU16(entry as * const u8, 16usize);
    const namePointer = direntAddress(entry as * const u8, 19usize)as * const u8;
    let length: usize = 0usize;
