interface Display {
  display(): void;
}

struct Point<T> implements Display {
  public value: T;
  public position: (i32, i32);
  display(): void {}
}

enum Choice<T> {
  Empty,
  Value(T),
  Record { value: T; code: i32; },
}

class Base {}

class Derived extends Base implements Display {
  public display(): void {}
}

function primitiveTypes(
  boolean: bool,
  signed8: i8,
  signed16: i16,
  signed32: i32,
  signed64: i64,
  signed128: i128,
  signedSize: isize,
  nativeNumber: number,
  unsigned8: u8,
  unsigned16: u16,
  unsigned32: u32,
  unsigned64: u64,
  unsigned128: u128,
  unsignedSize: usize,
  float32: f32,
  float64: f64,
  character: char,
  ownedText: string,
  text: &str,
): void {}

function compoundTypes(
  point: Point<i32>,
  choice: Choice<i32>,
  base: Base,
  dynamic: unknown,
  optional: i32 | undefined,
  array: [i32; 4],
  slice: &[i32],
  tuple: (i32, bool),
  shared: &i32,
  mutable: &mut i32,
  pointer: *const i32,
  mutablePointer: *mut i32,
  callback: (i32) => bool,
  pending: Promise<i32, never>,
  impossible: never,
): void {}

function inferred(): i32 {
  const value: i32 = 42;
  const formatted = `value=${value}`;
  formatted;
  return value;
}
