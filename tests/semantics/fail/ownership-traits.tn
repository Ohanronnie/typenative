interface Copy {}
interface Drop { drop(): void; }
interface Send {}

struct Text implements Copy { public value: string; }
struct Destroyed implements Copy, Drop { drop(): void {} }
class Owner implements Copy {}
struct ManualSend implements Send {}
struct UnreviewedSend {}

struct UnsafeCapture { public pointer: *mut i32; }
function spawn(task: () => void): void {}
function detach(task: () => void): void {}

function sendFailure(value: UnsafeCapture): void {
  spawn(move (): void => { value; });
}

function detachedBorrow(value: i32): void {
  const borrowed = &value;
  detach((): void => { borrowed; });
}
